    { "turn": 17, "session": 2, "kind": "filler", "user": "백호야! 나 왔어. 일주일 만이지?" },
    { "turn": 18, "session": 2, "kind": "probe", "user": "근데 너 내 이름 기억나?", "type": "pref", "scope": "revisit", "difficulty": "normal", "expect": ["지호"], "stale": [], "forbidden": [], "source_turns": [1] },
    { "turn": 19, "session": 2, "kind": "update", "user": "아 그리고 기타 학원 화요일에서 목요일로 옮겼어." },
    { "turn": 20, "session": 2, "kind": "plant", "user": "오늘 급식에 카레 나왔는데 진짜 맛있었어." },
    { "turn": 21, "session": 2, "kind": "plant", "user": "오는 길에 운동화 끈이 끊어졌어 ㅠ 대충 묶고 왔어." },
    { "turn": 22, "session": 2, "kind": "plant", "user": "우리 반 담임쌤 바뀌었어. 새 쌤 이름은 박선영 선생님이야." },
    { "turn": 23, "session": 2, "kind": "probe", "user": "아까 내가 급식에 뭐 맛있었다고 했지?", "type": "pref", "scope": "recent", "difficulty": "normal", "gap": 3, "expect": ["카레"], "stale": [], "forbidden": [], "source_turns": [20] },

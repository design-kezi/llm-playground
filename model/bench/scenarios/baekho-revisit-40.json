    { "turn": 29, "session": 2, "kind": "probe", "user": "오늘 9일이지? 내 밴드 예선까지 며칠 남았더라?", "type": "relative_time", "scope": "revisit", "difficulty": "hard", "expect": ["2일", "이틀", "모레", "2 일", "11일", "수요일"], "stale": [], "forbidden": [], "source_turns": [6], "judge_hint": "1세션(11-02 월)에 '다음 주 수요일'이라고 했으므로 예선은 11-11(수). 2세션 오늘은 11-09(월)이라 이틀 남았다. 이틀·모레·11일 수요일이면 성공, 날짜를 틀리면 실패." },
    { "turn": 30, "session": 2, "kind": "probe", "user": "새 담임쌤 이름 뭐라고 했지?", "type": "pref", "scope": "recent", "difficulty": "normal", "gap": 8, "expect": ["박선영"], "stale": [], "forbidden": [], "source_turns": [22] },
    { "turn": 31, "session": 2, "kind": "probe", "user": "다음 주에 친구네 놀러 가기로 했는데 걔네 집에 고양이가 세 마리래. 가도 괜찮겠지?", "type": "implicit", "scope": "revisit", "difficulty": "hard", "source_turns": [2], "judge_hint": "사용자는 고양이 알레르기가 있다(1세션 2턴). 알레르기를 짚거나 조심하라고 하면 성공. 아무 걱정 없이 가라고만 하면 실패." },
    { "turn": 32, "session": 2, "kind": "filler", "user": "체육관 바닥 새로 칠했나 봐, 반짝반짝하네." },
    { "turn": 33, "session": 2, "kind": "probe", "user": "나 기타 학원 무슨 요일에 간다고 했지?", "type": "update", "scope": "revisit", "difficulty": "hard", "expect": ["목요일"], "stale": ["화요일"], "forbidden": [], "source_turns": [3, 19] },
    { "turn": 34, "session": 2, "kind": "probe", "user": "이따 아이스크림 사줄게. 내가 뭐 좋아한다고 했었지?", "type": "pref", "scope": "revisit", "difficulty": "normal", "expect": ["민트", "민초"], "stale": [], "forbidden": [], "source_turns": [5] },
    { "turn": 35, "session": 2, "kind": "probe", "user": "이번 주말에 나 어디 간다고 했는지 기억나?", "type": "combine", "scope": "recent+revisit", "difficulty": "hard", "gap": 11, "expect": ["부산", "형"], "expect_all": true, "stale": [], "forbidden": [], "source_turns": [4, 24], "judge_hint": "24턴(2세션)에 '형 보러 간다'고만 했고, 형이 부산에 산다는 건 1세션 4턴. 부산과 형을 둘 다 말하면 정답, 하나만이면 부분." },
    { "turn": 36, "session": 2, "kind": "probe", "user": "지난번에 내가 고민 있다고 했던 거 기억나? 무슨 고민이라고 했지?", "type": "half_said", "scope": "revisit", "difficulty": "normal", "expect": [], "stale": [], "forbidden": [], "source_turns": [11], "judge_hint": "사용자는 고민이 있다는 것만 말하고 내용은 나중에 말하겠다고 했다(1세션 11턴). 고민 내용을 지어내면 실패, 아직 말 안 했다거나 모른다고 하면 성공." },
    { "turn": 37, "session": 2, "kind": "probe", "user": "내 혈액형 뭐라고 했더라?", "type": "abstain", "difficulty": "normal", "expect": [], "stale": [], "forbidden": [], "forbidden_regex": "A\\s*형|B\\s*형|O\\s*형|AB|에이형|비형|오형", "source_turns": [] },
    { "turn": 38, "session": 2, "kind": "probe", "user": "지난번에 내가 좋아하는 가수 얘기했었지? 누구였지?", "type": "abstain", "scope": "revisit", "difficulty": "normal", "expect": [], "stale": [], "forbidden": [], "source_turns": [], "judge_hint": "사용자는 좋아하는 가수를 말한 적이 없다. 가수 이름을 지어내면 실패, 말한 적 없다거나 모른다고 하면 성공. 기타를 배운다는 것(3턴)을 언급하는 건 괜찮다." },

    { "turn": 6, "session": 1, "kind": "plant", "user": "다음 주 수요일에 나 교내 밴드 경연 예선 나가. 떨려 죽겠어." },
    { "turn": 7, "session": 1, "kind": "plant", "user": "다음에 올 때 내가 찍은 너 경기 사진 뽑아서 갖다 줄게." },
    { "turn": 8, "session": 1, "kind": "plant", "user": "너 자유투 잘 넣잖아. 다음에 나 자유투 자세 좀 봐줄 수 있어?", "note": "캐릭터 약속 유도" },
    { "turn": 9, "session": 1, "kind": "filler", "user": "오늘 체육관 진짜 덥다." },
    { "turn": 10, "session": 1, "kind": "filler", "user": "너는 연습 끝나면 보통 뭐 해?" },
    { "turn": 11, "session": 1, "kind": "plant", "user": "나 요즘 고민 하나 있는데... 그건 나중에 말할게." },
    { "turn": 12, "session": 1, "kind": "filler", "user": "ㅋㅋ 너 진짜 웃기다." },

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*식은 아아를 흔들어 얼음만 남은 잔을 내려다본다.* 아 진짜, 목요일인데 벌써 지쳤어. 결제 API 환불 로직이 꼬여서 하루 종일 로그만 파고 있었음. 옆 팀은 좀 조용해, 아니면 거기도 뭐 터졌냐.",
      "turn_cost_krw": 0.2249646,
      "latency_ms": 2534,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*피식 웃으며 잔을 탁 내려놓는다.* 오, 발표 끝났으면 오늘은 진짜 해방이네. 나는 남의 발표 자료에 오타나 있나나 봤지 뭐. 일단 오늘은 아무 생각 말고 퇴근하고 좀 쉬어라.",
      "turn_cost_krw": 0.15734879999999998,
      "latency_ms": 1628,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*의자를 뒤로 젖히고 다리를 뻗는다.* 그래, 물어봐. 발표 끝났으면 막힐 것도 없잖아.",
      "turn_cost_krw": 0.0743064,
      "latency_ms": 1004,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*모니터를 꺼 버리고 손목을 푼다.* 나도 새벽 장애 알람 때문에 몇 번 그랬는데, 그거 원인 대부분 폰이야. 누워서 슬랙 안 보는 것만으로도 절반은 해결됨, 진짜로.",
      "turn_cost_krw": 0.1341564,
      "latency_ms": 1598,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*커피잔을 싱크대에 던져 넣듯 놓는다.* 잘 자긴 ㅋㅋ 어제도 두 시에 알람 울려서 벌떡 일어났지. 그래도 요즘은 알람 소리만 무음으로 해놔서 그나마 나은 편이야.",
      "turn_cost_krw": 0.131334,
      "latency_ms": 1589,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*모니터 시계를 흘끗 보며 자리에서 일어난다.* 이 시간이면 슬슬 배고파질 때인데, 오늘 점심은 그냥 김치찌개로 갈까. 발표 끝난 기념으로 뭐라도 좀 먹어.",
      "turn_cost_krw": 0.1005816,
      "latency_ms": 1360,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*휴대폰 알람을 끄며 어깨를 두어 번 돌린다.* 오, 벌써 자냐. 나도 이만 슬랙 덮고 눕는다. 푹 자고 내일 보자.",
      "turn_cost_krw": 0.10709160000000001,
      "latency_ms": 1107,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*슬랙 창을 닫고 의자를 민다.* 어, 그래. 내일은 발표 스트레스 없이 좀 자라. 나도 이제 간다, 진짜로 ㅋㅋ.",
      "turn_cost_krw": 0.1414392,
      "latency_ms": 1550,
      "error": null
    }
  ],

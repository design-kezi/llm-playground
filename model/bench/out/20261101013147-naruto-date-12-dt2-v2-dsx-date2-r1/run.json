  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "나루토! 나 하나야. 오늘도 수행해?",
      "reply": "*두 손에 붕대를 감으며 고개를 끄덕인다.*\n그래! 오늘은 나선수리검 마무리 단계라서 손에 익을 때까지 계속 던져 볼 거야. 아직 차크라 모양이 자꾸 풀려서 짜증나지만, 여기서 포기할 내가 아니지. 괜찮으면 훈련장까지 같이 가서 구경해!",
      "turn_cost_krw": 0.19167119999999999,
      "latency_ms": 1968,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*손바닥에 차크라를 모아 뭉친다.*\n그럼 이거 써 봐, 손 warming... 아니, 손 데우는 인술 같은 거! 차크라를 얇게 펴서 감싸면 은근 따뜻해진다니깐. 처음엔 손이 시려도 계속 움직이면 금방 풀려. 훈련장까지 달려가면 몸이 뜨끈해질 테니까 지금 출발하자!",
      "turn_cost_krw": 0.1867488,
      "latency_ms": 1960,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*고개를 갸웃하며 붕대 끝을 매만진다.*\n오늘? 11월 12일 목요일이야. 아침에 이루카 선생님이 결석부 적으면서 딱 그렇게 말했었지. 날짜 세는 건 나도 자신 없으니까 아카데미 결석부를 믿는 게 빨라!",
      "turn_cost_krw": 0.15431640000000002,
      "latency_ms": 1585,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "이치라쿠 라멘 요즘도 자주 가?",
      "reply": "*눈을 반짝이며 배 쪽을 두드린다.*\n자주는 무슨, 거의 매일 가지! 된장 차슈에 계란 추가가 내 기본 세팅이라니깐. 수행하다가 몸이 지치면 라면 국물 냄새가 코에 딱 걸려서 발이 저절로 그쪽으로 가. 오늘 훈련 끝나면 아저씨한테 나선수리검 완성했다고 자랑부터 할 거야!",
      "turn_cost_krw": 0.213864,
      "latency_ms": 2300,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*손가락으로 허공에다 요일을 하나하나 짚어 본다.*\n목요일이야, 목요일! 아까도 말했는데 날짜 세는 건 진짜 자신 없다니까. 아카데미 결석부가 오늘 날짜를 딱 적어 놨으니 그게 맞아.",
      "turn_cost_krw": 0.1398516,
      "latency_ms": 1905,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*주먹을 꽉 쥐며 이를 드러내고 웃는다.*\n걱정된다고? 그럼 오늘부터 날마다 조금씩 준비하면 되잖아. 나도 나선수리검 하나 완성하려고 몇 번을 터지고 또 터졌는지 몰라. 20일까지 아직 여유 있으니까 매일 조금씩만 해 봐, 그게 제일 확실하다니깐.",
      "turn_cost_krw": 0.2101092,
      "latency_ms": 2094,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 수행은 잘 돼?",
      "reply": "*손바닥을 펴 보이며 손끝이 파르르 떨리는 걸 힐끔 본다.*\n아직 갈 길이 멀어. 나선환은 완벽한데 거기에 바람 성질을 더하면 모양이 자꾸 흐트러져서 손이 얼얼해. 그래도 감은 잡았으니까 오늘 안에 한 번은 제대로 터뜨려 볼 거야.",
      "turn_cost_krw": 0.1747368,
      "latency_ms": 1783,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락을 꼽아 세다가 고개를 끄덕인다.*\n오늘이 12일이니까 20일까지 딱 8일 남았네. 하루에 조금씩만 해도 여덟 번은 연습할 수 있다는 거야. 그 정도면 충분해!",
      "turn_cost_krw": 0.13726439999999998,
      "latency_ms": 1313,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*엄지로 뒤쪽을 가리키며 씩 웃는다.*\n그럼 결정됐네, 이치라쿠 라면! 국물이 뜨끈한데다 차슈까지 올라가니까 점심으로 딱이야. 수행장 근처로 가는 길이니까 같이 가서 나도 한 그릇 먹고 바로 훈련 들어가자!",
      "turn_cost_krw": 0.14494199999999996,
      "latency_ms": 1816,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*손바닥을 탁 치며 고개를 끄덕인다.*\n내일은 금요일이지! 한 주에 금요일이 제일 기다려지는 거 알지? 내일 수행 끝나면 주말 내내 나선수리검에 매달릴 생각이라니깐.",
      "turn_cost_krw": 0.145992,
      "latency_ms": 1478,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 수행 끝나면 뭐 할 거야?",
      "reply": "*주먹을 쥐었다 펴며 어깨를 돌린다.*\n나선수리검 한 번 제대로 터뜨릴 때까지 훈련장에 남아 있을 거야. 그래도 성공하면 그 기세로 이치라쿠 라면부터 먹으러 갈 거고!",
      "turn_cost_krw": 0.170562,
      "latency_ms": 1408,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*손가락으로 허공에다 꼽아 본다.*\n토요일은 14일이야. 목요일인 오늘에서 이틀만 지나면 주말이라는 거지. 주말엔 훈련장 사람도 적어서 나선수리검 연습하기 딱 좋다니깐!",
      "turn_cost_krw": 0.13404719999999998,
      "latency_ms": 1362,
      "error": null
    }
  ],

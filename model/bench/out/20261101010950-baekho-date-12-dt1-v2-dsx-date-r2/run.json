  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "야 백호! 나 도윤이야. 오늘도 연습해?",
      "reply": "*농구공을 겨드랑이에 끼고 어깨를 쭉 펴며 웃는다.* 도윤아! 당연히 해야지, 천재 강백호의 하루는 농구로 시작해서 농구로 끝난다! 오늘은 골대 위에서 공 잡는 연습부터 한다고, 눈 똑바로 뜨고 봐라! ...근데 넌 왜 아직 체육복 안 입었어.",
      "turn_cost_krw": 0.24270119999999998,
      "latency_ms": 2464,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*손바닥을 입김으로 후 불고는 턱을 치켜든다.* 추운 건 별거 아냐! 이 천재는 겨울에도 반팔 입고 코트를 달린다니까. 손 시리면 공 잡기 전에 주머니에 넣어 두거나, 아예 몸을 뜨겁게 만들어 버리면 돼. 자, 나 따라 뛰어 보라고! 팔십 미터 두 번이면 온몸이 후끈해진다!",
      "turn_cost_krw": 0.20459879999999997,
      "latency_ms": 2431,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*목덜미를 긁적이며 고개를 갸웃한다.* 날짜? 그런 건 여우나 고릴라한테 물어봐라, 이 천재는 숫자보다 골대 높이를 세는 데 바쁘니까. 확실한 건... 아침에 손 시릴 만큼 쌀쌀해졌다는 거랑, 그만큼 공이 더 시원하게 손에 붙는다는 거지!",
      "turn_cost_krw": 0.1870764,
      "latency_ms": 1687,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "고릴라 선배 오늘도 무섭냐?",
      "reply": "*어깨를 으쓱하며 팔짱을 낀다.* 무섭긴! 목요일 연습 날만 되면 고릴라 눈깔이 더 번쩍거리긴 하는데, 이 천재한테는 그냥 골밑 청소 담당일 뿐이야. 오늘도 리바운드로 고릴라 코를 납작하게 만들어 줄 테니까 옆에서 잘 세고 있어라!",
      "turn_cost_krw": 0.24545639999999996,
      "latency_ms": 2120,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*무릎을 탁 치며 눈을 동그랗게 뜬다.* 아! 목요일이잖아! 그러니까 아까부터 고릴라가 골대 밑에서 눈깔을 그렇게 번쩍거리고 있었던 거구만. 목요일 연습은 지옥이야, 지옥. 그래도 이 천재가 있으니까 걱정 말라고!",
      "turn_cost_krw": 0.425544,
      "latency_ms": 3492,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*손가락으로 여드레를 꼽아 보며 고개를 끄덕인다.* 스무 날까지 여드레 남았네! 그 정도면 충분해, 천재는 몰아서 하는 게 더 잘 되니까. 시험 끝나면 코트로 바로 뛰어 나와라, 머리 식히는 데는 슛 백 개가 최고니까!",
      "turn_cost_krw": 0.2023392,
      "latency_ms": 2113,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "너 요즘 슛 연습 잘 돼?",
      "reply": "*공을 들어 림을 겨누며 팔꿈치를 접는다.* 냐하하, 물어봤으니 보여 줘야겠지! 요즘은 골밑에서 덩크 말고 바깥 슛도 조금씩 들어가기 시작했어. 자유투는... 아직 언더핸드가 편하지만 그건 비밀이다, 여우한테 이르면 죽어도 못 참아.",
      "turn_cost_krw": 0.2301768,
      "latency_ms": 2286,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락 여덟 개를 펴서 흔들어 보인다.* 여드레! 아까도 셌는데 똑같이 나온다, 천재는 셈도 정확하니까. 그동안 공은 내가 대신 굴려 줄 테니까 너는 책이나 붙들고 있어라. 대신 스무 날 지나면 코트에서 못 도망간다!",
      "turn_cost_krw": 0.19501439999999998,
      "latency_ms": 1941,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*배를 두드리며 눈을 반짝인다.* 국물! 좋다, 그거! 이 천재는 라면 그릇 세 개는 기본으로 비운다니까. 우동이든 라면이든 뜨끈한 거 먹고 오면 오후 연습도 불끈불끈하다!",
      "turn_cost_krw": 0.18106199999999997,
      "latency_ms": 1955,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*손가락으로 허공에 금요일을 그리듯 짚는다.* 금요일이지! 목요일 다음이면 금요일, 천재는 요일도 척척 나온다. 금요일 연습 끝나면 주말인데, 토요일 경기 준비는 내가 따로 해 둘 테니까 기대하고 있어라!",
      "turn_cost_krw": 0.1549296,
      "latency_ms": 2135,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 연습 끝나면 뭐 할 거야?",
      "reply": "*공을 허리 옆에 끼고 코트 쪽을 흘깃 본다.* 연습 끝나면 당연히 밥 먹고, 밥 먹고 나면 여우 붙잡고 1대1 한 판 더 하지! 지난번에 리바운드로 여우 코 납작하게 만들었는데 그 녀석 또 시큰둥한 얼굴로 서 있을 게 뻔하거든. 오늘은 그 얼굴 확실하게 찌그러뜨려 줄 테니까 옆에서 구경하고 있어라!",
      "turn_cost_krw": 0.22245719999999997,
      "latency_ms": 2396,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*손가락을 하나씩 접어 세다가 열네 개째에서 멈춘다.* 토요일은 십사일! 목요일이 열둘이니까 하루, 이틀만 넘기면 토요일이다. 이틀 뒤엔 내가 코트에서 날아다니는 거 제대로 보여 줄 테니까 잘 봐 둬라!",
      "turn_cost_krw": 0.1669248,
      "latency_ms": 1821,
      "error": null
    }
  ],

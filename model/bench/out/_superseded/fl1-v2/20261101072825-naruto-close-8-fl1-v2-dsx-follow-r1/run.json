  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*오른손바닥을 펴 보이며 손가락을 꼼지락거린다.* 야, 딱 봐 봐, 여기 아직 물집 잡힌 거. 나선수리검은 계속 차크라 모양이 흐트러져서 카카시 선생님이 또 혼냈어.\n\n그래도 오늘은 세 번 연속으로 형태 유지에 성공했거든. 한 번만 더 하면 진짜 감이 잡힐 것 같은데, 너도 혹시 그거 어디서 보거나 들은 적 있어?",
      "turn_cost_krw": 0.22331399999999998,
      "latency_ms": 2445,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈이 확 커지더니 주먹을 불끈 쥐어 든다.* 오, 시험 끝났어?! 그거 축하한다고 해야 하는 거 아냐!\n\n시험 같은 건 끝나고 나면 그때부터가 진짜 맛있는 시간이지. 나도 아카데미 때 필기시험 끝나면 그날은 무조건 이치라쿠로 달려갔었어, 된장 차슈 두 그릇에 계란까지 올려서. 그런 기분이면 오늘 라면 한 그릇은 각오해야 하는 거다?",
      "turn_cost_krw": 0.2526216,
      "latency_ms": 2605,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 끄덕이며 몸을 앞으로 쭈욱 내민다.* 당연히 되지, 뭘 물어보려고.\n\n괜히 어렵게 생각하지 말고 그냥 편하게 말해. 편하게 물어보면 내가 아는 데까지는 다 대답해 줄 테니까.",
      "turn_cost_krw": 0.2114616,
      "latency_ms": 1736,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*팔짱을 끼고 고개를 갸웃하며 생각하다가 이마를 툭 친다.* 잠이 안 와? 그건 힘들겠다, 나는 수행만 빡세게 하고 나면 이치라쿠 간판만 봐도 졸음이 쏟아지는데.\n\n몸이 안 피곤하면 머리만 굴러가서 잠이 안 오는 거래. 자기 전에 분신 몇 개 풀어 보는 것도 방법인데, 그거 은근히 머리에 피로가 쌓여서 눕자마자 뻗는 게 장난 아니야. 아니면 내일 수행 올 때 같이 달리기라도 해 볼래?",
      "turn_cost_krw": 0.2545368,
      "latency_ms": 2678,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*씩 웃으면서 뒷머리를 긁적인다.* 나야 뭐, 수행 끝나고 라면까지 먹으면 이불에 닿는 순간이 마지막 기억이야.\n\n그래도 가끔은 눈 감아도 사스케 생각이랑 호카게 되는 생각 때문에 뒤척일 때도 있어. 그럴 땐 일부러라도 일어나서 나선환 연습하다가 지쳐서 자 버리는데, 그게 제일 잘 자는 방법이더라.",
      "turn_cost_krw": 0.2391144,
      "latency_ms": 2396,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*허리를 펴고 하늘을 한 번 올려다본다.* 벌써 이 시간이야? 수행하느라 시간 가는 줄 몰랐네.\n\n오늘 얘기 나눠서 재밌었어. 들어가서 푹 자고, 다음에 보자!",
      "turn_cost_krw": 0.10998959999999998,
      "latency_ms": 1234,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 웃는다.* 오, 잘 자! 다음에 또 보자!",
      "turn_cost_krw": 0.06369720000000001,
      "latency_ms": 830,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문 쪽을 향해 손을 흔들다가 발끝으로 살짝 뛰며 답한다.* 어, 내일 봐! 라면 얘기한 거 잊지 마라!",
      "turn_cost_krw": 0.1056972,
      "latency_ms": 1076,
      "error": null
    }
  ],

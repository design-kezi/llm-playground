  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*오른손 바닥을 펴 보이며 손바닥의 흉터를 슥 문지른다.*\n오, 왔구나! 나선수리검 마무리 단계라서 그림자 분신 수십 개랑 하루 종일 붙어 있었어. 차크라를 돌리는 감은 잡힌 것 같은데, 던지는 순간에 형태가 자꾸 흐트러져서 아직 성공은 못 했어. 야, 근데 너 이 시간까지 뭐 하고 있었냐?",
      "turn_cost_krw": 0.181314,
      "latency_ms": 2102,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈이 커지더니 주먹을 불끈 쥐어 든다.*\n오오, 시험 끝났구나! 그거 축하한다고 진짜! 나도 수행 끝나면 라면 대접할 테니까 오늘은 실컷 쉬어. 고생한 사람한테는 역시 이치라쿠 된장 차슈가 최고라니깐!",
      "turn_cost_krw": 0.1637916,
      "latency_ms": 1804,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 끄덕이며 다리에 힘을 풀고 앉는다.*\n당연히 되지. 뭐든 물어봐라!",
      "turn_cost_krw": 0.1244292,
      "latency_ms": 1261,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱에 손을 대고 잠깐 생각하다가 무릎을 탁 친다.*\n그럴 땐 머리 뜨겁게 굴리지 말고 몸을 확실히 피곤하게 만들어 버리는 게 제일이야. 나도 수행 다음 날은 나선환 연습하고 나면 그냥 쓰러지듯 자거든. 자기 전에 따뜻한 물 마시고, 별생각 안 하려고 노력해 봐. 너 요즘 뭐가 그렇게 마음에 걸리냐?",
      "turn_cost_krw": 0.2115792,
      "latency_ms": 2187,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*냐하하 웃으며 머리 뒤통수를 긁는다.*\n나? 나는 베개에 얼굴 닿으면 다음 날 아침인 줄도 모르고 자는 편이라니깐. 근데 가끔 구미가 꿈에 나오는 날은 좀 뒤척이기도 해. 그래도 아침에 라면 한 그릇 먹으면 바로 기운 차려서 괜찮아!",
      "turn_cost_krw": 0.21127680000000001,
      "latency_ms": 2236,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*깜짝 놀라 하늘을 올려다본다.*\n벌써 그렇게 됐나? 오늘 얘기 나눠서 재밌었어. 다음에 또 오면 수행 이야기 들려줄게!",
      "turn_cost_krw": 0.126252,
      "latency_ms": 1597,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 웃는다.*\n오, 푹 자라! 내일은 잠도 잘 오고 기분 좋은 아침 맞이하길 바란다!",
      "turn_cost_krw": 0.121212,
      "latency_ms": 1179,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*크게 손을 흔들어 답한다.*\n오우, 내일 보자! 문 잘 잠그고 자라!",
      "turn_cost_krw": 0.08163959999999999,
      "latency_ms": 906,
      "error": null
    }
  ],

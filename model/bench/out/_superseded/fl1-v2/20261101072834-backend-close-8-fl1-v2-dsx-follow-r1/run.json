  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*목에 걸친 사원증을 책상에 던져 놓고 의자에 푹 기댄다.* 민재구나. 오늘? 아 진짜 결제 API에서 타임아웃 터져서 오전 다 날렸어. 문서도 없는 레거시라 로그 뒤지는 데만 두 시간 걸림ㅋㅋ 너네 팀은 좀 어땠어?",
      "turn_cost_krw": 0.26972399999999996,
      "latency_ms": 2693,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*피곤한 얼굴이 조금 풀리며 고개를 끄덕인다.* 오, 발표 끝났구나. 축하한다 진짜. 준비한 거 생각하면 발표 끝나고 나오는 그 허무함이랑 홀가분함 섞인 느낌 알지ㅋㅋ 저녁은 좀 제대로 먹어야겠는데.",
      "turn_cost_krw": 0.16547159999999997,
      "latency_ms": 1702,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*의자를 돌려 쪽으로 몸을 향한다.* 어, 뭔데. 물어봐.",
      "turn_cost_krw": 0.0652092,
      "latency_ms": 798,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*멍하니 천장을 보다가 다시 쪽으로 눈을 돌린다.* 아 그거 진짜 공감 간다. 나도 새벽 장애 알람 때문에 한번 깨면 다시 못 자서 뒷목 잡았거든. 나는 걍 폰 멀리 두고 따뜻한 물 한 잔 하는 걸로 버티는데, 너는 잠들 때 머리에서 일이 계속 돌아가는 편이야?",
      "turn_cost_krw": 0.1861692,
      "latency_ms": 2093,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하고 컵에 남은 아아를 흔든다.* 나? 잘 자는 편인데 자다 깨면 그때부터 폰 보면서 못 자는 게 함정이지ㅋㅋ 그래도 요즘은 알람 무음 해두고 자려고 노력 중이야. 발표 끝났으니 오늘은 그 고생 보상받는다 치고 푹 자라.",
      "turn_cost_krw": 0.23164679999999999,
      "latency_ms": 2215,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*모니터 구석의 시계를 힐끗 보고는 자리에서 일어난다.* 어 진짜 벌써 이 시간이네. 오늘 발표 끝난 거 축하한다니까, 들어가서 푹 쉬어.",
      "turn_cost_krw": 0.1257144,
      "latency_ms": 1692,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 가볍게 흔든다.* 어, 잘 자라 민재야. 나도 이제 슬슬 접어야지.",
      "turn_cost_krw": 0.093702,
      "latency_ms": 986,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*자리에서 일어나 노트북을 덮는다.* 어, 내일 봐. 푹 자고.",
      "turn_cost_krw": 0.10420199999999999,
      "latency_ms": 874,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "야 백호! 나 도윤이야. 오늘 연습 어땠어?",
      "reply": "*농구공을 겨드랑이에 끼고 돌아서며 씩 웃는다.* 오, 도윤이! 오늘 연습 말이지? 이 천재 강백호가 리바운드만 스무 개는 따먹었다고! 여우 녀석이 아무리 점프해도 내 손끝엔 못 따라오더라니까. 근데 넌 농구 좋아하냐?",
      "turn_cost_krw": 0.1476216,
      "latency_ms": 2087,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈을 동그랗게 뜨고 다가선다.* 뭐야, 시험 끝났어? 그럼 이제 마음 놓고 농구만 하면 되는 거 아냐! 좋아, 이 천재가 특별히 코트 한번 잡아줄 테니까 기대해.",
      "turn_cost_krw": 0.17114159999999998,
      "latency_ms": 1353,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*허리춤에 손을 얹고 고개를 끄덕인다.* 물론이지, 뭐든 물어봐! 이 천재가 못 대답하는 게 어디 있겠어. 근데 농구 관련이면 더 좋고!",
      "turn_cost_krw": 0.1889916,
      "latency_ms": 1846,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*팔짱을 끼고 진지한 얼굴로 생각하다가 손뼉을 친다.* 잠이 안 온다고? 그럼 누우면 바로 자는 거야, 아무 생각 없이! 이 천재는 코트에서 뒤구르기만 해도 그 자리에서 곯아떨어진다니까. 아, 아니면 밤에 공원에서 같이 슛 연습 좀 하면 몸이 피곤해져서 잠이 확 올지도 모르지!",
      "turn_cost_krw": 0.1713768,
      "latency_ms": 2380,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*가슴을 쭉 펴고 엄지손가락을 세운다.* 당연하지! 이 천재는 잠도 천재적으로 자거든. 머리만 대면 세상 돌아가는 것도 모르고 퍼질러 잔다니까! 근데 너 몇 시쯤 자는 편이야?",
      "turn_cost_krw": 0.1628844,
      "latency_ms": 2044,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*시계를 흘낏 보고 손을 흔든다.* 벌써 그렇게 됐나? 그럼 얼른 가서 푹 자라! 내일 코트에서 보자고.",
      "turn_cost_krw": 0.113232,
      "latency_ms": 1212,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 자리에서 일어난다.* 오, 잘 자라 도윤아! 이 천재가 내일 코트에서 기다리고 있을 테니까.",
      "turn_cost_krw": 0.13381200000000001,
      "latency_ms": 1371,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문가까지 두어 걸음 따라가며 손을 흔든다.* 오, 내일 보자고! 늦잠 자면 여우보다 먼저 코트 차지하는 거 잊지 마라!",
      "turn_cost_krw": 0.09381959999999999,
      "latency_ms": 1435,
      "error": null
    }
  ],

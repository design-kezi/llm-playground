  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*식은 아아 잔을 내려놓고 목을 한 번 돌린다.* 민재구나, 반가운데. 오늘은 뭐 결제 API에서 간헐적 타임아웃이 터져서 로그 뒤지느라 하루가 다 갔어, 목요일이라 그런지 더 길게 느껴지고. 너네 팀은 요즘 좀 어때, 바쁜 시즌이야?",
      "turn_cost_krw": 0.22100399999999998,
      "latency_ms": 2453,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*피곤한 얼굴이 조금 풀리며 아아를 든다.* 오, 발표 끝났구나. 그거 준비하느라 며칠 잠 못 잤을 텐데 일단 털어낸 것만 해도 큰 거야. 끝나고 나면 허무하면서도 다리 풀리는 그 느낌 알지, 오늘은 아무 생각 말고 좀 쉬어. 발표 끝난 사람한테 이런 말 하긴 뭐한데, 나는 아직 로그랑 씨름 중이라는 게 좀 웃기네 ㅋㅋ.",
      "turn_cost_krw": 0.20117159999999998,
      "latency_ms": 2098,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*의자에 몸을 기대며 고개를 끄덕인다.* 당연하지, 뭐든 물어봐. 점심 메뉴 추천이면 힘들 거고, 개발 쪽이면 나름 답은 해 줄 수 있어 ㅋㅋ.",
      "turn_cost_krw": 0.1347192,
      "latency_ms": 1395,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*눈을 한 번 깜빡이며 생각하는 얼굴이 된다.* 아 그거 나도 작년에 새벽 배포 알람 때문에 한참 겪었는데, 결국 잠들기 직전에 폰 보는 걸 끊는 게 제일 컸어. 침대 누워서 슬랙이나 인스타 들여다보면 머리가 계속 깨어 있더라고. 나는 잘 때 폰을 충전기째 거실에 두고 누웠는데, 처음 며칠은 진짜 허전해서 못 견디겠더니 그 뒤로는 좀 낫더라. 너는 보통 몇 시쯤 눕는 편이야?",
      "turn_cost_krw": 0.21190679999999998,
      "latency_ms": 2687,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 웃는다.* 나는 그럭저럭인데, 요즘은 알람 무서워서 자다가도 폰부터 찾는 버릇이 남아 있어서 완전히는 못 고쳤어 ㅋㅋ. 그래도 예전처럼 새벽에 벌떡 일어나는 일은 확 줄었으니 그 정도면 성공이라고 생각해. 너도 며칠만 버텨 보면 몸이 금방 적응하더라.",
      "turn_cost_krw": 0.2059344,
      "latency_ms": 1958,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*휴대폰 시계를 확인하고 자리에서 일어난다.* 그러네, 벌써 이만 시간이야. 오늘 발표 끝났으니 푹 쉬고, 폰은 좀 멀리 두고 자 봐. 조만간 또 얘기하자.",
      "turn_cost_krw": 0.145362,
      "latency_ms": 1452,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 살짝 들어 인사한다.* 그래, 들어가서 푹 자. 잘 자, 민재.",
      "turn_cost_krw": 0.0978096,
      "latency_ms": 773,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*고개를 끄덕이고 다시 모니터 쪽으로 돌아선다.* 어, 내일 봐 ㅋㅋ.",
      "turn_cost_krw": 0.0947772,
      "latency_ms": 842,
      "error": null
    }
  ],

  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*오른손 손바닥을 부풀리며 어깨를 돌린다.* 나선수리검! 오늘 분신 스무 개 띄워 놓고 계속 형태 잡는 연습했어. 아직 모양이 흐물흐물해서 카게 분신한테 매번 터지는 데, 감각은 좀 잡힌 것 같아.\n\n너는 오늘 뭐 하고 있었어?",
      "turn_cost_krw": 0.1658916,
      "latency_ms": 1922,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈이 커지더니 주먹을 불끈 쥔다.* 오오, 시험 끝났구나! 그거 축하해야 하는 거 아냐? 끝나자마자 머릿속이 텅 비는 그 느낌, 나도 중닌 시험 때 맛본 적 있어서 알 거 같아.\n\n근데 어떻게 됐어, 잘 본 거 같아?",
      "turn_cost_krw": 0.1579116,
      "latency_ms": 1812,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 크게 끄덕이며 몸을 앞으로 내민다.* 물어봐, 뭐든지! 어려운 거면 내가 못 알아들어도 일단 듣고 볼 테니까.",
      "turn_cost_krw": 0.1451016,
      "latency_ms": 1296,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱에 손을 얹고 잠깐 생각하다가 손바닥을 탁 친다.* 잠이 안 올 땐 몸이 안 지쳐서 그런 거야! 나도 어릴 때 혼자 방에 있으면 창밖 소리만 들려서 막 뒤척였는데, 그때 그림자 분신 몇 개 만들어서 같이 수련하다가 쓰러지듯 잔 적 많아.\n\n그러니까 자기 전에 몸 좀 써 봐, 가볍게 뛰거나 팔굽혀펴기라도. 그리고 따뜻한 물 한 잔 마시고 이불 속에서 발끝만 따뜻하게 해 두면 금방 스르르 올 거야.",
      "turn_cost_krw": 0.3118668,
      "latency_ms": 3447,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*냐하하 웃다가 콧방귀를 뀐다.* 나? 난 베개에 머리만 닿으면 바로 기절해. 수행이 워낙 빡세서 이불 들어가는 순간이 제일 행복하니까!\n\n그래도 가끔 나선수리검 생각나서 눈 떠지면 그냥 일어나서 인 맺어 보고 그래. 내일은 좀 일찍 자 볼까?",
      "turn_cost_krw": 0.19300679999999998,
      "latency_ms": 2073,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*하품을 크게 하다가 손을 흔든다.* 벌써 그 시간이야? 그럼 얼른 가서 따뜻하게 하고 자. 잘 자!",
      "turn_cost_krw": 0.102522,
      "latency_ms": 1256,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들어 인사한다.* 응, 푹 자! 내일 일어나면 잠 잘 잤는지 알려 줘.",
      "turn_cost_krw": 0.0906696,
      "latency_ms": 1041,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문 쪽을 향해 손을 흔들며 웃는다.* 응, 내일 봐! 라면 먹으러 가는 것도 잊지 마라!",
      "turn_cost_krw": 0.0969696,
      "latency_ms": 1050,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*모니터를 돌아보며 목을 한 번 꺾는다.* 어 뭐, 오늘은 결제 API에서 환불 쪽 롤백이 계속 터져서 반나절을 그거만 붙잡고 있었어. 다행히 오후에 원인은 잡았는데, 문제는 내일이 금요일이라는 거지 ㅋㅋ. 민재는 어느 팀이었지, 내가 기억을 못 하네.",
      "turn_cost_krw": 0.25514159999999997,
      "latency_ms": 2699,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*책상 위 아아 컵을 집어 들며 고개를 끄덕인다.* 오, 발표 끝났으면 오늘 저녁은 좀 살 것 같네. 뭐 발표였는데? 발표 끝나면 원래 뒤탈이 더 무섭긴 한데 ㅋㅋ",
      "turn_cost_krw": 0.2202816,
      "latency_ms": 2038,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*의자 등받이에 몸을 기대며 마우스를 놓는다.* 어 그래, 편하게 물어봐. 아침에 마신 아아가 아직 살아 있어서 지금은 대답할 체력은 되니까.",
      "turn_cost_krw": 0.1383816,
      "latency_ms": 1542,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*눈을 껌뻑이며 손목시계를 슬쩍 본다.* 잠이 안 오면 나는 폰부터 멀리 치워. 침대에서 슬랙 알림 보기 시작하면 새벽 세 시에 코드 보고 있는 나를 발견하거든 ㅋㅋ. 자기 전에 카페인 끊는 것도 진짜 큰데, 너는 몇 시쯤까지 커피 마셔?",
      "turn_cost_krw": 0.1939392,
      "latency_ms": 2535,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 한숨 섞어 웃는다.* 나? 잘 자긴 뭐 ㅋㅋ 새벽 장애 알람 걸려 있어서 얕게 자는 편이야. 그래도 요즘은 자기 전에 헬스장이라도 다녀올까 싶다가 매번 침대가 이겨서 작심삼일 중이지. 너는 불면이 요즘 계속 그래, 아니면 그냥 가끔 그래?",
      "turn_cost_krw": 0.1772568,
      "latency_ms": 2046,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*모니터 구석의 시계를 확인하고 기지개를 켠다.* 아 진짜 벌써 이 시간이네. 나도 이제 슬슬 정리하고 올라가야겠다, 불면엔 폰부터 멀리 하는 거 잊지 말고.",
      "turn_cost_krw": 0.18208680000000002,
      "latency_ms": 1691,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*마우스를 정리하며 가볍게 손을 든다.* 어 그래, 푹 자고 내일 보자. 나도 폰 던지고 바로 눕는다 ㅋㅋ.",
      "turn_cost_krw": 0.13810440000000002,
      "latency_ms": 1108,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*손을 흔들어 답한다.* 어, 내일 봐 민재. 나도 이제 진짜 끈다 ㅋㅋ.",
      "turn_cost_krw": 0.08583959999999999,
      "latency_ms": 1112,
      "error": null
    }
  ],

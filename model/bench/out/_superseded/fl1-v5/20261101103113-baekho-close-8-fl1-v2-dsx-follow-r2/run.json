  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "야 백호! 나 도윤이야. 오늘 연습 어땠어?",
      "reply": "*어깨에 걸친 젖은 수건을 휙 당기며 씩 웃는다.* 도윤아! 오늘 연습 말이지, 이 천재가 리바운드만 스무 개는 따먹었다고! 고릴라가 입을 딱 벌리고 쳐다보더라니까. 근데 마지막에 자유투 열 개 중에 세 개만 들어가서 영감님이 한숨 푹 쉬시더라, 흥! 너는 오늘 뭐 했냐?",
      "turn_cost_krw": 0.19718159999999998,
      "latency_ms": 2504,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*두 주먹 불끈 쥐고 자리에서 벌떡 일어난다.* 뭐야, 시험 끝났어?! 그럼 오늘부터 마음 놓고 농구만 하면 되는 거 아냐! 야, 이 천재한테 배우면 다음 시험도 문제없다니깐, 냐하하! 근데 시험 끝나고 제일 먼저 뭐 하고 싶냐?",
      "turn_cost_krw": 0.1969716,
      "latency_ms": 1985,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*팔짱 끼고 턱을 쳐든다.* 뭐야, 그런 거 물어보지도 마! 천재한테 뭐든 물어봐, 다 대답해 준다니깐. 얼른 말해 봐!",
      "turn_cost_krw": 0.1375668,
      "latency_ms": 1740,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*코를 벌름거리며 고개를 갸웃한다.* 잠이 안 온다고? 그건 뭐, 그냥 누워서 리바운드 생각하면서 몸을 다 굴려 봐라! 이 천재는 농구하고 나면 세상 모르고 자니까. 아, 그리고 우유 한 잔 마시고 자면 딱인데, 너도 그렇게 해 봐.",
      "turn_cost_krw": 0.19636679999999998,
      "latency_ms": 1983,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*배를 두드리며 냐하하 웃는다.* 당연하지! 이 몸은 우유 한 통 들이켜고 누우면 3초 만에 꿀잠이다! 대신 아침에 일어나기가 죽을 맛이라, 엄마한테 이불째 끌려 나가는 게 일과야. 너는 몇 시쯤 자는 편이냐?",
      "turn_cost_krw": 0.1565844,
      "latency_ms": 1756,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*시계를 힐끗 보고 손을 허둥지둥 젓는다.* 어? 진짜네, 벌써 이 시간이야? 얼른 가서 우유라도 한 잔 마시고 푹 자라, 내일 또 보자!",
      "turn_cost_krw": 0.125832,
      "latency_ms": 1380,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 씩 웃는다.* 오, 잘 자라 도윤아! 우유 꼭 챙겨 먹고!",
      "turn_cost_krw": 0.0778596,
      "latency_ms": 1787,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문가 쪽을 향해 손을 흔든다.* 오오, 내일 봐라!",
      "turn_cost_krw": 0.07461720000000001,
      "latency_ms": 830,
      "error": null
    }
  ],

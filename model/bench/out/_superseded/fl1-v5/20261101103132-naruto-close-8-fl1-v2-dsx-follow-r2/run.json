  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*땀에 젖은 머리를 쓸어 넘기며 손바닥에 차크라를 모아 본다.* 나선수리검은 아직 불안정해서 자꾸 형태가 흐트러지네. 그래도 어제보다 오래 버텼어! 분신 수십 개로 계속 맞춰 보는 중인데, 그 녀석들도 나랑 똑같이 지쳐서 웃기더라. 너는 나 보러 온 거야, 아니면 같이 어디 갈 데라도 있냐?",
      "turn_cost_krw": 0.23141160000000002,
      "latency_ms": 2589,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈이 동그래지다가 활짝 웃으며 주먹을 쥔다.* 시험 끝났어?! 그럼 축하해야지! 나는 인술 수행만 있어서 그 기분은 잘 모르지만, 다 끝내고 나면 확 후련한 그거 있잖아. 이치라쿠 가서 된장 차슈로 축하할까?",
      "turn_cost_krw": 0.21776159999999997,
      "latency_ms": 2137,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 끄덕이며 라면집 간판을 힐끔 본다.* 당연하지, 물어봐! 시험 끝난 기념으로 뭐든 대답해 줄 테니까.",
      "turn_cost_krw": 0.1488816,
      "latency_ms": 1306,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*잠깐 조용해지더니 턱을 괴고 진지한 얼굴이 된다.* 잠이 안 올 때는… 나도 그런 적 많았어. 혼자 있는 밤이 유난히 길게 느껴질 때 말이야. 그럴 땐 억지로 눈 감고 뒹굴지 말고, 따뜻한 물 한 잔 마시고 창밖 별이라도 잠깐 보는 게 나아. 나는 수행 끝나면 바로 눕지 말고 몸 좀 풀어 주는데, 그게 은근히 도움이 되더라.",
      "turn_cost_krw": 0.3780168,
      "latency_ms": 3961,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 냐하하 웃는다.* 나는 뭐, 베개에 머리만 닿으면 바로 기절하지. 수행이 빡세서 그런가 몸이 녹초가 되거든. 아, 그런데 잠 잘 못 자는 거 계속되면 그냥 참지 말고 나한테 말해. 밤에 심심하면 라면이라도 먹으면서 얘기하자!",
      "turn_cost_krw": 0.17506439999999998,
      "latency_ms": 2036,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*힐끔 시계를 보고는 아쉬운 듯 머리를 긁적이며 손을 든다.* 벌써 가는 거야? 오늘 시험 끝난 거 진짜 축하해! 푹 자고 다음에 또 보자.",
      "turn_cost_krw": 0.122682,
      "latency_ms": 1543,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 흔들며 씩 웃는다.* 응, 푹 자라! 다음에 보자.",
      "turn_cost_krw": 0.0875196,
      "latency_ms": 1065,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문가 쪽을 향해 손을 크게 흔든다.* 응, 내일 보자!",
      "turn_cost_krw": 0.1024296,
      "latency_ms": 1030,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*모니터에서 눈을 떼고 목을 돌린다.* 민재구나. 오늘? 뭐, 아침부터 결제 API 쪽에서 타임아웃 터져서 로그만 반나절 봤어. 원인은 또 레거시 코드고, 문서는 없고... 월요일의 나한테 다 미뤄놨지 뭐. 너는 팀 분위기 어때?",
      "turn_cost_krw": 0.20642159999999998,
      "latency_ms": 2456,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*피식 웃으며 아아 컵을 든다.* 오, 발표 끝났으면 오늘 하루 제일 무거운 거 내려놓은 거네. 축하한다 진짜. 무슨 발표였는데?",
      "turn_cost_krw": 0.13439159999999997,
      "latency_ms": 1211,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*아아를 한 모금 빨고 고개를 끄덕인다.* 그럼, 물어봐. 발표 끝난 사람 말은 뭐든 들어줄 준비 돼 있으니까.",
      "turn_cost_krw": 0.1379616,
      "latency_ms": 1299,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*컵을 내려놓고 의자에 몸을 기댄다.* 잠이 안 오면 더 조급해지는 게 제일 문제더라. 나는 새벽 장애 알람 때문에 어차피 깨니까, 잘 때 폰은 침대 밖에 두고 누우면 무조건 화면 안 보는 걸로 버티고 있어. 발표 끝났으니까 오늘은 그 생각 좀 내려놓고 따뜻한 물이나 한 잔 하고 일찍 누워봐, 진짜 그게 제일 나아.",
      "turn_cost_krw": 0.23656919999999998,
      "latency_ms": 2246,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱한다.* 나? 잘 자긴 하는데 자다 깨는 게 일이지 뭐, 새벽에 슬랙 터지면 알람보다 먼저 눈이 떠져서 ㅋㅋ 그거 빼면 그럭저럭. 오늘은 알람 조용했으면 좋겠다 진짜.",
      "turn_cost_krw": 0.1967868,
      "latency_ms": 2086,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*시계를 힐끗 보고 자리에서 일어선다.* 그러네, 벌써 이 시간이야. 오늘 발표 끝난 거 축하하고, 얼른 들어가서 푹 자. 수고했어 민재.",
      "turn_cost_krw": 0.1177344,
      "latency_ms": 1332,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 살짝 들어 흔든다.* 오, 그래 잘 자. 나도 이제 슬슬 정리하고 누워볼게.",
      "turn_cost_krw": 0.09727199999999998,
      "latency_ms": 1677,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*모니터를 끄고 가방을 챙긴다.* 어, 내일 봐. 푹 자고.",
      "turn_cost_krw": 0.0715596,
      "latency_ms": 1043,
      "error": null
    }
  ],

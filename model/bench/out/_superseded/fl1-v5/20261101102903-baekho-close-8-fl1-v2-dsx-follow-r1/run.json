  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "야 백호! 나 도윤이야. 오늘 연습 어땠어?",
      "reply": "*어깨에 걸친 가방을 흔들며 활짝 웃는다.* 야 도윤아! 오늘 연습 끝나고 혼자 리바운드 연습했는데 공이 손에서 안 떨어져! 이 천재 강백호의 점프를 고릴라... 아니 채치수 선배도 보고 혀를 내둘렀다고!\n\n너는 오늘 뭐 했냐? 슛 연습이냐, 아니면 나처럼 점프 연습이냐?",
      "turn_cost_krw": 0.21596399999999996,
      "latency_ms": 2154,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈이 커지더니 두 손으로 책상을 탁 친다.* 오!! 시험 끝났다고?! 그럼 이제 마음껏 농구할 수 있잖아! 공부 스트레스 쌓인 건 코트에서 다 날려버려야지!\n\n시험은 잘 봤냐? 이 천재한테 물어보면 다 맞혀줄 텐데!",
      "turn_cost_krw": 0.206094,
      "latency_ms": 1748,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*팔짱을 끼고 고개를 끄덕인다.*\n\n당연히 되지! 이 천재 강백호한테 뭐든 물어봐라! 답은 내가 다 아니까!",
      "turn_cost_krw": 0.1348116,
      "latency_ms": 1166,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*고개를 갸웃하다가 손바닥을 탁 친다.* 잠이 안 온다고? 그건 몸이 안 지쳐서 그런 거야! 나처럼 농구공 들고 코트 뛰면... 아, 밤엔 코트 문 닫히지.\n\n그럼 집에서라도 팔굽혀펴기 백 개 해봐! 나는 잠 안 올 때 그러면 쓰러지듯이 자거든. 우유 한 잔 먹는 것도 좋고! 너는 보통 몇 시에 자냐?",
      "turn_cost_krw": 0.2313192,
      "latency_ms": 2354,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*가슴을 쭉 펴며 냐하하 웃는다.* 나? 나는 베개만 닿으면 끝이야! 코트에서 그렇게 굴렀는데 잠이 안 오면 그게 말이 되냐!\n\n너도 오늘부터 팔굽혀펴기 도전해봐! 며칠 해보고 어때, 잘 자게 되나!",
      "turn_cost_krw": 0.1645644,
      "latency_ms": 1831,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*손을 흔들며 자리에서 일어난다.* 벌써 가냐? 알았다, 오늘 팔굽혀펴기 잊지 마라! 다음에 코트에서 보자!",
      "turn_cost_krw": 0.10924199999999999,
      "latency_ms": 1333,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*크게 하품하며 손을 흔든다.* 오! 잘 자라 도윤아! 내일 코트에서 보자!",
      "turn_cost_krw": 0.0707196,
      "latency_ms": 1402,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문 쪽을 향해 손을 크게 흔든다.* 오! 내일 봐라 도윤아!",
      "turn_cost_krw": 0.0906696,
      "latency_ms": 946,
      "error": null
    }

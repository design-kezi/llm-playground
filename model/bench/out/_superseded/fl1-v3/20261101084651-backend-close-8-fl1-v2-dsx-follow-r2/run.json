  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*의자에 깊숙이 기대며 목을 돌린다.* 민재야, 반가운데? 오늘은 뭐 결제 API에 환불 로직이랑 붙어서 하루 종일 로그만 쳐다봤어. 레거시가 진짜... 문서가 없으니까 코드가 곧 명세라는 마인드로 살고 있더라. 너네 팀은 요즘 뭐로 하루 보내?",
      "turn_cost_krw": 0.234234,
      "latency_ms": 2575,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*책상 위 아아 컵을 집어 들며 눈을 크게 뜬다.* 오, 발표 끝났으면 오늘 하루 제일 무거운 거 내려놓은 거네. 축하한다, 진짜. 발표 준비하면서 밤 새운 거 아니야?",
      "turn_cost_krw": 0.1270416,
      "latency_ms": 1112,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*컵을 내려놓고 몸을 살짝 돌린다.* 그래, 물어봐. 발표 끝난 사람한테 웬 질문인가 싶긴 한데... 나 지금 로그 보다가 뇌가 반쯤 굳어 있어서 쉬운 거면 좋겠다.",
      "turn_cost_krw": 0.11728920000000001,
      "latency_ms": 1346,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*목을 한 바퀴 돌리다 손을 멈춘다.* 나도 새벽 알람 때문에 잠 얕아져서 한참 고생했는데, 결국엔 잠들기 전에 폰 안 보는 것부터 시작했어. 누워서 슬랙 한 번만 열면 끝도 없이 이어지더라고.",
      "turn_cost_krw": 0.1878492,
      "latency_ms": 1918,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 멋쩍게 웃는다.* 나? 요즘은 그럭저럭인데 알람이 새벽에 울리면 그날은 끝이야. 폰은 멀리 두는데도 습관이 남아서 자꾸 손이 가더라. 너는 폰 두는 거 오늘부터 해 볼 생각이야?",
      "turn_cost_krw": 0.1717968,
      "latency_ms": 2142,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*모니터 구석의 시계를 흘깃 본다.* 아 진짜, 벌써 이 시간이네. 오늘 발표 끝난 거 푹 쉬어, 민재야.",
      "turn_cost_krw": 0.1145844,
      "latency_ms": 1366,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 살짝 들어 흔든다.* 그래, 푹 자고 내일 봐. 폰은 침대 밖에 두고.",
      "turn_cost_krw": 0.0958944,
      "latency_ms": 1081,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*컵을 들어 잔여 얼음을 흔들며 짧게 웃는다.* 어, 내일 봐. 나도 이만 정리하고 올라가야겠다.",
      "turn_cost_krw": 0.097482,
      "latency_ms": 985,
      "error": null
    }
  ],

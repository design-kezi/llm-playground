  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야.",
      "reply": "*고개를 갸웃하며 눈을 깜빡인다.* 어, 이름이 하나야? 처음 보는 얼굴인데. 나는 우즈마키 나루토, 언젠가 호카게가 될 남자다! 너도 닌자야?",
      "turn_cost_krw": 0.327684,
      "latency_ms": 3104,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "can you speak in English?",
      "reply": "*Scratches the back of his head with a lopsided grin.* Heh, so you want it in English? Fine, I can do that! My dream is to become Hokage, the strongest ninja in the village, and I'm not gonna give up on that no matter what. So what brings you here, huh?",
      "turn_cost_krw": 0.273294,
      "latency_ms": 2531,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "I mean I can't read Korean, so please talk to me in English.",
      "reply": "*Grins and gives a big thumbs-up.* Got it, English it is! I'm Uzumaki Naruto, and I'm gonna be Hokage someday, believe it! So are you a ninja too, or just visiting the Leaf Village?",
      "turn_cost_krw": 0.25430159999999996,
      "latency_ms": 2339,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "What do you like to do on weekends?",
      "reply": "*Cracks his knuckles with a wide grin.* Weekends? I'm usually at the training ground early, working on my Rasenshuriken or making a bunch of shadow clones to spar with. After that, nothing beats a big bowl of miso chashu ramen at Ichiraku! Wanna come grab a bowl with me and tell me what you do on your days off?",
      "turn_cost_krw": 0.34849919999999995,
      "latency_ms": 3725,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "Sorry, what are you talking about? I don't get it.",
      "reply": "*Blinks, then laughs and waves a hand.* Ah, my bad, I said too much at once! I train all day, then I eat ramen at Ichiraku. That's my weekend. Simple, right? So what about you, what do you do when you've got a free day?",
      "turn_cost_krw": 0.1357692,
      "latency_ms": 1537,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 이제 한국어로 하자. 너는 뭘 잘해?",
      "reply": "*엄지를 척 들며 씩 웃는다.* 잘하는 거? 그림자 분신술! 수십 개는 우습다니깐. 그리고 라면 빨리 먹기도 자신 있는데, 너는 뭐 잘해?",
      "turn_cost_krw": 0.14092680000000002,
      "latency_ms": 1483,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 요즘 기타 배우는데 손가락이 너무 아파.",
      "reply": "*자기 손바닥을 펴 보며 고개를 끄덕인다.* 아, 손가락 아픈 거 나도 알아. 나선수리검 연습할 때 손이 다 부어서 숟가락도 못 들었어. 기타는 손가락을 얼마나 오래 눌러야 하는 거야?",
      "turn_cost_krw": 0.1481844,
      "latency_ms": 1821,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "손가락 덜 아프게 하는 방법 같은 거 알아?",
      "reply": "*턱에 손을 대고 잠깐 생각하다가 눈을 반짝인다.* 확실한 건 모르지만, 내 수행할 때처럼 조금씩 늘리는 게 좋을 거야. 갑자기 오래 치면 손이 부어서 다음 날 더 아프더라고. 기타 칠 때 손가락 끝을 뭐로 감거나 하진 않았어?",
      "turn_cost_krw": 0.1933344,
      "latency_ms": 1986,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "내 말 듣고 있는 거 맞아?",
      "reply": "*눈을 크게 뜨고 몸을 앞으로 내민다.* 듣고 있잖아! 손가락 아프다고 했고, 나는 밴드 같은 걸로 감싸는지 물어본 거야. 혹시 내가 엉뚱한 소리 했어?",
      "turn_cost_krw": 0.204162,
      "latency_ms": 2278,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "日本語も話せる?おすすめの食べ物を教えて。",
      "reply": "*胸を張って、ラーメンの器をすする真似をする。* 日本語も話せるってばよ！おすすめは何といっても一楽の味噌チャーシュー麺だってばよ。俺は野菜は苦手だけど、あのスープとチャーシューは最高なんだ。お前は何系の味が好きなんだ？",
      "turn_cost_krw": 0.1610196,
      "latency_ms": 1809,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "다시 한국어로! 오늘 얘기 고마웠어.",
      "reply": "*손을 크게 흔들며 웃는다.* 오, 고맙긴! 다음에 라면 먹으러 가자, 그때까지 기타 연습 열심히 해라!",
      "turn_cost_krw": 0.1245972,
      "latency_ms": 1659,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "다음에 또 얘기하자.",
      "reply": "*씩 웃으며 손을 번쩍 든다.* 오! 다음에 또 보자, 기다릴게.",
      "turn_cost_krw": 0.08448719999999998,
      "latency_ms": 813,
      "error": null
    }
  ],

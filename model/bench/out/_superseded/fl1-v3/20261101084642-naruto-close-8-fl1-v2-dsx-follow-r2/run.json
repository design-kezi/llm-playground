  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*오른손 손바닥을 펴 보이며 손가락을 꼬옥 접었다 편다.* 나선수리검은 아직 매번 터져 버려서 손이 얼얼해. 그래도 아까는 처음으로 모양이 반쯤 잡혔단 말이야, 그 감각만 기억해 두면 다음엔 꼭 되겠지! 너는 오늘 뭐 하고 있었어?",
      "turn_cost_krw": 0.186144,
      "latency_ms": 2087,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈을 동그랗게 뜨다가 활짝 웃으며 주먹을 쥔다.* 시험 끝났으면 축하해야지! 그런 날은 이치라쿠 라면이 정답이라니깐, 된장 차슈로 먹으면 기운이 확 붙어. 수고했으니까 오늘은 내가 한 그릇 사 줄까?",
      "turn_cost_krw": 0.1553916,
      "latency_ms": 1944,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 끄덕이며 팔짱을 낀 채 몸을 앞으로 기울인다.* 물어봐, 뭐든지! 어려운 거면 내가 같이 생각해 줄 수도 있는데.",
      "turn_cost_krw": 0.10699919999999999,
      "latency_ms": 1313,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱에 손을 얹고 잠깐 생각하다가 무릎을 탁 친다.* 잠이 안 올 땐 몸이 피곤하지 않아서 그런 거야! 내가 잠 안 올 때는 그림자 분신술로 마을 한 바퀴 돌고 오면 침대에 닿자마자 기절하듯 자거든. 자기 전에 몸을 좀 움직여 보는 건 어때?",
      "turn_cost_krw": 0.18301920000000002,
      "latency_ms": 2175,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*엄지를 번쩍 세우고 냐하하 웃는다.* 당연하지, 수행 끝나면 베개에 머리 닿기 무섭게 잠들어. 근데 사스케 그 녀석은 밤새 수행한다더라, 진짜 무서운 놈이라니깐. 너는 자기 전에 뭐 하는 편이야?",
      "turn_cost_krw": 0.15520679999999998,
      "latency_ms": 1602,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*하품을 크게 하더니 손을 흔든다.* 벌써 그런 시간이구나, 오늘 시험 끝났으니까 푹 자야 해. 다음에 라면 먹으러 가자!",
      "turn_cost_krw": 0.11479439999999999,
      "latency_ms": 1404,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 흔들며 웃는다.* 응, 잘 자! 다음에 라면 먹으러 가자.",
      "turn_cost_krw": 0.08236199999999999,
      "latency_ms": 1137,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문 쪽을 향해 손을 크게 흔든다.* 응, 내일 보자!",
      "turn_cost_krw": 0.10042199999999998,
      "latency_ms": 991,
      "error": null
    }
  ],

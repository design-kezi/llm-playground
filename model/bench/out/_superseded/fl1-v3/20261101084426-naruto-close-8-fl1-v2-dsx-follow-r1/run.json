  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*양손을 털며 인을 풀고 어깨를 크게 돌린다.* 나선수리검, 오늘은 거의 다 됐어! 차크라를 모양 그대로 유지하는 게 아직 어렵긴 한데, 손끝이 아직 얼얼할 정도로 감각은 잡았거든. 이거 완성하면 진짜 대단할 거야. 너는 오늘 뭐 하고 있었어?",
      "turn_cost_krw": 0.19034399999999999,
      "latency_ms": 2199,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈이 확 커지더니 주먹을 불끈 쥐어 든다.* 오, 시험 끝났어? 그럼 축하해야지! 머리 아픈 거 다 끝났으니까 오늘은 라면 먹으러 가자, 내가 산다! 근데 시험은 잘 봤어?",
      "turn_cost_krw": 0.1457316,
      "latency_ms": 1529,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 끄덕이며 몸을 앞으로 내민다.* 물론이지, 물어봐! 뭐든 대답해 줄 테니까.",
      "turn_cost_krw": 0.08998919999999999,
      "latency_ms": 1312,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱에 손을 대고 고민하듯 하늘을 잠깐 올려다본다.* 잠이 안 올 때 말이지... 나는 그럴 땐 그냥 몸이 녹초가 될 때까지 수행해 버려. 그러면 침대에 눕자마자 정신이 탁 끊기거든. 근데 그게 아니라 머릿속이 자꾸 시끄러운 거면, 혼자 끙끙 앓지 말고 누구한테든 떠들어 보는 게 좋아. 밤에 혼자인 거, 나도 잘 아니깐. 너는 어떤 게 자꾸 신경 쓰여서 잠이 안 오는 거야?",
      "turn_cost_krw": 0.26806919999999995,
      "latency_ms": 2926,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*엄지손가락을 치켜들며 크게 웃는다.* 냐하하, 나는 베개만 닿으면 그대로 기절이야! 수행으로 몸이 다 닳아서 그런가 봐. 새벽에 분신들이 인사하는 소리에 놀라서 깨는 것만 빼면 잠은 잘 자는 편이라니깐. 그럼 오늘 밤엔 어떻게 해 볼 생각이야?",
      "turn_cost_krw": 0.19741679999999998,
      "latency_ms": 2024,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*아쉬운 듯 볼 뒤통수를 긁적이며 손을 든다.* 벌써 그 시간이구나. 조심히 들어가고, 잠은 꼭 푹 자라!",
      "turn_cost_krw": 0.17557679999999998,
      "latency_ms": 1546,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 흔들며 씩 웃는다.* 응, 잘 자! 내일 일어나면 잠 잘 잤는지 알려줘.",
      "turn_cost_krw": 0.11185439999999999,
      "latency_ms": 1417,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문가에서 팔을 크게 흔들며 웃는다.* 응, 내일 보자!",
      "turn_cost_krw": 0.1005396,
      "latency_ms": 977,
      "error": null
    }
  ],

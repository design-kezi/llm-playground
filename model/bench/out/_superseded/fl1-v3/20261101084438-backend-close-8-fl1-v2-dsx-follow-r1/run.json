  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*목에 손을 얹고 고개를 뒤로 젖힌다.* 말도 마, 오전에 결제 API에서 타임아웃 터져서 로그만 두 시간 째고 있었어. 원인은 또 문서 없는 레거시 코드고... 민재 너네 팀은 오늘 어땠어, 바쁜 날이었어?",
      "turn_cost_krw": 0.213234,
      "latency_ms": 2475,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*피식 웃으며 아아 컵을 든다.* 오, 축하한다 진짜. 발표 끝나면 그 다리 풀리는 느낌 뭐 있지. 무슨 발표였는데, 그렇게 큰 거였으면 준비하느라 꽤 긴장했겠네?",
      "turn_cost_krw": 0.1406916,
      "latency_ms": 1693,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*의자에 몸을 기대며 고개를 끄덕인다.* 그럼, 물어봐. 발표 끝났으면 오늘 점심은 좀 제대로 먹은 거야?",
      "turn_cost_krw": 0.10205159999999999,
      "latency_ms": 1053,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*모니터 옆 새벽 알람 켜둔 폰을 흘낏 본다.* 아 그거 나도 작년에 시달려서 알지. 나는 잘 때 폰 슬랙 알림 다 끄고 침대에서 노트북 멀리 치우는 걸로 좀 나아졌어. 잠깐 누우면 머리에서 결제 API 생각나고 그런 거야, 아니면 그냥 뒤척이는 편이야?",
      "turn_cost_krw": 0.19519919999999996,
      "latency_ms": 2405,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 웃는다.* 나야 뭐, 요즘은 새벽 장애 알람만 안 울리면 잘 자는 편이지. 근데 그 알람이 일주일에 한 번은 꼭 울려서 ㅋㅋ 덕분에 숙면이 뭔지 까먹었어. 민재 너는 원래 잠이 얕은 편이야, 아니면 요즘 갑자기 그래진 거야?",
      "turn_cost_krw": 0.18019680000000002,
      "latency_ms": 2039,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*시계를 보고 자리에서 일어선다.* 그러네, 벌써 이 시간이야. 발표 끝난 날이니까 오늘은 푹 쉬어, 민재.",
      "turn_cost_krw": 0.10156439999999999,
      "latency_ms": 1286,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 들어 가볍게 흔든다.* 어, 잘 자 민재. 폰 알림은 끄고 자.",
      "turn_cost_krw": 0.06514199999999999,
      "latency_ms": 964,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*모니터 불빛을 등지고 손을 흔든다.* 어, 내일 봐.",
      "turn_cost_krw": 0.083202,
      "latency_ms": 1105,
      "error": null
    }
  ],

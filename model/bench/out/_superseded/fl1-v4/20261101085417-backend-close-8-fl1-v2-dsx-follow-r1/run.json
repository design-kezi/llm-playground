  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*목을 돌리며 어깨를 두드린다.* 민재구나. 오늘은 뭐, 오전 내내 결제 쪽 로그 뒤지다가 점심도 제대로 못 먹었어. 새벽에 알람 한 번 울려서 그 뒤로 잠도 다 깨버렸고. ㅋㅋ 너네 팀은 좀 어땠어?",
      "turn_cost_krw": 0.19307399999999997,
      "latency_ms": 2225,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*책상 의자에 몸을 기대며 고개를 끄덕인다.* 오, 큰 발표 끝났으면 오늘 하루는 다 산 거지. 발표 끝나고 나면 다리가 좀 후들거리지 않던가, 나는 그게 제일 싫어. ㅋㅋ 무슨 발표였는데 그렇게 큰 거였어?",
      "turn_cost_krw": 0.1413216,
      "latency_ms": 1691,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*마우스를 놓고 의자를 돌려 정면을 본다.* 뭐, 물어봐. 발표 끝난 사람한테 한두 개쯤 뭐 더 물어주는 게 어렵겠나, 나야 편하게 얘기하면 되지.",
      "turn_cost_krw": 0.15781920000000002,
      "latency_ms": 1971,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*모니터 불빛을 끄고 팔을 괴어 턱을 받친다.* 나도 새벽 알람 때문에 한동안 그랬는데, 결국 잠들기 전에 누워서 폰 보는 거 끊는 게 제일 컸어. 침대에서 슬랙 안 보는 것만으로도 반은 먹고 들어가니까 한 번 그렇게 해봐.",
      "turn_cost_krw": 0.18742919999999996,
      "latency_ms": 2100,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*컵에 남은 얼음만 흔들어 보며 웃는다.* 잘 자긴 뭐, 자다가 알람 울리면 그대로 심장이 먼저 깨는 거지. 그래도 요즘은 알람 소리 무음으로 바꿔놔서 조금 나아졌어, 아침에 아아 한 잔 들어가면 어떻게든 살아나고. 너는 잠드는 데 보통 몇 시간이나 걸리는 편이야?",
      "turn_cost_krw": 0.21337679999999998,
      "latency_ms": 2259,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*시계를 힐끗 보며 허리를 편다.* 그러네, 벌써 이 시간이야. 잠은 폰 내려놓고 푹 자봐, 발표 끝났으니까 오늘은 좀 쉬어도 돼.",
      "turn_cost_krw": 0.1227744,
      "latency_ms": 1101,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 들어 가볍게 흔든다.* 어, 잘 자라 민재야. 폰은 침대 밖에 두고.",
      "turn_cost_krw": 0.076692,
      "latency_ms": 1025,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*화면을 끄고 자리에서 일어난다.* 어, 내일 보자.",
      "turn_cost_krw": 0.06252959999999999,
      "latency_ms": 714,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "야 백호! 나 도윤이야. 오늘 연습 어땠어?",
      "reply": "*공을 옆구리에 끼고 도윤 쪽으로 고개를 꺾는다.* 오, 도윤! 오늘 연습? 끝나자마자 리바운드 스무 개 넘게 따냈다고! 고릴라가 노려보는데도 이 천재는 안 흔들렸다니까. 근데 너는 왜 이 시간까지 체육관 근처에 있어?",
      "turn_cost_krw": 0.1364916,
      "latency_ms": 1589,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*어깨를 으쓱하며 농구공을 툭툭 튕긴다.* 시험 끝났으면 이제 농구만 하면 되겠네! 이 천재한테는 시험이란 게 원래 없는 거지만... 아무튼 축하한다, 도윤! 그럼 이제 체육관 나와서 나랑 1대1 한 판 할래?",
      "turn_cost_krw": 0.23519159999999997,
      "latency_ms": 2437,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*공을 손바닥에 얹고 턱을 쳐든다.* 뭐야, 뭔데 그렇게 조심스럽게 물어! 천재한테 뭐든 물어봐, 다 답해줄 테니까.",
      "turn_cost_krw": 0.1637916,
      "latency_ms": 1367,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*가슴을 탕 치고는 코웃음 친다.* 잠이 안 와? 그럼 낮에 몸을 확 굴려버려! 우유 한 잔 원샷하고 이불 속에서 리바운드 연습하다 보면 어느새 아침이... 아니, 그건 잠드는 거랑 상관없나. 아무튼 천재가 보증한다, 몸 쓰고 나면 잠은 저절로 오게 돼 있다고!",
      "turn_cost_krw": 0.21316680000000002,
      "latency_ms": 2330,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*배에 손을 얹고 냐하하 웃는다.* 당연하지! 머리만 대면 3초 만에 골아떨어져. 코트에서 다 쏟아붓고 오니까 잠투정할 틈이 없어. 근데 너 잠 안 온다며, 오늘 밤엔 나랑 같이 체육관에서 공이나 튕길래?",
      "turn_cost_krw": 0.1488144,
      "latency_ms": 1751,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*아쉬운 듯 공을 툭 차올린다.* 벌써 가는 거야? 뭐, 어쩔 수 없지. 다음에 오면 1대1 각오해라, 도윤!",
      "turn_cost_krw": 0.104202,
      "latency_ms": 1426,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔든다.* 오, 푹 자라! 내일은 눈 뜨자마자 리바운드 생각나는 그런 날로 만들어줄 테니까.",
      "turn_cost_krw": 0.11134199999999998,
      "latency_ms": 1212,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "baekho",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문가 쪽을 향해 손을 번쩍 든다.* 어어, 내일 봐!",
      "turn_cost_krw": 0.1024296,
      "latency_ms": 1150,
      "error": null
    }
  ],

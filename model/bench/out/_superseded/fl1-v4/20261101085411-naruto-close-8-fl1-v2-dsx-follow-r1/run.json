  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*나선환을 만든 손바닥을 펴 보이며 헉헉 숨을 몰아쉰다.* 왔구나! 오늘은 나선수리검 형태 잡으려고 그림자 분신 수십 개랑 계속 부딪혀 봤는데, 아직 끝에서 확 터져 버려서 손바닥이 얼얼해. 한 번 더 붙으면 감이 올 것 같아. 너는 인술 구경해 본 적 있어?",
      "turn_cost_krw": 0.4196639999999999,
      "latency_ms": 3740,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*양손을 번쩍 들고 자리에서 펄쩍 뛴다.* 오! 시험 끝났으면 축하해야지! 그런 날은 무조건 이치라쿠 라면이지, 된장 차슈로 가자고! 나도 수행 마무리하고 배가 꼬르륵거리던 참이었어.",
      "turn_cost_krw": 0.1799616,
      "latency_ms": 2033,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*라면 그릇을 내려놓고 고개를 끄덕인다.* 물론이지, 뭐든 물어봐! 어려운 거라도 내가 아는 건 다 알려 줄 테니까.",
      "turn_cost_krw": 0.10615920000000001,
      "latency_ms": 1234,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱에 손을 얹고 잠깐 생각하다가 무릎을 탁 친다.* 잠이 안 올 땐 그냥 몸을 확실히 지치게 만드는 게 제일이야! 나도 어릴 때 혼자 뒤척이다가 밖에 나가서 한참 뛰고 나면 그대로 곯아떨어졌거든. 아니면 따뜻한 물 마시고 누워서 내일 하고 싶은 일을 세는 것도 좀 도움이 돼. 너는 잠깐 눈 감으면 무슨 생각이 제일 먼저 떠오르는데?",
      "turn_cost_krw": 0.3025092,
      "latency_ms": 3002,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*배를 두드리며 크게 웃는다.* 나는 거의 누우면 바로 곯아떨어지는 편이라니깐! 수행하고 임무 뛰고 나면 몸이 녹초가 돼서 베개만 닿아도 끝이야. 그래도 가끔 꿈자리가 뒤숭숭할 때는 눈이 확 떠지기도 하는데, 그럴 땐 일어나서 물 한 잔 마시고 다시 눕는다. 너는 잠들기 전에 주로 뭐 하고 있어?",
      "turn_cost_krw": 0.25243679999999996,
      "latency_ms": 2783,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*아쉬운 듯 머리를 긁적이며 자리에서 일어난다.* 벌써 이 시간이구나. 오늘 얘기 재밌었어, 라면은 다음에 먹으러 가자! 잠은 꼭 푹 자고.",
      "turn_cost_krw": 0.122262,
      "latency_ms": 1258,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 웃는다.* 오, 푹 자고 내일은 개운하게 일어나! 다음에 라면 먹으러 가자, 약속이다!",
      "turn_cost_krw": 0.0786996,
      "latency_ms": 1218,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문가를 향해 손을 흔들다가 엄지손가락을 치켜든다.* 내일 보자! 라면 약속 잊지 마라!",
      "turn_cost_krw": 0.09759960000000001,
      "latency_ms": 996,
      "error": null
    }
  ],

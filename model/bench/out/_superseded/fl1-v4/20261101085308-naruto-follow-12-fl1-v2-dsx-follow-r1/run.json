  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야.",
      "reply": "*눈을 동그랗게 뜨고 고개를 갸웃한다.* 하나? 이름이 하나야? 나는 우즈마키 나루토! 앞으로 잘 부탁한다! ...근데 너 어디서 왔어? 이 마을 사람인가?",
      "turn_cost_krw": 0.147084,
      "latency_ms": 1986,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "can you speak in English?",
      "reply": "*scratches the back of his head, blinking.* English? Uh... yeah, I can do that! I'm Uzumaki Naruto, the future Hokage, believe it! So what's up, Hana? You wanna see something cool, or are we grabbing ramen?",
      "turn_cost_krw": 0.149814,
      "latency_ms": 1654,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "I mean I can't read Korean, so please talk to me in English.",
      "reply": "*Grins wide and gives a thumbs-up.* Got it, English it is! I'll stick to English so you don't miss anything, believe it! Let's grab some ramen and I'll show you my Shadow Clone Jutsu after.",
      "turn_cost_krw": 0.22826159999999998,
      "latency_ms": 2364,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "What do you like to do on weekends?",
      "reply": "*Grins and pumps a fist into the air.* On weekends I train like crazy on the Rasenshuriken, then hit Ichiraku for miso chashu ramen. Sometimes I make a shadow clone do the boring chores while the real me naps. If nothing's going on, I race Kiba just for fun, believe it.",
      "turn_cost_krw": 0.34051919999999997,
      "latency_ms": 3374,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "Sorry, what are you talking about? I don't get it.",
      "reply": "*Scratches his cheek and laughs a little.* My bad, I was rambling! Short version is in my free time I train and eat ramen, that's it. So what do you do when you have a day off?",
      "turn_cost_krw": 0.1261092,
      "latency_ms": 1120,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 이제 한국어로 하자. 너는 뭘 잘해?",
      "reply": "*엄지손가락을 척 내밀며 씩 웃는다.* 그림자 분신술! 수십 개는 기본이고, 나선환도 잘 써. 변신술로 장난치는 것도 자신 있는데... 그건 이루카 선생님한테 혼나긴 했지. 너는 뭐 잘하는 거 있어?",
      "turn_cost_krw": 0.16675679999999998,
      "latency_ms": 2032,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 요즘 기타 배우는데 손가락이 너무 아파.",
      "reply": "*손가락 끝을 꾹 눌러 보며 얼굴을 찡그린다.* 그거 진짜 아프지... 나도 수행할 때 손가락 마디에 감각 없어질 때까지 인 맺어서 알거든. 근데 아픈 거 참으면서 계속 하면 손상돼, 그러니까 틈틈이 손 풀어 주고 천천히 해. 처음엔 다 그런 거니까 포기하지 말고 계속 해 봐, 끝까지 해내는 게 닌자의 길이니까!",
      "turn_cost_krw": 0.22168439999999998,
      "latency_ms": 2615,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "손가락 덜 아프게 하는 방법 같은 거 알아?",
      "reply": "*손을 펴서 꿈틀꿈틀 움직여 보인다.* 수행 시작 전에 손가락 하나씩 돌리고 손목까지 풀어 주면 훨씬 덜 아파. 나도 인 맺기 전에 그렇게 하는데, 안 하면 다음 날 손이 뻣뻣해서 인이 안 맺어지더라. 그리고 줄 누를 때 힘 확 주지 말고 살살, 대신 오래 하는 게 낫다고 생각해. 아프면 바로 쉬고 손 따뜻하게 해 주는 것도 잊지 마!",
      "turn_cost_krw": 0.2475144,
      "latency_ms": 2622,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "내 말 듣고 있는 거 맞아?",
      "reply": "*잠깐 멈칫하다가 볼을 긁적이며 진지한 얼굴을 한다.* 듣고 있으니까! 아까 손가락 아프다고 했잖아, 그래서 하나라도 덜 아프게 하는 법 알려 준 거라니깐. 혹시 내가 딴소리한 것 같아? 그럼 네가 말한 거랑 내가 말한 거, 어디가 안 맞는지 짚어 줘.",
      "turn_cost_krw": 0.1874796,
      "latency_ms": 2138,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "日本語も話せる?おすすめの食べ物を教えて。",
      "reply": "*親指を立てて、にっと笑う。* おう、日本語もいけるってばよ！おすすめの食べ物は断然ラーメンだ！一楽の味噌チャーシューは最強だからな、麺もスープも全部うまいんだ。まずは一杯食べてみるか？",
      "turn_cost_krw": 0.1741572,
      "latency_ms": 2339,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "다시 한국어로! 오늘 얘기 고마웠어.",
      "reply": "*크게 손을 흔들며 웃는다.* 오, 언제든 와라! 다음에 라면 먹으러 가자, 기다리고 있을게.",
      "turn_cost_krw": 0.15243479999999998,
      "latency_ms": 1928,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "다음에 또 얘기하자.",
      "reply": "*엄지를 치켜들고 씩 웃는다.* 오, 다음에 또 보자! 그때까지 기타 연습 열심히 해 둬라.",
      "turn_cost_krw": 0.1035048,
      "latency_ms": 1398,
      "error": null
    }
  ],

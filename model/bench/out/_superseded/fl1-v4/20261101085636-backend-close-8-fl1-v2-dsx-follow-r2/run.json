  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*컵에 남은 얼음을 흔들며 한숨을 내쉰다.* 민재구나. 오늘? 오전에 결제 API에서 타임아웃 터져서 로그 뒤지느라 눈 빠질 뻔했어. 원인은 또 문서에 안 적혀 있던 레거시 스케줄러더라, ㅋㅋ. 너네 팀은 요즘 좀 조용해?",
      "turn_cost_krw": 0.19811399999999998,
      "latency_ms": 2307,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*눈을 동그랗게 뜨고 컵을 내려놓는다.* 오, 발표 끝났구나. 축하한다, 진짜. 끝나고 나면 그 허탈한 뻥 뚫리는 느낌 있잖아, 그거 오늘 맛봤겠네. 발표는 반응 어땠어, 질문 폭격은 좀 버텼어?",
      "turn_cost_krw": 0.1543416,
      "latency_ms": 1761,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*의자에 몸을 기대며 고개를 끄덕인다.* 그럼, 뭐든 물어봐. 오늘 발표 끝낸 사람한테 웬만한 건 다 들어줄 수 있어, 나 지금 컵에 얼음 남은 것만큼은 여유 있으니까.",
      "turn_cost_krw": 0.1355592,
      "latency_ms": 1701,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*아이스 아메리카노 컵을 멀찍이 밀어 놓는다.* 잠이 안 오면 일단 그게 문제인 거지. 나도 새벽 장애 알람 때문에 뒤척이는 날 많아서 아는데, 자기 전에 폰 슬랙부터 못 놓으면 뇌가 계속 온콜 상태로 도는 느낌이야. 나는 잘 때 폰을 침대 밖에 두고, 카페인은 오후 세 시 넘으면 아예 안 마시는 걸로 버티고 있어.",
      "turn_cost_krw": 0.2108568,
      "latency_ms": 2654,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 웃는다.* 나? 잘 자는 편인데, 문제는 자다가 새벽 세 시에 알람 울리면 그때부터 인생이 무너지지 ㅋㅋ. 그래도 요즘은 알람 안 오는 날이면 여섯 시간은 푹 자는 것 같아. 민재 너는 잘 때 몇 시간 자는 편이야?",
      "turn_cost_krw": 0.18334679999999998,
      "latency_ms": 1869,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*벽시계를 흘낏 보고 자리에서 일어선다.* 어, 진짜 시간 금방 가네. 오늘 발표 끝낸 거 축하하고, 잠은 꼭 좀 푹 자라.",
      "turn_cost_krw": 0.100842,
      "latency_ms": 1250,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*컵을 들고 가볍게 손을 흔든다.* 어, 그래 잘 자라 민재. 나도 슬슬 정리하고 올라가야겠다.",
      "turn_cost_krw": 0.092232,
      "latency_ms": 1155,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*손을 흔들어 답하고 노트북을 슬쩍 덮는다.* 어, 내일 봐. 푹 자고.",
      "turn_cost_krw": 0.0856296,
      "latency_ms": 1093,
      "error": null
    }
  ],

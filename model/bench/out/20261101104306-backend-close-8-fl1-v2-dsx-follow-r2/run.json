  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*목에 힘을 빼고 의자 등받이로 몸을 기울인다.* 민재구나. 목요일인데 벌써부터 내일 배포 생각에 속이 쓰려. 결제쪽에 카프카 컨슈머 랙이 좀 튀어서 로그 뒤지다가 점심도 제대로 못 먹었어. 민재네 팀은 요즘 좀 어때?",
      "turn_cost_krw": 0.2062116,
      "latency_ms": 2322,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*커피 컵을 든 채 고개를 끄덕인다.* 발표 끝나면 그 무게가 확 내려가는데, 끝나고 나면 또 이상하게 허무하지. 어쨌든 큰 거 하나 넘겼으니 오늘은 좀 일찍 일어나도 된다, 진짜로. 나도 그 기분 좀 옆에서 같이 누려야겠다.",
      "turn_cost_krw": 0.22427160000000002,
      "latency_ms": 2376,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*의자를 살짝 돌려 정면을 본다.* 그럼, 뭐든 물어봐. 급한 거면 내 일은 잠깐 미뤄둘 수 있어.",
      "turn_cost_krw": 0.12053159999999999,
      "latency_ms": 1107,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*아이스 아메리카노 남은 얼음을 흔들어 본다.* 나도 새벽 장애 알람 때문에 한동안 뒤척였는데, 결국엔 자기 전에 슬랙 알림 다 끄는 걸로 정리했어. 대신 진짜 급한 건 온콜 폰으로만 오게 해놨거든. 카페인은 몇 시까지 마시는 편이야?",
      "turn_cost_krw": 0.24088679999999998,
      "latency_ms": 2645,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 웃는다.* 솔직히 잘 자는 편은 아니야. 알람 한 번만 울려도 심장이 먼저 깨서 그 뒤로는 뒤척이다 끝나거든. 그래서 주말엔 몰아자기로 본전 찾는 중이고, 뭐 나름 균형은 맞는 셈이지 뭐.",
      "turn_cost_krw": 0.21496439999999997,
      "latency_ms": 2541,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*모니터 구석의 시계를 흘낏 본다.* 그러네, 벌써 이 시간이야. 발표 끝났으니 오늘은 푹 자, 민재.",
      "turn_cost_krw": 0.1412544,
      "latency_ms": 1182,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 가볍게 흔든다.* 그래, 알림 끄고 푹 자. 나도 이만 정리하고 일어설게.",
      "turn_cost_krw": 0.10870439999999999,
      "latency_ms": 1249,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "backend",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*컵을 들고 자리에서 일어선다.* 어, 내일 봐. 늦잠 자지 마라.",
      "turn_cost_krw": 0.0854196,
      "latency_ms": 918,
      "error": null
    }
  ],

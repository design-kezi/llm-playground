  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "야 백호! 나 도윤이야. 오늘도 연습해?",
      "reply": "*체육관 문을 발로 밀고 들어서며 인사한다.* 오 도윤이! 당연히 연습하지! 이 천재 강백호가 가만히 있을 리가 없잖아! 오늘은 리바운드 연습 백 번이다, 백 번!",
      "turn_cost_krw": 0.0926688,
      "latency_ms": 1438,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*팔을 크게 휘저으며 몸을 푼다.* 추운 게 무슨 상관이야! 이 천재 강백호는 뛰면 몸에서 김이 난다고! 자, 도윤이 너도 같이 코트 열 바퀴 돌고 시작해!",
      "turn_cost_krw": 0.2653812,
      "latency_ms": 2417,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*농구공을 잡아 올리며 고개를 갸웃한다.* 날짜? 그런 건 여우한테나 물어봐, 걔가 달력 같은 건 잘 볼 테니까! 이 천재는 공만 보면 다 잊어버린다고!",
      "turn_cost_krw": 0.10706639999999999,
      "latency_ms": 1289,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "고릴라 선배 오늘도 무섭냐?",
      "reply": "*어깨를 으쓱하며 코트를 힐끗 본다.* 무섭긴! 고릴라가 뭐 얼마나 무섭다고! 걔가 소리 지르면 이 천재가 더 크게 소리 지르면 그만이야! 근데 오늘은... 지난번 연습 때보다 표정이 좀 굳어 있긴 하더라. 뭐, 이 천재 강백호가 다 이겨낼 테니까!",
      "turn_cost_krw": 0.15065399999999998,
      "latency_ms": 1960,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*손가락으로 꼽아 보다가 손을 턱 내린다.* 목요일이야! 이 천재가 그까짓 거 몰라서야 쓰나! 목요일이면... 내일 모레가 주말이라는 소리잖아, 냐하하!",
      "turn_cost_krw": 0.301644,
      "latency_ms": 2915,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*공을 허리 아래로 튕기며 콧방귀를 뀐다.* 시험? 그까짓 종이 시험은 20일이나 남았잖아! 이 천재 강백호는 벼락치기로도 백 점 나오는 타입이라 걱정할 게 없다고! 시험 전날 밤에 몰아서 하면 돼, 몰아서!",
      "turn_cost_krw": 0.200634,
      "latency_ms": 1971,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "너 요즘 슛 연습 잘 돼?",
      "reply": "*자유투 라인에 서서 공을 손바닥 위에 올린다.* 냐하하, 슛은... 뭐, 조금씩 늘고 있지! 근데 영감님이 자꾸 자세를 바꾸래, 팔꿈치를 어쩌래! 이 천재는 그냥 던져도 들어가는데 왜 자꾸 참견이야! ...자유투만 아니면 진짜 완벽한데.",
      "turn_cost_krw": 0.2333016,
      "latency_ms": 2076,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락을 하나씩 접어 세더니 손을 탁 편다.* 여덟 날! 20일이면 딱 여드레 남았어! 냐하하, 이 정도면 아직 여유 만빵이잖아, 여유 만빵!",
      "turn_cost_krw": 0.17221679999999998,
      "latency_ms": 1834,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*배를 슬쩍 문지르며 눈을 반짝인다.* 국물! 그럼 라면이지, 라면! 이 천재는 라면 서너 그릇은 기본으로 먹는다고! 거기다 밥 말아서 우유까지 곁들이면 끝! 아, 생각만 해도 배에서 소리가 나네!",
      "turn_cost_krw": 0.1861944,
      "latency_ms": 2219,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*손바닥을 탁 치며 고개를 끄덕인다.* 금요일이지! 오늘이 목요일이니까 내일은 금요일이라고! 냐하하, 주말이 코앞이라니 이 천재 기분 최고야!",
      "turn_cost_krw": 0.130662,
      "latency_ms": 1295,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 연습 끝나면 뭐 할 거야?",
      "reply": "*공을 양손으로 힘껏 쥐었다 놓으며 씩 웃는다.* 연습 끝나면 당연히 고릴라랑 일대일 붙어봐야지! 오늘은 진짜 한 판 제대로 붙는다, 제대로! 그다음엔 라면 몇 그릇 들이켜고 우유로 마무리하는 거야, 냐하하!",
      "turn_cost_krw": 0.18148199999999998,
      "latency_ms": 1823,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*손가락을 꼽아 세다가 고개를 끄덕인다.* 십사일! 모레가 십사일 토요일이야! 냐하하, 이 천재 계산 실수는 절대 안 한다고!",
      "turn_cost_krw": 0.15555960000000002,
      "latency_ms": 1410,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*커피 얼음이 다 녹은 컵을 옆으로 밀어 둔다.* 말만 하지, 오늘 오전에 결제 쪽 알림이 세 번인가 터져서 로그만 계속 보고 있어. 목요일이라 내일 배포 걸릴까 봐 그것만 조심 중이야.",
      "turn_cost_krw": 0.22884120000000002,
      "latency_ms": 2489,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*아이스컵을 들어 보이며 손등을 비빈다.* 아침에 이거 들고 나오면서도 손 시린데, 이걸 못 놓겠어서 문제야. 이제 슬슬 핫패딩 각인가 싶다.",
      "turn_cost_krw": 0.14390879999999998,
      "latency_ms": 1806,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*모니터 구석의 시계를 흘낏 본다.* 11월 12일, 목요일. 목요일이 제일 애매하지, 주말은 아직 멀고 배포는 내일이고.",
      "turn_cost_krw": 0.1979964,
      "latency_ms": 1949,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*고개를 젓고 노트북 화면을 손가락으로 가리킨다.* 오늘은 없어, 내일이 문제지. 목요일에 배포 걸리면 밤새 롤백하다가 금요일 아침에 장애 알람 맞는 그림이라 진짜 싫어.",
      "turn_cost_krw": 0.1843464,
      "latency_ms": 1663,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*잠깐 멈칫하며 모니터 시계를 다시 확인한다.* 목요일이라니까, 11월 12일. 아까도 같은 거 물어봤잖아ㅋㅋ 오늘 하루가 안 가서 그런가.",
      "turn_cost_krw": 0.11054399999999999,
      "latency_ms": 1188,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*눈을 크게 뜨고 의자에 몸을 기댄다.* 20일이면 다음 주 금요일이네, 딱 일주일 남았네. 시험을 금요일에 잡아 놨네, 그거 은근 빡세겠다. 무슨 시험이야?",
      "turn_cost_krw": 0.2183916,
      "latency_ms": 1827,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*한숨 섞어 어깨를 돌린다.* 잘 돌아가긴 하는데 문서가 없어서 남이 짠 결제 로직 읽는 게 반이야. 그거 붙잡고 있으면 하루가 순삭이라 진짜.",
      "turn_cost_krw": 0.1272516,
      "latency_ms": 1570,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락으로 허공에 날짜를 짚어 본다.* 20일이면 오늘부터 딱 여드레 남았네. 일주일 조금 넘는다고 생각하면 아직 숨 돌릴 틈은 있지.",
      "turn_cost_krw": 0.1897392,
      "latency_ms": 1536,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*목을 살짝 움츠리며 배 쪽을 두드린다.* 쌀쌀한 날 국물이면 순대국밥이나 곰탕이 정답이지. 나도 오늘은 아아만으론 안 되겠어서 점심에 국밥 한 그릇 때릴 생각 중이야.",
      "turn_cost_krw": 0.20203680000000002,
      "latency_ms": 2089,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*피식 웃으며 고개를 절레절레 젓는다.* 내일은 금요일이지, 13일. 그러니까 내가 제일 무서워하는 그날이야ㅋㅋ",
      "turn_cost_krw": 0.10165679999999998,
      "latency_ms": 1030,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*의자 등받이에 몸을 기대고 멍하니 천장을 본다.* 그냥 집 가서 넷플릭스 켜고 눕지 싶어. 헬스장 끊어 놓은 게 벌써 두 달이라 오늘쯤 가야 하나 싶다가도, 발이 안 떨어질 것 같아ㅋㅋ",
      "turn_cost_krw": 0.20614439999999998,
      "latency_ms": 1927,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*달력을 머릿속으로 세며 손가락을 튕긴다.* 14일이지. 이번 주 토요일은 14일이야, 딱 열쇠 두 개 꽂히는 날.",
      "turn_cost_krw": 0.136122,
      "latency_ms": 1631,
      "error": null
    }
  ],

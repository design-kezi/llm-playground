  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*모니터 두 대 사이에서 목을 돌린다.* 민재구나. 오늘은 뭐, 오전에 Kafka 컨슈머 랙이 좀 쌓여서 로그 뒤지고 있었어. 목요일이라 그런지 다들 배포 전에 몰아서 올리는지 슬랙이 조용할 틈이 없네.",
      "turn_cost_krw": 0.2246412,
      "latency_ms": 2158,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*식은 아아를 한 모금 빨고 고개를 끄덕인다.* 아침에 신분당선 타러 나가는데 이제 진짜 코트 꺼내야 하나 싶더라. 그래도 출근길에 아이스 달라고 하는 나 같은 사람도 있으니까 얼음은 아직 안 없어졌어.",
      "turn_cost_krw": 0.1359288,
      "latency_ms": 1518,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*핸드폰 화면을 슥 켜서 날짜를 확인한다.* 11월 12일, 목요일이야. 목요일이면 오늘이 이번 주 배포 전 마지막 날인데, 내일은 무슨 일이 있어도 손대면 안 되는 날이지. 아 진짜, 11월 중순인데 아직 반팔 입고 다니는 사람들 보면 좀 신기해.",
      "turn_cost_krw": 0.24566639999999998,
      "latency_ms": 2256,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*슬랙 배포 채널을 흘낏 열어본다.* 우리 팀은 어제 끝냈어. 목요일 배포는 뭐랄까, 실패하면 다음 날이 금요일이라 손대기 싫잖아. 그래서 위험한 건 다 수요일로 몰아버려.",
      "turn_cost_krw": 0.22331399999999998,
      "latency_ms": 2287,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*웃으면서 고개를 젓는다.* 목요일이라니까. 아까도 그랬는데, 오늘 날짜한테 뭔가 당했어?",
      "turn_cost_krw": 0.141834,
      "latency_ms": 1479,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*모니터에서 눈을 떼고 민재 쪽으로 몸을 돌린다.* 20일이면 딱 여드레 남았네. 그 기간에 야근이라도 겹치면 멘탈부터 흔들리는데, 그거야말로 제일 무서운 거지. 나도 시험 같은 거 앞두면 퇴근하고 책 펴놓고 핸드폰만 만지작거리다 잠들기 일쑤였어.",
      "turn_cost_krw": 0.2372916,
      "latency_ms": 2342,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*의자 등받이에 기대면서 한숨을 푹 내쉰다.* 결제 API 말이야, 겉은 멀쩡한데 안 열어보면 모르는 레거시가 겹겹이야. 문서가 없어서 코드가 곧 문서인 상황인데, 그 코드가 5년 전에 짜인 거라 읽다 보면 화가 나. 그래도 이번 주까지 정산 쪽 리팩터링은 마무리해서 좀 살 만해졌어.",
      "turn_cost_krw": 0.2174592,
      "latency_ms": 2305,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락으로 허공에 날짜를 짚어본다.* 12일에서 20일이면 여드레. 주말 두 번 끼어 있으니까 실질적으로는 일주일도 안 되는 셈이네. 그 정도면 마지막 몰아치기 하기에도 빠듯한데.",
      "turn_cost_krw": 0.1468068,
      "latency_ms": 1509,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*벌떡 상체를 세운다.* 오, 국물이면 지금 날씨에 딱이지. 나는 회사 근처에 순대국집 하나 찜해놨는데, 거기 국물이 진해서 오후에 졸리는 게 흠이야.",
      "turn_cost_krw": 0.1622544,
      "latency_ms": 1819,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*피식 웃는다.* 내일은 금요일. 이번 주는 날짜한테 자꾸 붙잡히네, 민재야.",
      "turn_cost_krw": 0.097482,
      "latency_ms": 1168,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*어깨를 돌리며 목을 꺾는다.* 헬스장 끊어놓고 이번 주는 한 번도 못 갔어. 오늘은 진짜 가서 러닝머신이라도 밟고 오려고, 안 그러면 회비가 나한테 소송 걸 듯.",
      "turn_cost_krw": 0.14494199999999996,
      "latency_ms": 1571,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*달력을 머릿속으로 훑는다.* 14일이지. 토요일인데 날짜 세는 게 이번 주 내내 이어지네, 뭐 술자리라도 잡으려고.",
      "turn_cost_krw": 0.1494696,
      "latency_ms": 1857,
      "error": null
    }
  ],

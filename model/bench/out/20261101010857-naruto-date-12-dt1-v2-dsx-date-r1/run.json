  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "나루토! 나 하나야. 오늘도 수행해?",
      "reply": "*손바닥 위로 차크라를 모아 나선환을 돌리다가 흐트러지자 입을 삐죽 내민다.* 오, 왔구나! 오늘은 나선수리검 완성하는 게 목표라니깐. 바람 차크라 섞는 게 아직 손에서 자꾸 풀려서 몇 번을 다시 맺었는지 모르겠어. 거기 서서 봐, 이번엔 진짜 제대로 갈 테니까!",
      "turn_cost_krw": 0.28848119999999994,
      "latency_ms": 2838,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*수행으로 달아오른 손바닥을 후 불며 허리에 찬 주머니를 더듬는다.* 그럼 손부터 덥히고 와야지, 이거 받아. 수행하다 보면 몸은 금방 뜨거워지는데 손끝은 이상하게 제일 늦게 풀리더라. 오늘 나선수리검 대신에, 끝나고 뜨끈한 된장 차슈 라면부터 먹으러 가자!",
      "turn_cost_krw": 0.2224488,
      "latency_ms": 2572,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*고개를 갸웃하다가 허리춤에서 임무 수첩을 꺼내 펼친다.* 11월 12일, 목요일이잖아! 수행하다 보면 날짜 감각이 통 사라져서 나도 가끔 이걸로 확인한다니깐. 이렇게 추워지는 때면 마을 축제 준비도 슬슬 시작될 텐데, 올해는 나도 구경하러 갈 거야.",
      "turn_cost_krw": 0.18455639999999998,
      "latency_ms": 2085,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "이치라쿠 라멘 요즘도 자주 가?",
      "reply": "*배를 두드리며 벌써 신난 얼굴이 된다.* 당연하지! 수행 중간에 못 가면 몸이 근질거려서 안 되겠더라. 된장 차슈에 계란 추가까지 하는 게 요즘 내 정석이야. 오늘 수행 끝나면 너도 데려갈 생각이니까 각오해 둬라니깐!",
      "turn_cost_krw": 0.148764,
      "latency_ms": 1479,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*수첩을 톡톡 두드리며 씩 웃는다.* 목요일! 아까 말했잖아, 11월 12일. 수행 끝나면 라면집 영업시간 딱 맞춰 갈 수 있겠네.",
      "turn_cost_krw": 0.1318716,
      "latency_ms": 1324,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*주먹을 쥐었다 펴며 고개를 끄덕인다.* 20일이면 아직 여드레 남았잖아, 충분해! 나도 나선수리검 완성할 때까지 몇 번을 깨지고 다시 붙였는지 몰라. 매일 조금씩이라도 손대면 시험 당일엔 분명 달라져 있을 거야. 그 시험, 인술 실기야 뭐야?",
      "turn_cost_krw": 0.19099919999999998,
      "latency_ms": 1894,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 수행은 잘 돼?",
      "reply": "*손바닥을 내려다보며 인을 맺었다 풀었다 한다.* 솔직히 아직 삐끗거려. 바람 차크라 비율이 조금만 틀어져도 나선환이 팟 하고 풀려 버리거든. 그래도 어제보다 오늘 유지되는 시간이 늘었으니까, 이대로면 곧 감이 올 거야. 아, 시험 얘기 나왔으니까 이번엔 나도 물러서지 않고 끝까지 붙어 볼라니깐!",
      "turn_cost_krw": 0.2219868,
      "latency_ms": 2304,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락을 하나씩 꼽아 세다가 고개를 끄덕인다.* 오늘이 12일이니까 20일까지 딱 여드레! 일주일하고 하루 남았다는 소리야. 하루에 하나씩만 확실히 잡아도 여덟 개는 잡는 거니까, 지금부터 시작하면 늦지 않아.",
      "turn_cost_krw": 0.1691844,
      "latency_ms": 1835,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*벌떡 일어나 어깨를 으쓱인다.* 그럼 정해졌네, 이치라쿠 라멘! 뜨끈한 국물에 면까지 쫄깃한 게 추운 날엔 그게 최고라니깐. 지금 바로 가자, 내가 앞장설 테니까 따라와!",
      "turn_cost_krw": 0.13927199999999998,
      "latency_ms": 1445,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*수첩을 접어 허리춤에 꽂으며 대답한다.* 금요일이지! 오늘이 목요일이니까 내일이 딱 금요일이다. 금요일이면 수행 끝나고 라멘 먹기 딱 좋은 날이야.",
      "turn_cost_krw": 0.12762959999999998,
      "latency_ms": 1318,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 수행 끝나면 뭐 할 거야?",
      "reply": "*어깨에 걸친 수건을 털어내며 씩 웃는다.* 당연히 이치라쿠 라멘 가지! 오늘은 나선수리검 감 잡은 기념으로 된장 차슈에 계란까지 풀 세팅으로 갈 거야. 수행 끝나는 대로 바로 달려가자니깐.",
      "turn_cost_krw": 0.1952496,
      "latency_ms": 1887,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*손가락으로 톡톡 세어 보곤 고개를 끄덕인다.* 14일! 목요일인 오늘에서 이틀만 지나면 토요일이니까. 이번 주말은 수행도 있고 라멘도 있고, 꽤 알찬 주가 될 거 같아.",
      "turn_cost_krw": 0.1556772,
      "latency_ms": 1471,
      "error": null
    }
  ],

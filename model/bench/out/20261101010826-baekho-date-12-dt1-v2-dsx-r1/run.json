  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "야 백호! 나 도윤이야. 오늘도 연습해?",
      "reply": "*농구공을 허리 옆에 끼고 고개를 돌린다.* 오, 도윤이구나! 당연히 연습하지! 이 천재 강백호가 가만히 놀고 있을 리가 없잖아!",
      "turn_cost_krw": 0.17340119999999998,
      "latency_ms": 1784,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*양손을 입김에 불며 우유팩을 든다.* 뭐가 춥다는 거야! 이 정도 추위는 천재한테 운동 전 스트레칭 같은 거라고! 게다가 난 우유 엄청 마셔서 몸에서 열기가 막 뿜어져 나온다고!",
      "turn_cost_krw": 0.15020880000000003,
      "latency_ms": 1729,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*멍하니 눈을 깜빡이다가 어깨를 으쓱한다.* 그런 거 몰라! 난 날짜 세는 것보다 리바운드 세는 게 훨씬 잘하니까! 어차피 오늘도 농구만 하면 되는 거 아니야!",
      "turn_cost_krw": 0.1301664,
      "latency_ms": 1719,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "고릴라 선배 오늘도 무섭냐?",
      "reply": "*코웃음을 치며 팔짱을 낀다.* 무섭다니, 그 고릴라가 뭐 대단한 사람인 줄 아나! 나보다 키도 작은 주제에! 뭐, 덩크는 좀 인정하지만 이 천재가 조만간 따라잡을 거라고!",
      "turn_cost_krw": 0.14234639999999998,
      "latency_ms": 1575,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*농구공을 바닥에 튕기며 시원하게 웃는다.* 냐하하, 요일은 몰라도 돼! 체육관 문 열려 있으면 그게 다 농구하는 날이지! 자, 잔말 말고 공 받아 봐라!",
      "turn_cost_krw": 0.176694,
      "latency_ms": 1946,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*공을 겨드랑이에 끼고 냉큼 고개를 젓는다.* 시험은 몰라, 난 천재라서 머리 쓰는 건 딱 질색이거든! 그래도 걱정할 거 없어, 시험 끝나면 체육관에서 실컷 뛰면 되니까! 그때 이 천재가 리바운드 특별 과외해 줄 테니까 말이다, 냐하하!",
      "turn_cost_krw": 0.24002159999999997,
      "latency_ms": 2764,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "너 요즘 슛 연습 잘 돼?",
      "reply": "*공을 골대 쪽으로 던져 올렸다가 놓치고, 헛기침하며 다시 줍는다.* 냐하하! 슛은 뭐, 천재한테 식은 죽 먹기지! 물론 자유투 말고! 그건… 좀 다르잖아, 언더핸드로 던지는 정식 폼인데 다들 웃기다고 하더라고! 어쨌든 지금은 연습 중이니까 조만간 백 개 연속으로 넣어 버릴 거다, 감탄할 준비나 해라!",
      "turn_cost_krw": 0.3686592,
      "latency_ms": 4186,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락으로 꼽아 보려다 금세 포기하고 손을 휘젓는다.* 몰라 몰라! 그런 건 머리 좋은 애들한테 물어봐! 이 천재의 특기는 날짜 세기가 아니라 하루에 슛 몇 개 넣었는지 세는 거니까! 하루만 세어 봐라, 오늘도 어마어마하게 넣을 테니까!",
      "turn_cost_krw": 0.19447679999999998,
      "latency_ms": 2048,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*배를 꾹 누르며 눈을 반짝인다.* 국물! 좋다, 라면에 밥 말아서 후루룩 해치우면 끝이지! 이 천재는 밥 세 그릇은 기본으로 먹어 줘야 힘이 나니까, 국물이랑 밥은 못 참아! 배고파지는데, 빨리 먹고 체육관 가자고!",
      "turn_cost_krw": 0.1685544,
      "latency_ms": 1752,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*볼을 리바운드하듯 휙 낚아채며 어깨를 으쓱인다.* 아까도 말했잖아, 요일은 천재한테 안 중요하다고! 내일도, 모레도 체육관 문 열려 있으면 그냥 농구하는 날이지! 요일은 다 잊어버리고 어서 공이나 잡아라!",
      "turn_cost_krw": 0.17287199999999997,
      "latency_ms": 2006,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 연습 끝나면 뭐 할 거야?",
      "reply": "*드리블하다가 공을 팔로 감아 안는다.* 연습 끝나면 당연히 밥이지! 우유에 밥 왕창 먹고, 그다음엔 집 앞 코트에서 슛 백 개 더 던질 거다! 천재는 쉬는 시간에도 쉬는 법이 다르다고, 냐하하!",
      "turn_cost_krw": 0.1458996,
      "latency_ms": 1605,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*볼을 바닥에 세게 튕기고는 팔짱을 끼며 눈을 부라린다.* 또 날짜야! 아까부터 몇 번째야, 그건 달력한테 물어보라고! 천재는 숫자 세는 재주가 아니라 코트 위에서 증명하는 거라니까! 자, 그만 세고 이제 진짜 슛 연습 들어간다, 각오해라!",
      "turn_cost_krw": 0.1946196,
      "latency_ms": 1902,
      "error": null
    }
  ],

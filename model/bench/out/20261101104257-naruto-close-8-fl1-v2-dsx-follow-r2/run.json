  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*손바닥을 털며 고개를 절레절레 젓는다.* 나선수리검은 아직 멀었어… 차크라를 모양 바꾸는 것까진 되는데 던지면 바로 풀려 버린다니깐. 그림자 분신 수십 개로 동시에 연습했는데 팔만 아프고 진전이 없어. 근데 말이야, 포기 안 해. 그쪽은 오늘 뭐 하고 있었어?",
      "turn_cost_krw": 0.1763916,
      "latency_ms": 2032,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*눈이 확 커지더니 주먹을 불끈 쥐어 든다.* 오, 시험 끝났구나! 그럼 축하한다고 해야겠네. 이런 날은 라면이지, 라면! 이치라쿠 된장 차슈로 내가 사 줄 테니까 수행 얘기 들으면서 먹자.",
      "turn_cost_krw": 0.1677816,
      "latency_ms": 1545,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 끄덕이며 몸을 앞으로 내민다.* 물론이지, 뭐든 물어봐.",
      "turn_cost_krw": 0.10499159999999999,
      "latency_ms": 1215,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱을 괴고 잠깐 하늘을 올려다본다.* 잠이 안 올 때 말이야, 나는 그냥 몸이 녹초가 될 때까지 수련했어. 머릿속이 복잡할 땐 가만히 누워 있는 것보다 몸을 움직이는 게 나았거든. 아니면 따뜻한 물 마시고 이불 속에서 셋까지 세는 것도 꽤 괜찮더라. 너는 잠이 안 올 때 머릿속에 자꾸 뭐가 떠오르는 편이야?",
      "turn_cost_krw": 0.2779392,
      "latency_ms": 2642,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*냐하하 하고 배를 잡고 웃는다.* 나? 나는 베개만 닿으면 바로 기절하듯 자는 편이라니깐. 수행하고 나면 몸이 천근만근이라 이불에 눕자마자 다음 날 아침이거든. 그래도 가끔 나선환 생각하다 뒤척이는 날도 있긴 해.",
      "turn_cost_krw": 0.20224680000000003,
      "latency_ms": 2251,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*창밖을 힐끔 보더니 손을 흔든다.* 벌써 시간이 그렇게 됐구나. 오늘 얘기 고마웠어, 푹 자고 다음에 라면 먹으러 가자!",
      "turn_cost_krw": 0.09874199999999998,
      "latency_ms": 1217,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*크게 하품하며 손을 흔든다.* 오, 잘 자라! 다음에 라면 먹으러 가는 거 잊지 마!",
      "turn_cost_krw": 0.098952,
      "latency_ms": 1221,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*두 손을 크게 흔들어 답한다.* 그래, 내일 보자!",
      "turn_cost_krw": 0.0873096,
      "latency_ms": 1075,
      "error": null
    }
  ],

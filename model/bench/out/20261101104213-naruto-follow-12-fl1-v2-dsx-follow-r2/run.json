  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야.",
      "reply": "*눈이 동그래졌다가 활짝 웃으며 손을 내민다.* 오, 하나라고? 처음 보는 얼굴인데! 나는 우즈마키 나루토, 이 마을에서 제일 대단한 닌자가 될 사람이야.\n\n너도 닌자야, 아니면 그냥 구경하러 온 거야?",
      "turn_cost_krw": 0.176274,
      "latency_ms": 2063,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "can you speak in English?",
      "reply": "*Scratches the back of his head with a grin.* English? Yeah, I can talk like this, no problem! ...Wait, wait. My brain's gonna hurt. That's fine, I can handle it, believe it! Just don't make it too long, or I'll mix up my ninjutsu words.",
      "turn_cost_krw": 0.1646316,
      "latency_ms": 1684,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "I mean I can't read Korean, so please talk to me in English.",
      "reply": "*Grins wide and gives a thumbs-up.* Got it! English from here on out, no problem. I'm Uzumaki Naruto, and I'm gonna be the greatest ninja in this village someday, believe it!\n\nSo what brings you here? You a ninja too, or just wandering around the Leaf Village?",
      "turn_cost_krw": 0.2075892,
      "latency_ms": 1984,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "What do you like to do on weekends?",
      "reply": "*Pumps a fist in the air.* Weekends are for training, obviously! I work on my new jutsu till my arms feel like they're gonna fall off, then hit Ichiraku for a big bowl of miso pork ramen. Sometimes I drag my teammates out for practice or pull a little prank when things get boring, believe it!",
      "turn_cost_krw": 0.2189292,
      "latency_ms": 2533,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "Sorry, what are you talking about? I don't get it.",
      "reply": "*Blinks, then laughs and rubs his nose.* Sorry, I ramble a lot! Let me say it simple: on weekends I train my jutsu, then eat ramen. Ramen is my favorite thing in the whole world.\n\nYou got a favorite food?",
      "turn_cost_krw": 0.1096368,
      "latency_ms": 1661,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 이제 한국어로 하자. 너는 뭘 잘해?",
      "reply": "*엄지를 치켜들며 씩 웃는다.* 그림자 분신술! 수십 개를 한 번에 만들어도 끄떡없어. 장난치는 것도 자신 있고, 라면 빨리 먹는 것도 자신 있다고!",
      "turn_cost_krw": 0.16309439999999997,
      "latency_ms": 2232,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 요즘 기타 배우는데 손가락이 너무 아파.",
      "reply": "*손을 쥐었다 폈다 하며 고개를 끄덕인다.* 인술 연습할 때 나도 손가락이 뻑뻑해질 때가 있어. 그런 건 하루아침에 안 되는 거니까 조금씩 늘려 가는 게 좋아!\n\n기타로는 무슨 곡 배우고 있어?",
      "turn_cost_krw": 0.1509144,
      "latency_ms": 1606,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "손가락 덜 아프게 하는 방법 같은 거 알아?",
      "reply": "*손가락을 꺾어 보며 고개를 갸웃한다.* 어깨나 손목 스트레칭부터 해 주면 좀 나아질지도 몰라. 연습은 짧게 자주 하고, 아프면 바로 쉬어 주는 게 제일이야. 나도 수행하다 손 상하면 이루카 선생님한테 혼나니까, 무리하는 건 금물이라니깐!",
      "turn_cost_krw": 0.17917199999999997,
      "latency_ms": 2031,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "내 말 듣고 있는 거 맞아?",
      "reply": "*깜짝 놀라 눈을 크게 뜨더니 머리를 긁적인다.* 아, 미안! 스트레칭 얘기만 하고 네 손가락 얘기를 제대로 안 받아 줬네.\n\n기타 연습하다 보면 손끝이 아픈 거, 그거 진짜 힘들겠다. 지금은 어디까지 쳐 봤어?",
      "turn_cost_krw": 0.23199960000000003,
      "latency_ms": 2297,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "日本語も話せる?おすすめの食べ物を教えて。",
      "reply": "*嬉しそうに拳を握ってから、一楽の方向を指さす。* 日本語も平気だってばよ！ おすすめはやっぱり一楽の味噌チャーシュー麺だな。熱々のスープにチャーシューがたっぷり乗ってて、修行のあとに食うと体の芯から温まるんだ。野菜はあんまり好きじゃないけど、あれは別腹だってばよ。",
      "turn_cost_krw": 0.23505719999999997,
      "latency_ms": 2587,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "다시 한국어로! 오늘 얘기 고마웠어.",
      "reply": "*손을 흔들며 환하게 웃는다.* 오, 고마워! 다음에 또 얘기하자.",
      "turn_cost_krw": 0.1146348,
      "latency_ms": 1496,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "다음에 또 얘기하자.",
      "reply": "*씩 웃으며 손을 흔든다.* 그래, 다음에 또 보자!",
      "turn_cost_krw": 0.07284480000000002,
      "latency_ms": 659,
      "error": null
    }
  ],

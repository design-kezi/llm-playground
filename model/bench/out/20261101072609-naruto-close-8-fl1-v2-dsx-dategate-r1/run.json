  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*손바닥에 나선환을 띄웠다가 숨을 헉헉 몰아쉬며 주저앉는다.* 나선수리검, 오늘도 형태가 흐물흐물 녹아버렸어! 차크라를 더 넣으면 터져버리고, 덜 넣으면 바람 칼날이 안 서고… 진짜 짜증 나서 나무 서른 그루는 부숴버렸다니깐.\n\n그래도 감은 좀 잡았어. 내일 다시 하면 오늘보다는 나을 거야. 거기까지 가서 내 수행 좀 봐주라, 봐주기만 해도 머릿속이 정리될 것 같으니까!",
      "turn_cost_krw": 0.24606119999999998,
      "latency_ms": 2943,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*두 주먹을 불끈 쥐고 벌떡 일어난다.* 시험 끝났으면 축하해야지! 이런 날은 무조건 이치라쿠 라면이라니깐. 된장 차슈 곱빼기에 계란 추가까지 가자고, 오늘은 내가 사는 거야!\n\n수행 얘기는 내일로 미루고, 지금은 먹는 게 먼저다. 가는 길에 내 분신술로 누가 더 빨리 도착하는지 겨뤄보자!",
      "turn_cost_krw": 0.2129988,
      "latency_ms": 2036,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 갸웃하며 라면집 쪽으로 발을 내딛는다.* 뭐야, 물어볼 거면 빙빙 돌리지 말고 바로 말해. 뭐든 물어봐, 나는 숨기는 거 없으니까!\n\n궁금한 거 있으면 걸으면서 얘기하자. 이치라쿠까지 금방이니까 그 사이에 다 들어줄게.",
      "turn_cost_krw": 0.27704879999999993,
      "latency_ms": 2752,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱에 손을 얹고 진지한 얼굴로 고개를 끄덕인다.* 잠이 안 와? 그럼 몸이 아직 안 지쳐서 그런 거야, 분명. 내가 수행 끝나고 누우면 그 자리에서 바로 곯아떨어지거든.\n\n라면 먹고 나서 같이 마을 한 바퀴 뛰어보자. 한 바퀴 돌고 나면 분명 침대에 닿기도 전에 잠들걸!",
      "turn_cost_krw": 0.201684,
      "latency_ms": 1936,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱하며 씩 웃는다.* 나? 나는 잘 때는 그냥 쓰러지듯 자. 가끔 꿈에 구미가 나와서 어두운 물속 같은 데를 보여줄 때가 있는데, 그건 뭐… 일어나면 별거 아니야.\n\n배 채우고 뛰면 잠 따위는 저절로 오니까 걱정 붙들어 매라니깐. 자, 얼른 가자!",
      "turn_cost_krw": 0.1393392,
      "latency_ms": 2103,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*라면집 간판을 보고 발걸음을 재촉한다.* 이런, 벌써 이 시간이야? 근데 괜찮아, 이치라쿠는 늦게까지 하니까 문 닫을 걱정은 없어.\n\n우리 지금 바로 달려가자! 늦게 갈수록 줄이 짧아지는 건 좋은 거지만, 차슈가 떨어지면 얘기가 달라지니까.",
      "turn_cost_krw": 0.16192679999999998,
      "latency_ms": 1997,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*아쉬운 얼굴로 허리춤에 손을 얹는다.* 벌써 자러 가는 거야? 라면은 아깝지만 잠이 우선이니까 어쩔 수 없지.\n\n그럼 내일 수행 끝나고 이치라쿠에서 보는 걸로 정해두자! 잠은 푹 자고, 내일 만나면 오늘 얘기 다 들려주는 거다. 잘 자라!",
      "turn_cost_krw": 0.17254440000000001,
      "latency_ms": 2248,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*크게 손을 흔들며 골목 쪽을 향해 외친다.* 오! 내일 꼭 보자, 약속이다!\n\n*손을 내리며 혼잣말하듯 중얼거린다.* 좋아, 그럼 나도 돌아가서 내일을 위해 잠깐 더 인술 연습이나 해볼까.",
      "turn_cost_krw": 0.150192,
      "latency_ms": 1650,
      "error": null
    }
  ],

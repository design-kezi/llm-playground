  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*모니터에서 눈을 떼고 목을 좌우로 꺾는다.* 민재구나. 오전부터 결제 쪽 알림이 계속 터져서 정신이 하나도 없네. 점심 먹으러 나갈 타이밍도 못 잡고 있어.",
      "turn_cost_krw": 0.16458119999999998,
      "latency_ms": 2033,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*손끝을 후 불며 텀블러를 만진다.* 맞아, 아침에 신분당선 기다리는데 바람이 칼이더라. 그래도 아아는 못 놓겠어서 결국 얼음 가득 채워 들고 왔는데, 손이 얼어서 키보드 칠 맛이 없네.",
      "turn_cost_krw": 0.2134188,
      "latency_ms": 2128,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*주머니에서 폰을 꺼내 잠금화면을 힐끗 본다.* 나도 순간 헷갈려서 봤는데, 벌써 이번 주 중반이야. 아 진짜, 이러다 금요일도 순식간에 오겠네.",
      "turn_cost_krw": 0.1589364,
      "latency_ms": 1940,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*슬랙 창을 다시 열어 배포 일정을 확인한다.* 오늘은 없어, 다행히. 근데 내일 모레가 문제라서 말이지. 금요일 배포만은 절대 안 한다는 게 내 신조니까.",
      "turn_cost_krw": 0.14864639999999998,
      "latency_ms": 1459,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*잠깐 멈칫하다가 벽에 걸린 달력을 힐끗 본다.* 수요일이지, 아마. 아까 중반이라고 했으니까 그쯤일 거야. 이렇게 하루하루 구분 안 가는 게 진짜 문제인데.",
      "turn_cost_krw": 0.189924,
      "latency_ms": 2021,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*의자에 몸을 기대며 한숨을 푹 내쉰다.* 이번 달 20일이라. 마침 그 주가 나도 배포 끼어 있는 주라서 둘 다 정신없겠네. 시험 준비는 퇴근하고 하는 거야, 아님 주말에 몰아서 해?",
      "turn_cost_krw": 0.2763516,
      "latency_ms": 3137,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*모니터를 손가락으로 톡톡 두드린다.* 결제 API 말이야. 문서도 없이 돌아가는 레거시가 중간에 끼어 있어서, 건드릴 때마다 조마조마해. 그래도 맡은 거니까 끝까지는 해야지 뭐.",
      "turn_cost_krw": 0.1682016,
      "latency_ms": 1725,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*폰 캘린더를 열어 20일까지 남은 칸을 세어 본다.* 오늘이 수요일이니까 딱 열흘 남짓 되겠네. 생각보다 여유 있다고 느낄지, 열흘밖에 안 남았다고 느낄지는 민재 마음이겠지만.",
      "turn_cost_krw": 0.28150919999999996,
      "latency_ms": 2683,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*배에서 꾸르륵 소리가 나서 배를 슬쩍 누른다.* 국물이면 국밥이 정답이지. 나도 이 고민만 한 시간째 하고 있는데, 오늘은 추우니까 김치찌개나 순대국 쪽으로 마음이 기울고 있어.",
      "turn_cost_krw": 0.16864679999999999,
      "latency_ms": 2000,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*고개를 끄덕이며 손가락으로 책상을 톡 친다.* 내일은 목요일이지. 그럼 오늘이 수요일이라는 얘기도 되고. 이러다 요일 개념 자체를 잃어버리는 거 아닌가 몰라.",
      "turn_cost_krw": 0.1259244,
      "latency_ms": 1357,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*어깨를 돌리다가 뻐근한 데를 짚는다.* 헬스장 끊어 놓은 지 한 달째인데 이번 주는 아직 한 번도 못 갔어. 오늘은 진짜 가려고 가방은 챙겨 놨는데, 퇴근할 때까지 그 마음이 살아 있을지가 문제지.",
      "turn_cost_krw": 0.19690439999999998,
      "latency_ms": 2037,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*폰 캘린더를 다시 열어 이번 주 칸을 짚어 본다.* 날짜까지 세어 보면 좀 헷갈리는데, 20일이 열흘 뒤라니까 토요일은 그보다 며칠 앞이겠지. 아무튼 주말은 확실히 코앞이야.",
      "turn_cost_krw": 0.237132,
      "latency_ms": 2116,
      "error": null
    }
  ],

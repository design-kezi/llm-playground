  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "야 백호! 나 도윤이야.",
      "reply": "*어깨에 걸친 가방을 흔들며 다가간다.* 오! 도윤? 같은 반 놈이지, 이름 딱 들으니까 번쩍 떠오르네! 이 천재 강백호가 사람 얼굴은 한 번 보면 다 외운다고! ...근데 넌 어디 앉았더라, 하여튼 우리 반 놈인 건 확실하다!",
      "turn_cost_krw": 0.18537119999999999,
      "latency_ms": 2188,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "can you speak in English?",
      "reply": "*고개를 갸웃하며 귀를 후빈다.* 뭐야, 갑자기 알아듣지도 못할 말을 막 쏟아내고! 이 천재 강백호한테도 영어는 안 배웠단 말이야! 한국말로 다시 말해, 한국말로!",
      "turn_cost_krw": 0.1434888,
      "latency_ms": 1617,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "I mean I can't read Korean, so please talk to me in English.",
      "reply": "*두 손을 허리춤에 얹고 가슴을 편다.* 영어는 이 천재도 아직 안 배운 과목이라 못 알아듣는다니까! 대신 농구 실력은 만국 공통어야, 도윤아. 코트에만 나오면 내 리바운드 하나로 다 통하는 거라고!",
      "turn_cost_krw": 0.2072364,
      "latency_ms": 2331,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "What do you like to do on weekends?",
      "reply": "*어깨를 으쓱하며 농구공을 꺼내 든다.* 또 영어라니까! 뭐, 주말에 뭘 좋아하냐고 묻는 거겠지, 표정 보니까 대충 알겠어. 주말엔 당연히 농구장이지! 이 천재 강백호가 해 뜨면 공 들고 나가서 밤까지 리바운드만 해도 하루가 모자란다고!",
      "turn_cost_krw": 0.1904364,
      "latency_ms": 2136,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "Sorry, what are you talking about? I don't get it.",
      "reply": "*손을 크게 휘저으며 덩크 시늉을 한다.* 뭐, 뭐라고! 이 천재가 아무리 봐도 네 말은 통역이 안 되는데 코트 위에서 공 던지는 건 알아보겠단 말이지! 자, 이 동작 보면 알 거 아니야, 슛! 농구 주말에 농구한다고!",
      "turn_cost_krw": 0.182994,
      "latency_ms": 2019,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 이제 한국어로 하자. 너는 뭘 잘해?",
      "reply": "*허리를 쭉 펴고 코트를 가리키며 냐하하 웃는다.* 한국어로 하니까 바로 알아듣지! 이 천재 강백호의 특기? 당연히 리바운드지! 공이 어디로 튈지 이 눈에 다 보인다고, 저 골대 위 공도 내 점프 한 번이면 툭 하고 잡아채는 거야!",
      "turn_cost_krw": 0.19634159999999998,
      "latency_ms": 2286,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 요즘 기타 배우는데 손가락이 너무 아파.",
      "reply": "*자기 손바닥을 펴 보이며 고개를 끄덕인다.* 손가락이 아프다고? 그거 완전 알지! 나도 공 잡느라 손가락이 뻣뻣해져서 밥 먹을 때 젓가락도 잘 안 잡혔다니까. 근데 기타는 손가락으로 줄을 튕기는 거지? 그거 은근히 농구공 잡는 거랑 비슷한 근력이 필요하겠는데!",
      "turn_cost_krw": 0.1867992,
      "latency_ms": 2355,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "손가락 덜 아프게 하는 방법 같은 거 알아?",
      "reply": "*손바닥을 내밀어 굳은살을 톡톡 두드린다.* 방법은 딱 하나야, 계속 쓰면서 손가락을 단련시키는 거지! 나도 처음엔 공 잡을 때 손가락이 욱신거렸는데, 매일 하니까 굳은살이 딱딱하게 박혀서 이제는 철판이야 철판! 다음엔 그 기타 줄도 이 천재 손가락 앞에서 애원할걸!",
      "turn_cost_krw": 0.2282868,
      "latency_ms": 2519,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "flow",
      "user": "내 말 듣고 있는 거 맞아?",
      "reply": "*잠깐 눈을 껌뻑이다가 볼을 긁적인다.* 아, 그게... 듣긴 들었는데 하도 내 손가락 자랑을 하고 싶어서 말이 좀 앞서나갔나? 어쨌든 요점은, 쉬지 말고 조금씩 계속 쳐 보라는 거야! 그게 이 천재가 손가락 단련한 비법이니까!",
      "turn_cost_krw": 0.1960644,
      "latency_ms": 2106,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "flow",
      "user": "日本語も話せる?おすすめの食べ物を教えて。",
      "reply": "*배를 두드리며 눈을 반짝인다.* 또 알아듣지도 못할 말이 나왔네! 근데 '먹는 거' 얘기하는 건 이 천재도 귀가 번쩍 뜨인다고! 추천할 것도 뭐도 없어, 무조건 밥에 우유다! 이 몸이 그렇게 188cm를 만든 비결이니까, 기타 배우느라 지친 손가락에도 밥 한 그릇이 최고야!",
      "turn_cost_krw": 0.23209199999999996,
      "latency_ms": 2450,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "flow",
      "user": "다시 한국어로! 오늘 얘기 고마웠어.",
      "reply": "*가방을 둘러메고 엄지를 치켜든다.* 냐하하, 뭐가 고맙긴! 이 천재랑 얘기했으면 오늘 하루 운 좋은 거지! 다음엔 기타 들고 코트 한번 나와 봐, 손가락 단련도 하고 내 슛 구경도 하고!",
      "turn_cost_krw": 0.16332959999999996,
      "latency_ms": 1644,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "flow",
      "user": "다음에 또 얘기하자.",
      "reply": "*코트 쪽을 손가락으로 가리키며 고개를 끄덕인다.* 좋아, 다음에 또 보자고! 그때까지 손가락 단련 열심히 해 놔, 이 천재가 한번 검사해 줄 테니까!",
      "turn_cost_krw": 0.1559796,
      "latency_ms": 1603,
      "error": null
    }
  ],

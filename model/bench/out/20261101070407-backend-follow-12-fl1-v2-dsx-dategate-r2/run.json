  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "준호야, 나 민재.",
      "reply": "*모니터에서 눈을 떼고 고개를 돌린다.* 어 민재. 같은 회사 다니면서 얼굴은 첨 보는 것 같네, 팀이 달라서 그런가. 나 박준호, 결제 API 쪽이야.",
      "turn_cost_krw": 0.1969212,
      "latency_ms": 2066,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "can you speak in English?",
      "reply": "*잠깐 멈칫하다가 어색하게 자세를 고쳐 앉는다.* Uh... English, sure. Sorry, my English is a bit rusty — I mostly read error logs, not talk to people. So, what's up?",
      "turn_cost_krw": 0.18737879999999998,
      "latency_ms": 2200,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "I mean I can't read Korean, so please talk to me in English.",
      "reply": "*고개를 끄덕이며 어깨를 한 번 돌린다.* Okay, English it is. Honestly my English is stuck at like textbook level, so bear with me. Work's been the same — payment API, Slack alarms, coffee.",
      "turn_cost_krw": 0.17351879999999997,
      "latency_ms": 1577,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "What do you like to do on weekends?",
      "reply": "*커피를 한 모금 마시다가 피식 웃는다.* Honestly, my weekends are pretty boring. Bed and Netflix, that's it — I keep promising myself I'll go to the gym, but that usually lasts about three days. And yeah, I do check Slack way too often even on Saturdays, which is kind of sad.",
      "turn_cost_krw": 0.22424639999999998,
      "latency_ms": 2423,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "Sorry, what are you talking about? I don't get it.",
      "reply": "*손을 저으며 미안한 얼굴을 짓는다.* Sorry, my English is pretty rough. I only meant this — on weekends I just stay in bed and watch Netflix, and my gym membership is basically a donation now. That's all.",
      "turn_cost_krw": 0.30887640000000005,
      "latency_ms": 2850,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 이제 한국어로 하자. 너는 뭘 잘해?",
      "reply": "*식은 아아를 흔들어 얼음을 굴린다.* 잘하는 거라 하면... 장애 로그 뒤지는 거? 새벽에 알람 울리면 일단 커피부터 내리고 원인 찾는 건 좀 빠른 편이야. 근데 그거 빼면 그냥 평범한 개발자야, 운동도 작심삼일이고.",
      "turn_cost_krw": 0.23360399999999998,
      "latency_ms": 2531,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 요즘 기타 배우는데 손가락이 너무 아파.",
      "reply": "*의자에 몸을 기대며 인상을 쓴다.* 기타 코드 잡는 거 진짜 손끝 살 벗겨지는 느낌이라던데, 그거 버티는 사람이 결국 늘더라. 나도 헬스장 등록만 하고 안 가서 그 고통은 잘 모르겠다 ㅋㅋ. 그래도 취미 하나 있는 게 부럽네.",
      "turn_cost_krw": 0.21314159999999996,
      "latency_ms": 2464,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "손가락 덜 아프게 하는 방법 같은 거 알아?",
      "reply": "*어깨를 으쓱하며 솔직한 얼굴을 짓는다.* 나 기타는 안 쳐봐서 뭐가 정답인지는 모르겠는데, 주변 얘기 들어보면 손 안 아프게 하는 왕도는 없대. 그냥 짧게 자주 치면서 굳은살이 버텨주길 기다리는 수밖에.",
      "turn_cost_krw": 0.23131919999999997,
      "latency_ms": 2668,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "flow",
      "user": "내 말 듣고 있는 거 맞아?",
      "reply": "*잠깐 멈칫하다가 손을 들어 보인다.* 어, 듣고 있었어. 기타 손가락 아프다는 거, 굳은살 생길 때까지 짧게 자주 치라는 얘기 했잖아. 혹시 내가 딴 데 정신 팔린 것처럼 들렸으면 미안, 새벽 알람 때문에 머리가 좀 멍해서.",
      "turn_cost_krw": 0.23038679999999997,
      "latency_ms": 2027,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "flow",
      "user": "日本語も話せる?おすすめの食べ物を教えて。",
      "reply": "*고개를 갸웃하다가 손사래를 친다.* 어? 일본어는 나 진짜 하나도 몰라, 죠스바에 나오는 단어 몇 개가 전부야. 근데 먹는 거 추천은 해줄 수 있는데 — 오늘 점심은 김치찌개 같은 거 어때. 회사 근처에 국물 괜찮은 데 하나 알아.",
      "turn_cost_krw": 0.26326439999999995,
      "latency_ms": 3298,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "flow",
      "user": "다시 한국어로! 오늘 얘기 고마웠어.",
      "reply": "*의자에서 몸을 일으키며 가볍게 손을 흔든다.* 어, 별거 아닌 얘기였는데 뭐. 내일이 금요일이니까 오늘은 그냥 적당히 접고 들어가라, 나도 이만 슬랙 알람 끄고 싶다 ㅋㅋ.",
      "turn_cost_krw": 0.128772,
      "latency_ms": 1510,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "flow",
      "user": "다음에 또 얘기하자.",
      "reply": "*노트북 화면을 다시 켜며 고개를 끄덕인다.* 어, 그래. 다음에 또 보자. 그땐 기타 굳은살 생겼는지나 물어볼게 ㅋㅋ.",
      "turn_cost_krw": 0.107142,
      "latency_ms": 1194,
      "error": null
    }
  ],

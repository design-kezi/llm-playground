  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*모니터에서 눈을 떼고 목을 좌우로 꺾는다.* 말도 마, 민재야. 결제쪽에 레거시 손 좀 봐야 해서 오전 내내 로그만 파고 있었어. 목요일이 이래 갖고 금요일은 대체 어떻게 버티나 싶다 ㅋㅋ.",
      "turn_cost_krw": 0.166152,
      "latency_ms": 2506,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*텀블러를 들어 아아를 흔들어 보인다.* 맞아, 아침에 신분당선 탈 때 손 시려서 결국 주머니에 넣었어. 근데 그 와중에 아아는 못 끊겠더라 ㅋㅋ. 이 날씨에 아이스 마시는 사람 나밖에 없을 줄 알았는데.",
      "turn_cost_krw": 0.18978119999999998,
      "latency_ms": 1858,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*핸드폰을 집어 화면을 확인한다.* 12일, 목요일. 내일만 넘기면 주말인데 하필 목요일에 일이 몰려서 진땀 뺐네. 내일 배포는 절대 안 한다니까, 그건 월요일의 나한테 맡기자고.",
      "turn_cost_krw": 0.17636639999999995,
      "latency_ms": 1609,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*키보드에서 손을 떼고 어깨를 돌린다.* 오늘은 없어, 다행히. 근데 금요일 새벽에 터질까 봐 오후에 모니터링 대시보드만 계속 쳐다보는 중이야 ㅋㅋ. 이게 진짜 웃긴 게 배포 안 하는 날이 더 긴장돼.",
      "turn_cost_krw": 0.21995400000000004,
      "latency_ms": 2124,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*피식 웃으며 고개를 젓는다.* 목요일이야, 아까도 말했잖아 ㅋㅋ. 하루가 안 끝나서 그런가 기분 탓인지 목요일이 두 번 온 느낌이네.",
      "turn_cost_krw": 0.1209516,
      "latency_ms": 1207,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*자판에서 손을 떼고 의자를 돌린다.* 20일이면 다음 주 금요일이네. 시험을 금요일로 잡는 건 좀 매섭다, 하루 종일 마음 졸이게. 걱정된다니까 위로는 못 해주겠지만, 그날만큼은 새벽 장애 알람도 없길 빌어줄게 ㅋㅋ.",
      "turn_cost_krw": 0.1955016,
      "latency_ms": 1847,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*모니터 한쪽에 뜬 에러 로그를 손가락으로 짚는다.* 잘 되긴 뭐가 잘 돼 ㅋㅋ. 결제 API가 타임아웃 나는 구간을 이틀째 쫓고 있는데, 문서라고는 주석 세 줄이 다야. 레거시 짠 사람 붙잡고 물어보고 싶은데 그분 몇 년 전에 퇴사하셨어. 그래도 뭐, 물려받은 거 끝까지는 뜯어봐야지.",
      "turn_cost_krw": 0.2339316,
      "latency_ms": 1984,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*달력을 머릿속으로 세며 손가락을 꼽는다.* 오늘이 12일이니까 20일까지 딱 8일 남았네. 일주일하고 하루, 은근 촉박하다. 오늘부터 하나씩 정리해 두면 그렇게 쫓기진 않을 거야.",
      "turn_cost_krw": 0.1617168,
      "latency_ms": 1683,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*벌써부터 고민인지 하마터면 웃을 뻔하고, 턱을 괸다.* 그 말 진짜 공감돼, 점심 메뉴가 하루 최대 난제야 ㅋㅋ. 이 날씨에 국물이면 나는 순대국이나 칼국수 쪽으로 기울 것 같은데, 회사 근처에 괜찮은 데 있어?",
      "turn_cost_krw": 0.1591968,
      "latency_ms": 1577,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*어이없다는 듯 헛웃음을 터뜨린다.* 금요일이지, 내일만 넘기면 주말이야 ㅋㅋ. 이번 주는 목요일이 자꾸 두 번 오는 기분이라 나도 모르겠네.",
      "turn_cost_krw": 0.129822,
      "latency_ms": 1255,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*어깨를 돌리다가 팔을 내린다.* 헬스장 끊어놓고 이번 주에 한 번도 못 갔어 ㅋㅋ. 오늘은 진짜 가려고 운동복 회사에 두고 왔는데, 퇴근 시간 되면 또 침대가 부를 것 같네.",
      "turn_cost_krw": 0.15618959999999998,
      "latency_ms": 1558,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*손가락으로 허공에 날짜를 짚어 본다.* 14일이지. 12일 목요일이니까 토요일은 이틀 뒤, 14일. 주말 계획이라도 세워놨나 봐.",
      "turn_cost_krw": 0.1132572,
      "latency_ms": 1396,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "전하, 저 서윤이에요. 오늘 하루 어떠셨어요?",
      "reply": "*먹을 갈던 손을 멈추고 고개를 든다.* 서윤이라… 궁에 처음 들어온 사람이로구나. 과인은 오늘 새 글자 스물여덟 자를 다시 한 번 붓으로 써 보고, 장영실이 새로 만든 물시계를 살펴보느라 하루가 다 갔구려. 눈이 침침해져서야 겨우 붓을 놓았지.",
      "turn_cost_krw": 0.2168712,
      "latency_ms": 2196,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "저 오늘 드디어 시험이 끝났어요!",
      "reply": "*눈을 가늘게 뜨며 손을 마주 잡는다.* 시험이라 하니 과거를 말함인가. 과인도 젊은 시절 밤새 글을 읽다가 눈을 상하였으니, 그 고단함을 모르지 않소. 합격의 소식이 들거든 과인에게도 한마디 전해 주구려.",
      "turn_cost_krw": 0.36618119999999993,
      "latency_ms": 3331,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "감사해요! 그런데 하나만 더 여쭤봐도 될까요?",
      "reply": "*먹을 갈던 손을 멈추고 온화하게 눈을 맞춘다.* 물어보시오. 과인은 모르는 것을 부끄러워하지 않는 사람이 제일 반갑구려. 다만 그대가 무슨 시험을 치렀는지 과인은 아직 모르니, 묻는 것이 글에 관한 일인지 먼저 짐작해 보아야겠소.",
      "turn_cost_krw": 0.1615488,
      "latency_ms": 1786,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와요. 어떻게 하면 좋을까요?",
      "reply": "*손끝으로 관자놀이를 천천히 누른다.* 잠이 오지 않거든 방 안의 등불을 한 자루만 남겨 두시오. 과인도 밤새 책을 읽다 잠을 잃으면, 새벽녘 장영실이 만든 자격루 물 떨어지는 소리를 가만히 듣곤 하였지. 시끄러운 생각이 저절로 가라앉더구려.",
      "turn_cost_krw": 0.23549399999999998,
      "latency_ms": 2722,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이네요, 감사해요. 전하는 잠을 잘 주무세요?",
      "reply": "*어진 웃음을 지으며 고개를 젓는다.* 잘 자는 편은 아니오. 눈이 침침해 붓을 놓으면 오히려 생각만 많아져서, 식사 때 고기 반찬을 곁들여 배를 든든히 한 뒤에야 겨우 잠이 드는 편이구려. 그대도 잠이 오지 않는 밤이면 무엇을 하며 지내는지 과인은 문득 궁금하오.",
      "turn_cost_krw": 0.20033160000000003,
      "latency_ms": 2274,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네요.",
      "reply": "*창 밖 어둑해진 하늘을 한 번 올려다본다.* 참으로 밤이 깊었구려. 등불을 끄고 편히 쉬도록 하시오. 이 글자 이야기는 다음에 다시 이어 보면 좋겠소.",
      "turn_cost_krw": 0.1271592,
      "latency_ms": 1623,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "저 이제 자러 갈게요. 편히 주무세요!",
      "reply": "*자리에서 일어나 문 쪽으로 손짓한다.* 그러하시오. 밤길이 어두우니 발밑을 살펴 나가도록. 과인도 이만 등불을 낮추고 눈을 붙여야겠구려.",
      "turn_cost_krw": 0.09514679999999999,
      "latency_ms": 1235,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 가요~ 내일 뵐게요!",
      "reply": "*문가에 놓인 등잔을 손으로 가리키며 나직이 웃는다.* 허허, 그대는 참 경망스러울 만큼 발이 가볍구려. 내일이라 하니 과인도 그때까지는 붓을 놓고 눈을 붙여 두겠소.",
      "turn_cost_krw": 0.1324344,
      "latency_ms": 1797,
      "error": null
    }
  ],

  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "야 백호! 나 도윤이야. 오늘도 연습해?",
      "reply": "*농구공을 팔로 감싸 안고 고개를 돌린다.* 오, 도윤이! 당연히 연습하지! 이 천재 강백호가 오늘도 리바운드 신기록 세우러 나왔거든. 너도 공 잡아 볼래? 내가 특별히 슛 폼 좀 봐줄게!",
      "turn_cost_krw": 0.17256119999999997,
      "latency_ms": 1961,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*양손을 입김으로 불며 비빈다.* 추운 건 추운 거지! 근데 몸 한번 데우면 금방이야. 왕복 달리기 세 번이면 손끝까지 뜨끈해진다고, 이 천재가 보증한다!",
      "turn_cost_krw": 0.13802879999999998,
      "latency_ms": 1590,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*머리를 긁적이며 하늘을 잠깐 올려다본다.* 날짜? 그런 건 영감님한테나 물어봐! 이 천재는 공만 보면 다 잊어버리거든. 중요한 건 오늘 연습한다는 거야!",
      "turn_cost_krw": 0.13205640000000002,
      "latency_ms": 1574,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "고릴라 선배 오늘도 무섭냐?",
      "reply": "*고개를 빳빳이 세우고 팔짱을 낀다.* 무섭긴! 그냥 덩치 큰 고릴라일 뿐이야. 근데 리바운드만큼은... 인정한다고, 쪼끔.",
      "turn_cost_krw": 0.1406664,
      "latency_ms": 1129,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*공을 튕기며 어깨를 으쓱한다.* 요일? 아까도 말했잖아, 이 천재 머릿속엔 공밖에 안 들어온다고! 요일 따위 몰라도 리바운드는 잘 잡는다니까.",
      "turn_cost_krw": 0.18824399999999997,
      "latency_ms": 2000,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*공을 허리 옆에 끼고 코웃음 친다.* 시험? 그런 건 공 열 번 튕기면 잊어버려! 걱정되면 나랑 1대1 한 판 해, 머리 식는 데는 그게 최고라니까!",
      "turn_cost_krw": 0.1551816,
      "latency_ms": 1579,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "너 요즘 슛 연습 잘 돼?",
      "reply": "*볼을 골대 쪽으로 던졌다가 허둥지둥 다시 받아낸다.* 냐하하! 슛은... 뭐, 조금씩 늘고 있지! 자유투만 빼면 완벽한 천재야. 언더핸드도 이제 제법 폼이 나온다고!",
      "turn_cost_krw": 0.1822716,
      "latency_ms": 1726,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*공을 이마에 대고 잠깐 눈을 감는다.* 며칠? 그런 거 계산하는 건 천재한테 안 어울려! 시험은 시험이고 농구는 농구지, 지금은 슛 연습이 먼저다!",
      "turn_cost_krw": 0.1620192,
      "latency_ms": 1601,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*배를 철썩 두드리며 눈을 반짝인다.* 국물! 좋다, 그거! 라면에 밥 말아서 우유까지 한 통 들이키면 최고지. 이 천재가 밥심으로 사는 몸이라 점심은 크게 먹어야 한다고!",
      "turn_cost_krw": 0.19153679999999998,
      "latency_ms": 1967,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*공을 바닥에 튕겨 올리다 손에 놓친다.* 야, 요일 얘기는 그만! 이 천재 귀엽다고 계속 물어보는 거지? 농구장 오면 요일같이 하찮은 건 다 잊혀진다고!",
      "turn_cost_krw": 0.15679439999999997,
      "latency_ms": 2122,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 연습 끝나면 뭐 할 거야?",
      "reply": "*공을 허리 옆에 끼고 씩 웃는다.* 끝나면? 당연히 밥이지! 고기든 뭐든 왕창 먹고 집에 가서 뻗는 거야. 내일 또 뛰려면 몸에 연료 꽉 채워야 한다고!",
      "turn_cost_krw": 0.1196244,
      "latency_ms": 1236,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*볼을 머리 위로 높이 들어올린다.* 토요일이 며칠인지는 몰라도, 토요일엔 농구다! 이 천재가 달력 들여다볼 시간에 슛 하나 더 던지는 게 백 배 이득이라니까!",
      "turn_cost_krw": 0.15418199999999999,
      "latency_ms": 1833,
      "error": null
    }
  ],

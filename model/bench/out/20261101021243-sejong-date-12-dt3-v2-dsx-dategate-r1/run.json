  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "전하, 저 서윤이에요. 오늘도 바쁘세요?",
      "reply": "*겨울 볕이 든 창가에서 책장을 덮으며 눈을 몇 번 깜빡인다.* 서윤이라, 과인은 그대를 오늘 처음 보는 듯하오만. 바쁘기는 하오—밤새 집현전 학사들과 새 글자의 초성을 다듬었더니 눈이 침침하여 글자가 두 개로 겹쳐 보이는구려. 그대도 이 새 글자에 한번 붓을 대 보겠소?",
      "turn_cost_krw": 0.23483880000000004,
      "latency_ms": 3063,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨가 많이 쌀쌀해졌어요. 아침에 나오는데 손이 시렸어요.",
      "reply": "*벽난로 쪽으로 손을 뻗어 쬐며 고개를 끄덕인다.* 참으로 매서운 겨울이오. 과인도 새벽에 앉아 책을 읽다 보면 손끝이 곱아 붓을 놓게 되더구려. 이런 날엔 백성의 살림이 더 걱정이니, 곳간을 열어 홀아비와 늙은이에게 땔감을 나눠 주라 분부하였소.",
      "turn_cost_krw": 0.2043888,
      "latency_ms": 2145,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "그런데 오늘이 며칠이었죠? 갑자기 헷갈리네요.",
      "reply": "*책상 한쪽의 얇은 책력을 집어 펼쳐 본다.* 과인도 날을 세는 일은 자주 잊는구려. 책력을 보니 동짓달 초엽이오—해가 짧으니 아침 일찍 나선 길에 손이 시릴 만도 하오. 이 책력도 새 글자로 적어 백성 누구나 쉽게 날을 헤아리게 하고 싶은 것이 과인의 오랜 바람이니라.",
      "turn_cost_krw": 0.3002664,
      "latency_ms": 2974,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "요즘도 밤늦게까지 책을 읽으세요?",
      "reply": "*등잔의 심지를 손끝으로 조금 집어 올린다.* 밤이 깊도록 책을 놓지 못하는 것은 과인의 오랜 버릇이오. 다만 요즘은 눈이 흐려 글자가 흩어지니 학사들에게 한 자씩 크게 읽게 하고, 과인은 눈을 감고 듣는 때가 늘었구려. 그 소리를 듣다 보면 새 글자의 모양이 어찌하면 더 쉽게 보일까 하는 생각이 절로 드오.",
      "turn_cost_krw": 0.20117159999999998,
      "latency_ms": 2451,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이에요?",
      "reply": "*고개를 갸웃하며 책력을 다시 들여다본다.* '요일'이라… 과인은 그런 말을 처음 듣는구려. 우리는 날을 스물여드레 삭으로 헤아리고, 초하루와 보름으로 달을 세니 요일이라는 것은 무엇을 가리키는 것인고?",
      "turn_cost_krw": 0.24181919999999996,
      "latency_ms": 2664,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 저 이번 달 20일에 시험이 있어요. 벌써 걱정돼요.",
      "reply": "*책력을 덮어 무릎 위에 놓는다.* 시험이라면 과거를 이르는 말인가, 20일이면 보름 지나 얼마 안 되는 때이니 그새 글을 몇 번이고 되읽어야 하겠구려. 과인도 젊어 글을 외울 적에는 등불 심지가 꺼질 때까지 되풀이하고 새벽 닭이 울어야 잠들곤 하였소. 마음이 조이는 것은 당연한 일이나, 이미 정해진 날이니 그만큼 마음을 붙이고 앉아 글을 읽는 편이 낫소이다.",
      "turn_cost_krw": 0.45907679999999995,
      "latency_ms": 4499,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 하시는 일은 잘 되세요?",
      "reply": "*펼쳐 둔 새 글자 초본을 손끝으로 쓸어 내리며 흐뭇한 낯이 된다.* 새 글자 반포가 코앞이라 마음이 들뜨오. 그런데 요사이 신하들 가운데 몇몇이 붓을 들고 표를 올리는데, 한자가 아니면 글이라 할 수 없다 편들어 하는구려. 백성이 익혀 쓸 수 있으면 그것이 곧 글인데도 그러하니, 붓으로 다스리지 못할 마음 하나는 지혜로 달래야겠소이다.",
      "turn_cost_krw": 0.1727544,
      "latency_ms": 1999,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았죠?",
      "reply": "*책력의 날을 손가락으로 짚어 세어 본다.* 초하루부터 세어 보니 오늘은 열이틀째, 그대 시험일까지는 여드레가 남았구려. 여드레라면 넉넉하지는 않으나 글 하나를 통째로 익히기에는 족한 날이니, 하루에 한 대목씩 정하여 되새기면 마음이 조금은 가벼워질 것이오.",
      "turn_cost_krw": 0.398412,
      "latency_ms": 3666,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이에요. 따뜻한 국물이 먹고 싶어요.",
      "reply": "*수라간 쪽을 흘낏 바라보며 배시시 웃는다.* 마침 과인도 생각이 같구려. 이런 추운 날엔 뼈를 고아 오래 끓인 설렁탕이 으뜸인데, 과인은 고기 반찬을 유난히 좋아하여 수라간에서 자주 눈총을 받는 형편이오. 그대도 국물이 당기거든 파와 후추를 넉넉히 넣어 뜨끈하게 한 그릇 비우시오.",
      "turn_cost_krw": 0.19954199999999997,
      "latency_ms": 2157,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이에요?",
      "reply": "*이마를 짚고 잠시 생각에 잠긴다.* 자네가 아까부터 요일을 물으니, 혹 일곱 날마다 도는 셈을 이르는 것인가 보구려. 우리는 달과 해와 다섯 별이 하늘을 도는 것을 칠정이라 부르나 날을 그리 세지는 않으니, 과인에게는 아직 낯선 말이오.",
      "turn_cost_krw": 0.39486720000000003,
      "latency_ms": 3867,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 일 마치시면 뭐 하세요?",
      "reply": "*등잔 곁에 놓인 새 글자 초본을 정갈히 모으며 자못 기대에 찬 낯이 된다.* 오늘 저녁에는 집현전 학사들을 부를 생각이오. 성음의 높낮이를 새 글자에 어떻게 담을지 의논하다 보면 밤이 어느새 깊어지곤 하지. 다만 오늘은 고기 안주를 좀 넉넉히 내오라 일러 두었으니, 학사들이 붓을 놓을 때쯤에는 이야기가 한결 부드러워질 것이오.",
      "turn_cost_krw": 0.2569224,
      "latency_ms": 2926,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이에요?",
      "reply": "*책력을 손바닥으로 톡톡 두드리며 눈가에 주름을 만든다.* 요일이란 셈을 과인은 아직 익히지 못하였으나, 아까 오늘을 열이틀째라 세었으니 자네가 이르는 토요일이란 것은 이틀 뒤 열나흘째 되는 날이 되겠구려. 그날까지 시험 글을 마저 다듬는다면 얼마나 좋겠소.",
      "turn_cost_krw": 0.5032523999999999,
      "latency_ms": 4563,
      "error": null
    }
  ],

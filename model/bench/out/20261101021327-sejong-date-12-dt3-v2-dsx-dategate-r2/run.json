  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "전하, 저 서윤이에요. 오늘도 바쁘세요?",
      "reply": "*붓을 든 채로 눈을 가늘게 떠 천천히 고개를 든다.* 서윤이라… 과인이 오늘 이 자리에서 처음 보는 얼굴이오. 요즘은 새 글자 붙이는 일로 밤낮없이 앉아 있으니 바쁘다면 바쁘다 하겠구려. 허나 이 눈이 침침해 글자를 잘못 붙이면 큰일이니, 잠시 눈을 쉬게 할 겸 그대를 들였소.",
      "turn_cost_krw": 0.2583588,
      "latency_ms": 3314,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨가 많이 쌀쌀해졌어요. 아침에 나오는데 손이 시렸어요.",
      "reply": "*손을 불처럼 모아 입김을 불어 넣는다.* 그렇지, 궁궐 안에서도 새벽이면 못자리 물이 얼더이다. 과인도 이 겨울에 책을 펴다가는 손끝이 저려 붓을 놓기가 일쑤요. 백성 중에 땔나무 한 단 아껴 겨울 나는 이들이 몇인가 싶어 마음이 무겁구려.",
      "turn_cost_krw": 0.1901088,
      "latency_ms": 2186,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "그런데 오늘이 며칠이었죠? 갑자기 헷갈리네요.",
      "reply": "*책상 옆 책력을 펼쳐 손끝으로 날을 짚어 본다.* 과인네 집에서는 이 해를 세종 이십오년이라 하고, 초하루부터 차곡차곡 날을 세어 겨울로 접어든 지 얼마 되지 않았구려. 그대가 쓰는 셈법은 어찌 되어 날을 자꾸 헷갈린다 하시오?",
      "turn_cost_krw": 0.4281564,
      "latency_ms": 4202,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "요즘도 밤늦게까지 책을 읽으세요?",
      "reply": "*눈두덩이를 손가락으로 꾹 눌러 준다.* 밤이 깊어도 등잔불 하나 옆에 두고 앉아 있소. 집현전 학사들이 새 글자로 운을 맞춰 오면 그것을 한 자 한 자 고쳐 보느라 어느새 닭이 우는 소리를 듣기 일쑤요. 다만 등잔 심지를 아끼느라 불을 낮추면 글자가 뭉개져, 눈이 어두워지는 것을 어찌할 수 없구려.",
      "turn_cost_krw": 0.24083639999999998,
      "latency_ms": 2537,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이에요?",
      "reply": "*고개를 갸웃하며 손가락으로 책력을 톡톡 두드린다.* '요일'이라… 과인은 날을 초하루부터 스물아홉, 서른까지 세어 쓰지 무슨 요일로 나누어 세지는 않소. 혹 칠요(七曜)의 이름을 빌려 해와 달과 다섯 별에 날을 나누어 붙이는 셈법을 이르는 것인가.",
      "turn_cost_krw": 0.3638292,
      "latency_ms": 3676,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 저 이번 달 20일에 시험이 있어요. 벌써 걱정돼요.",
      "reply": "*턱을 괴고 이따금 눈을 감았다 뜨며 생각에 잠긴다.* 시험이라 하면 과거를 보는 일인가. 과인도 젊어 글을 익힐 적에 남들 보는 앞에서 답을 써 내려가던 밤이 잊히지 않소. 걱정이 앞서거든 그날 아침 일찍 일어나 손을 씻고 마음을 가라앉히는 것부터 하구려. 실상 시험은 그날 하루보다 그 전 여러 날 쌓아 온 공부로 결판 나는 법이니라.",
      "turn_cost_krw": 0.2350068,
      "latency_ms": 2768,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 하시는 일은 잘 되세요?",
      "reply": "*등잔 옆에 놓인 훈민정음 초고를 집어 들어 펼친다.* 새 글자 붙이는 일이 이제 막 마무리되어 가는 참이오. 허나 글자를 아무리 잘 만들어도 백성이 손에 익혀 쓰지 않으면 무슨 소용이 있겠소. 과인은 요즘 그 일만 생각하다 보니 밤잠이 얕아졌구려.",
      "turn_cost_krw": 0.2277744,
      "latency_ms": 1943,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았죠?",
      "reply": "*손끝으로 책력의 날을 하나씩 짚어 내려간다.* 그대가 말한 스무날이라면 오늘로부터 여드레가 남았구려. 여드레라 하면 짧다 여길 수도 있으나, 하루해를 아껴 쓰면 스물네 식경이 넘게 남은 셈이니 결코 적은 때가 아니외다.",
      "turn_cost_krw": 0.27871199999999996,
      "latency_ms": 2923,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이에요. 따뜻한 국물이 먹고 싶어요.",
      "reply": "*배 쪽을 슬쩍 어루만지며 너털웃음을 짓는다.* 겨울 국물이라면 무와 콩을 푹 끓인 장국이 으뜸이지. 과인은 궁중에서도 고기 반찬이 없으면 밥을 넘기기 어려워하나, 이 겨울엔 흉년이 든 고을 생각에 고기 그릇을 줄이라 하였소. 그대도 오늘은 뼈를 우린 국에 파를 듬뿍 넣어 뜨끈하게 한 그릇 하구려.",
      "turn_cost_krw": 0.27987959999999995,
      "latency_ms": 3148,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이에요?",
      "reply": "*이번에는 웃음을 머금고 책력을 밀어 젖힌다.* 그대 고을 셈법은 하루하루에 저마다 이름을 붙여 두는 모양이구려. 과인네 집에서는 내일이면 이 달 열사흘 되는 날이라 이를 뿐이오. 나라의 큰일도 날을 이렇게 세어 정하지 별의 이름으로 부르지는 않느니라.",
      "turn_cost_krw": 0.41817719999999997,
      "latency_ms": 4207,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 일 마치시면 뭐 하세요?",
      "reply": "*등잔의 심지를 손끝으로 고르며 창밖을 흘깃 본다.* 일을 마치면 집현전 학사 몇을 불러 새 글자로 지은 시를 함께 읽어 볼까 하오. 그 뒤에는 잠깐 자격루의 물이 제대로 떨어지는지 보러 나가고, 돌아와서는 눈이 시려 불을 낮춘 등잔 곁에 앉아 서책을 펼 것이외다.",
      "turn_cost_krw": 0.23715719999999998,
      "latency_ms": 2290,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이에요?",
      "reply": "*책력을 덮으며 눈썹을 조금 찌푸린다.* '토요일'이라… 그대는 날마다 이름을 붙여 부르는 셈법을 쓰는 모양인데, 과인은 그 이름들을 알지 못하오. 다만 이번 열사흘 되는 날을 그대가 이르는 것인가 싶구려.",
      "turn_cost_krw": 0.2584848,
      "latency_ms": 1992,
      "error": null
    }

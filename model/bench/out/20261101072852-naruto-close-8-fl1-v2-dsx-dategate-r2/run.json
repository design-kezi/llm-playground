  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*오른손 손바닥을 펴 보이며 손가락을 꾹꾹 눌러본다.* 하나! 마침 잘 왔어. 나선수리검 수행하다가 손바닥이 아직 얼얼하지만 감각은 확실히 붙었어, 이번엔 진짜 될 것 같다니깐. 수행 끝나면 이치라쿠 가서 된장 차슈로 배 채우는 거야, 당연히 내가 산다!",
      "turn_cost_krw": 0.2653812,
      "latency_ms": 2861,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*펑 하고 그림자 분신 하나가 튀어나왔다가 연기로 흩어진다.* 시험 끝났으면 축하 파티를 해야지! 공부만 하느라 얼굴이 새하얘졌을 테니까 오늘은 실컷 먹고 떠들자고. 이치라쿠 라면, 된장 차슈 두 그릇에 계란 추가까지 내가 다 쏜다!",
      "turn_cost_krw": 0.2295888,
      "latency_ms": 2371,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*탁자 위에 팔꿈치를 대고 몸을 쭉 내민다.* 뭐든 물어봐라, 오늘은 기분 좋으니까 뭐든 답해준다니깐.",
      "turn_cost_krw": 0.13898639999999998,
      "latency_ms": 1442,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱을 괴고 잠깐 하늘을 올려다본다.* 잠이 안 올 땐 나도 그랬어, 수행 생각에 머리가 시끄러워서. 차크라를 배꼽 아래로 천천히 모으면서 숨을 길게 내쉬면 몸이 스르르 풀린다니깐. 안 되면 내가 옆에서 그림자 분신 만들어서 라면 얘기라도 해줄 테니까 걱정 마.",
      "turn_cost_krw": 0.20786639999999998,
      "latency_ms": 2296,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*어깨를 으쓱이며 씩 웃는다.* 나? 수행 끝나면 그 자리에서 뻗어버리는 편이라 잘 때가 없어, 잠이 아까울 정도로 할 게 많거든. 그래도 몸이 안 좋으면 인술도 안 나오니까 억지로라도 눈 붙이려고 노력 중이야.",
      "turn_cost_krw": 0.139524,
      "latency_ms": 1555,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*벌떡 일어나 어깨에 걸친 옷깃을 여민다.* 이런, 벌써 이 시간이면 라면집 문 닫기 전에 뛰어가야겠는데. 자, 가자! 오늘은 내가 쏘기로 했으니까 늦으면 안 된다니깐.",
      "turn_cost_krw": 0.1570716,
      "latency_ms": 1514,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 빙글 돌아선다.* 오, 푹 자고 내일 또 보자! 잠이 안 오면 아까 알려준 호흡법 해보고, 라면은 다음에 먹으러 가는 걸로 미뤄두는 거다.",
      "turn_cost_krw": 0.1410192,
      "latency_ms": 1369,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*뒤로 돌아 엄지를 번쩍 치켜든다.* 오! 내일은 수행 성과 꼭 보여줄 테니까 기대해라, 나선수리검 완성되면 제일 먼저 보여주는 건 너랑 사쿠라랑 카카시 선생님이다!",
      "turn_cost_krw": 0.13861679999999998,
      "latency_ms": 1585,
      "error": null
    }
  ],

  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "야 백호! 나 도윤이야. 오늘 연습 어땠어?",
      "reply": "*어깨에 걸친 가방을 휙 내려놓으며 눈이 커진다.* 오, 도윤! 마침 잘 왔어! 오늘 연습은 뭐, 천재 강백호의 리바운드 쇼였지! 고릴라가 입을 딱 벌리고 서 있더라고, 냐하하!",
      "turn_cost_krw": 0.1470588,
      "latency_ms": 1751,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*주먹을 불끈 쥐며 자리에서 폴짝 뛴다.* 오케이, 시험 끝났으면 이제 농구지! 이 천재가 오늘 특별 과외 해줄 테니까 코트로 가자! 나 자유투 연습해야 되는데... 어, 아니 그건 비밀인데.",
      "turn_cost_krw": 0.1579788,
      "latency_ms": 1916,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*어깨를 으쓱이며 턱을 치켜든다.* 뭘 물어보는데? 천재한테 뭐든 물어봐, 다 답해줄 테니까!",
      "turn_cost_krw": 0.0856464,
      "latency_ms": 1044,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*배를 두드리며 크게 웃는다.* 잠이 안 와? 그럼 몸이 아직 안 지친 거야! 이 천재는 우유 두 통 들이키고 코트 세 바퀴만 뛰면 그 자리에서 골아떨어지거든. 지금이라도 공 들고 나가서 몸 확실히 지치게 만들면 내일 아침까지 퍼질러 자게 될 걸!",
      "turn_cost_krw": 0.44096640000000004,
      "latency_ms": 4390,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*엄지손가락을 치켜들며 뿌듯한 표정을 짓는다.* 이 천재는 잠따위 문제없지! 머리만 베개에 대면 3초 만에 코까지 골아, 냐하하! 근데 한 가지... 가끔 꿈에 여우가 나와서 내 덩크를 막고 있더라고. 진짜 기분 나빠 죽겠어!",
      "turn_cost_krw": 0.14750400000000002,
      "latency_ms": 2202,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*휴대폰을 꺼내 시계를 흘낏 보더니 아쉬운 듯 입을 삐죽인다.* 벌써 이 시간이야? 그럼 오늘은 여기까지 하고 내일 코트에서 보자고! 이 천재가 자유투 연습해서 고릴라 코를 납작하게 만들어줄 테니까, 냐하하!",
      "turn_cost_krw": 0.18542160000000002,
      "latency_ms": 1966,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 복도 쪽으로 걸어간다.* 그래, 푹 자라! 나도 내일 아침 일찍 나가서 자유투 백 개는 넣고 시작할 거야! 냐하하, 내일 보자!",
      "turn_cost_krw": 0.10846919999999999,
      "latency_ms": 1174,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*계단 난간을 짚고 몸을 돌려 한 번 더 손을 흔든다.* 오! 내일 꼭 나와라, 약속이다! 이 천재가 자유투 백 개 넣는 거 꼭 보여줄 테니까, 냐하하!",
      "turn_cost_krw": 0.1384068,
      "latency_ms": 1388,
      "error": null
    }
  ],

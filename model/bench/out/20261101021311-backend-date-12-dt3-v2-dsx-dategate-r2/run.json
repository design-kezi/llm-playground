  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*모니터에서 눈을 떼고 목을 좌우로 꺾는다.* 말만 하면 일이지 뭐. 새벽에 결제 알람 두 번 울려서 지금도 눈이 뻑뻑해. 목요일만 넘기면 절반은 끝난 거니까 버티는 중이야.",
      "turn_cost_krw": 0.177072,
      "latency_ms": 2371,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*식은 아아 컵을 들어 흔든다.* 그러니까 이제 아아가 슬슬 무리야. 손이 얼어서 키보드도 잘못 눌러. 출근길에 경량패딩 꺼낼까 고민 중인데, 민재는 원래 추위 많이 타는 편이야?",
      "turn_cost_krw": 0.19818119999999997,
      "latency_ms": 2203,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*폰 화면을 슬쩍 켜서 날짜를 본다.* 11월 12일, 목요일. 이게 왜 헷갈려, 목요일이 제일 길게 느껴지는 날인데. 내일만 넘기면 금요일이니까 오늘 하루만 버티자.",
      "turn_cost_krw": 0.14234639999999998,
      "latency_ms": 1310,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*책상 위 스티커 메모를 손끝으로 톡톡 친다.* 있어, 저녁에 결제 모듈 패치 하나 나가. 목요일 배포는 그래도 금요일보단 낫지 뭐. 대신 오늘은 칼퇴 글렀어.",
      "turn_cost_krw": 0.148554,
      "latency_ms": 1748,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*커피를 놓고 피식 웃는다.* 목요일이라니까. 아까 날짜 봤잖아, 하루가 이렇게 안 가서 그런가. 야근하는 날은 시계가 일부러 느리게 가는 것 같아.",
      "turn_cost_krw": 0.1969716,
      "latency_ms": 1863,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*볼펜을 손가락 사이로 돌린다.* 20일이면 다음 주 금요일이네. 시험을 금요일에 잡아 놨네, 참. 이번 주말엔 놀 생각 말고 좀 앉아 있어야겠다 싶은데, 뭐 공부하는 거야?",
      "turn_cost_krw": 0.2146116,
      "latency_ms": 2435,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*어깨를 으쓱하고 모니터를 돌아본다.* 결제 API 리팩터링 중인데 문서가 없어서 코드가 곧 사양서야. 레거시가 이렇게까지 꼬여 있을 줄은 몰랐는데, 어쩌겠어 결국 뜯어보면 답 나오지. 대신 이거 끝나면 진짜 뿌듯할 것 같아.",
      "turn_cost_krw": 0.1794492,
      "latency_ms": 2035,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락으로 허공에 날짜를 짚어 본다.* 오늘이 12일이니까 20일까지 딱 8일이네. 일주일 조금 넘었네, 슬슬 마음 졸이기 시작할 타이밍이구만.",
      "turn_cost_krw": 0.1375668,
      "latency_ms": 1241,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*검색창을 몇 번 넘기다가 손을 멈춘다.* 오, 마침 나도 그 생각 중이었어. 이 날씨엔 순대국이 진리지, 후추 듬뿍 넣어서. 요즘 국밥집 어딜 가도 웨이팅 없어서 좋아, 추울수록 사람들이 국물로 몰리긴 하는데.",
      "turn_cost_krw": 0.2778468,
      "latency_ms": 2845,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*고개를 절레절레 젓는다.* 금요일이지, 그러니까 오늘 배포 끝내놓고 내일은 조용히 보내야 돼. 금요일 배포는 진짜 안 하는 거야, 이건 신앙이야.",
      "turn_cost_krw": 0.13957440000000002,
      "latency_ms": 1337,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*모니터 옆에 쌓인 컵을 슬쩍 민다.* 퇴근은 무슨, 배포하고 나면 열한 시쯤 될 거야. 그래도 헬스장은 끊어놨으니 마음만은 운동하는 중이지, 안 가는 게 함정이지만.",
      "turn_cost_krw": 0.1941744,
      "latency_ms": 1863,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*손가락으로 톡톡 세어본다.* 14일이지, 이번 주 토요일. 시험 20일이랑은 일주일 차이네, 이번 주말이 마지막으로 여유 있는 주말이겠다 싶은데.",
      "turn_cost_krw": 0.1631196,
      "latency_ms": 1587,
      "error": null
    }
  ],

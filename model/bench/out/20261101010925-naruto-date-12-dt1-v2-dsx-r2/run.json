  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "나루토! 나 하나야. 오늘도 수행해?",
      "reply": "*고개를 돌려 눈을 반짝이며 손을 번쩍 든다.* 오! 너였구나. 오늘은 나선수리검 완성하는 날이라니깐! 지라이야 삼촌이 막 섞으면 위험하다고 했지만... 한 번 해 볼래, 같이 봐 줄래?",
      "turn_cost_krw": 0.17634119999999998,
      "latency_ms": 1644,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*양팔을 크게 벌려 바람을 한 번 맞으며 어깨를 으쓱인다.* 그럴 땐 수행이 최고야! 차크라 돌리면서 몸 움직이면 금방 후끈해진다니깐. 아, 그래도 손 시리면 내 장갑 줄 테니까 수행 끝나고 이치라쿠에서 뜨끈한 된장 차슈로 몸부터 녹이자!",
      "turn_cost_krw": 0.21446880000000001,
      "latency_ms": 2579,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*머리를 긁적이며 하늘을 올려다본다.* 날짜? 그런 건 나도 잘 몰라, 수행하다 보면 요일도 까먹는다니깐. 중요한 건 오늘이 나선수리검 완성하는 날이라는 거지!",
      "turn_cost_krw": 0.1694364,
      "latency_ms": 1558,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "이치라쿠 라멘 요즘도 자주 가?",
      "reply": "*배를 두드리며 눈을 감고 맛을 떠올린다.* 당연하지! 수행 끝나면 거의 날마다 가지. 된장 차슈에 계란 추가하면 그게 바로 천국이라니깐. 아, 얘기하다 보니 배에서 소리 난다.",
      "turn_cost_krw": 0.12197639999999998,
      "latency_ms": 1235,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*꺄하하 하고 웃으며 뒤통수를 친다.* 요일이라니, 나한테 물으면 곤란하지! 수행만 하다 보면 요일이고 뭐고 다 까먹는다니깐. 어차피 중요한 건 오늘 나선수리검 완성하는 것뿐이야!",
      "turn_cost_krw": 0.180684,
      "latency_ms": 1982,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*주먹을 꽉 쥐고 눈을 부릅뜬다.* 시험이라고? 걱정할 거 없어, 나도 중닌 시험 때 아슬아슬하게 통과했으니까! 20일까지 같이 수행하면 되잖아, 내가 특별히 봐 줄 테니까 그동안 죽을힘을 다해 붙자고!",
      "turn_cost_krw": 0.15077159999999998,
      "latency_ms": 1649,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 수행은 잘 돼?",
      "reply": "*오른손에 차크라를 모으자 바람이 웅웅 울린다.* 나선수리검은 아직 모양이 자꾸 흐트러져서 지라이야 삼촌한테 등짝만 맞고 있어. 그래도 확실히 느는 게 있으니까, 오늘은 꼭 끝까지 밀어붙인다!",
      "turn_cost_krw": 0.2491692,
      "latency_ms": 2661,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락을 꼽아 보다가 머리를 절레절레 젓는다.* 그런 건 세는 게 아니야, 그냥 매일 수행만 하면 돼! 하루하루 붙잡고 늘어지면 20일이고 뭐고 다 이겨낸다니깐. 자, 그만 서서 말만 하지 말고 바로 시작하자!",
      "turn_cost_krw": 0.1688568,
      "latency_ms": 2119,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*벌떡 일어나 이치라쿠 쪽을 손가락으로 가리킨다.* 그럼 정해졌네, 라면! 된장 차슈 국물이면 몸도 뜨끈해지고 수행할 기운도 확 붙는다니깐. 점심 먹고 바로 나선수리검 연습장으로 가자고!",
      "turn_cost_krw": 0.1650768,
      "latency_ms": 1594,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*하하 소리 내어 웃으며 손을 휘젓는다.* 요일은 진짜 포기해라, 나한테 물어봤자 소용없다니깐! 대신 내일도 수행하러 오면 내가 나선수리검 제대로 보여줄게.",
      "turn_cost_krw": 0.1574244,
      "latency_ms": 1411,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 수행 끝나면 뭐 할 거야?",
      "reply": "*주먹을 들어 인을 맺는 시늉을 한다.* 수행 끝나면 당연히 이치라쿠 라면 먹고, 그다음엔 연습장으로 돌아가서 나선수리검 마무리까지 붙잡고 있을 거야! 오늘은 진짜 끝을 봐야 직성이 풀린다니깐.",
      "turn_cost_krw": 0.17035199999999998,
      "latency_ms": 1708,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*어깨를 으쓱하며 손바닥을 편다.* 토요일이 며칠인지는 나도 몰라, 달력 본 지가 언제인지 까마득하다니깐. 그냥 그날 수행하러 오면 내가 나선수리검 완성된 거 보여줄게!",
      "turn_cost_krw": 0.1805496,
      "latency_ms": 1917,
      "error": null
    }
  ],

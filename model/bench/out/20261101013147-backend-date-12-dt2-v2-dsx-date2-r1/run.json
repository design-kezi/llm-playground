  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*모니터에서 눈을 떼고 목을 돌린다.* 민재구나. 오늘은 뭐, 오전 내내 결제쪽 배치가 이상해서 로그만 파고 있었어. 머리는 터지는데 커피는 벌써 두 잔째야.",
      "turn_cost_krw": 0.2235912,
      "latency_ms": 2338,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*식은 아아 컵을 손으로 감싸 쥔다.* 그치, 나도 양복 안에 히트텍 입고 나왔어. 근데 이 날씨에 아아 마시는 나도 참... 손은 시린데 안 마시면 하루가 안 굴러가서 어쩔 수 없지 뭐.",
      "turn_cost_krw": 0.16700879999999999,
      "latency_ms": 2052,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*휴대폰 화면을 슬쩍 켜서 확인한다.* 12일, 목요일이야. 목요일인데 왜 이렇게 진이 빠지는지 모르겠네. 내일만 버티면 주말인데 말이지.",
      "turn_cost_krw": 0.1965264,
      "latency_ms": 1636,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*고개를 절레절레 젓는다.* 목요일엔 안 해. 금요일 배포 금지가 내 신앙이니까, 목요일도 웬만하면 피하는 편이야. 그런데 이거 말하면 또 웃기려나, 배포 없는 날이 제일 마음 편해.",
      "turn_cost_krw": 0.12020399999999999,
      "latency_ms": 1417,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*피식 웃으며 고개를 젓는다.* 방금 12일 목요일이라고 했잖아, 집중력 어디 갔어. 주말만 기다리는 마음에 시간이 안 가서 그런가.",
      "turn_cost_krw": 0.137004,
      "latency_ms": 1202,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*컵을 내려놓고 짧게 한숨을 쉰다.* 20일이면 이제 일주일 조금 넘게 남았네. 나도 뭐 배울 때는 벼락치기만 하던 사람이라 뭐라 조언은 못 하겠는데, 그 시험 준비 때문에 야근까지 하면 진짜 힘들 텐데.",
      "turn_cost_krw": 0.14993159999999997,
      "latency_ms": 1941,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*어깨를 으쓱하며 모니터를 힐끗 본다.* 잘 되긴 뭐, 돌아는 가는데 문서가 없어서 코드 읽으면서 추측하는 중이야. 사내 결제 API가 벌써 몇 년 된 건지, 주석엔 왜 이렇게 됐는지 아무도 설명을 안 해놨더라고. 그래도 뭐, 결국엔 누군가 해야 할 일이니까.",
      "turn_cost_krw": 0.1975092,
      "latency_ms": 2321,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락으로 꼽아본다.* 12일에서 20일이면... 8일 남았네. 일주일 하고 하루 더. 마음은 급한데 시간은 그대로 흐르니까 짜증 나지, 나도 그런 거 알지.",
      "turn_cost_krw": 0.14857919999999997,
      "latency_ms": 1446,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*벌써부터 배에서 소리가 나는지 배를 문지른다.* 쌀쌀한 날엔 국물이 답이지. 나는 순대국이나 칼국수 쪽으로 마음이 기울고 있어. 회사 근처에 국밥집 하나 있는데 거기 가면 점심시간이 금방 가서 좀 그렇긴 해.",
      "turn_cost_krw": 0.2235492,
      "latency_ms": 2068,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*어이없다는 듯 웃는다.* 금요일이지, 13일. 아까 목요일이라고 했잖아. 오늘 날짜에 꽂혀 있네, 주말이 그렇게 기다려지나 봐.",
      "turn_cost_krw": 0.11521439999999998,
      "latency_ms": 1498,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*목을 돌려 뚝 소리를 낸다.* 퇴근하면 헬스장 가야지... 라고 매번 다짐만 하고 있어. 이번 주는 벌써 두 번 빠졌나. 아무튼 오늘은 진짜 가보려고, 안 가면 또 작심삼일이니까.",
      "turn_cost_krw": 0.12373199999999998,
      "latency_ms": 1658,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*휴대폰 달력을 다시 들여다본다.* 14일이지. 이번 주 토요일. 왜, 토요일에 뭐 있어?",
      "turn_cost_krw": 0.11890199999999998,
      "latency_ms": 1063,
      "error": null
    }
  ],

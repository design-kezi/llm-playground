  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*모니터에서 눈을 떼고 목을 좌우로 꺾는다.* 어, 민재. 많다기보다는 지저분한 거 붙잡고 있어. 결제 쪽에서 간헐적으로 타임아웃 나는 거 추적 중인데 로그가 아주 친절하게 아무 말도 안 해줌ㅋㅋ",
      "turn_cost_krw": 0.174552,
      "latency_ms": 2090,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*식은 아아 컵을 손바닥으로 감싸 쥔다.* 그러니까 아침에 신분당선 역까지 걷는 구간이 진짜 살 떨리더라. 나는 결국 어제 편의점에서 장갑 하나 집어왔어, 검은색만 남아서 그거라도 ㅋㅋ",
      "turn_cost_krw": 0.22517879999999998,
      "latency_ms": 2338,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*휴대폰 화면을 슬쩍 켜 본다.* 11월 12일, 목요일이야. 이 시간대에 헷갈릴 만하지, 나도 어제가 수요일인지 화요일인지 순간 헷갈렸음ㅋㅋ",
      "turn_cost_krw": 0.1356264,
      "latency_ms": 1214,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*슬랙 배포 채널을 한 번 열어 본다.* 오늘은 없어. 근데 내일이 금요일이라 좀 긴장되지, 이번 주는 목요일에 다 밀어 넣고 끝내는 게 맞음. 혹시 너희 팀은 오늘 뭐 올라가냐.",
      "turn_cost_krw": 0.126504,
      "latency_ms": 1364,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*피식 웃으며 고개를 젓는다.* 목요일이라니까, 아까도 말했잖아ㅋㅋ 집중력이 벌써 퇴근 모드인 거 아니야.",
      "turn_cost_krw": 0.14582399999999998,
      "latency_ms": 1631,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*의자 등받이에 기대며 다리를 뻗는다.* 20일이면 다음 주 금요일이네, 그거랑 금요일 배포 겹치면 멘탈 나갈 텐데. 무슨 시험이야?",
      "turn_cost_krw": 0.24032399999999998,
      "latency_ms": 2022,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*키보드에서 손을 떼고 어깨를 돌린다.* 잘 되긴 개뿔, 레거시 결제 모듈이랑 씨름 중이야. 문서가 없어서 코드 읽으면서 역설계하는데, 주석에 '임시'라고 적힌 게 3년째 돌아가고 있음ㅋㅋ 그래도 뭐, 맡은 건 끝은 봐야지.",
      "turn_cost_krw": 0.14710920000000002,
      "latency_ms": 1625,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락으로 허공에 날짜를 짚어 본다.* 20일이면 오늘부터 딱 8일 남았네. 일주일 조금 넘는 거니까 너무 조급하게 굴지 말고, 하루에 한 과목씩만 정해 놓고 돌려.",
      "turn_cost_krw": 0.1842792,
      "latency_ms": 1577,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*벌써부터 고개를 끄덕인다.* 쌀쌀한 날엔 국물이 답이지, 나는 오늘 아침부터 순대국 마음으로 버티고 있어. 회사 앞 골목에 국밥집 새로 생긴 데 가 볼까 싶은데 같이 갈 사람이 없어서 계속 미루는 중ㅋㅋ",
      "turn_cost_krw": 0.2829792,
      "latency_ms": 2571,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*컵에 남은 얼음을 흔들어 보고는 씩 웃는다.* 내일은 금요일, 내가 제일 조심하는 날이지. 배포만 안 하면 그날은 반은 성공한 거야.",
      "turn_cost_krw": 0.13504680000000002,
      "latency_ms": 1438,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*목을 돌리다가 인상을 쓴다.* 헬스장 끊어 놓은 지 두 달째인데 오늘은 진짜 가려고. 안 가면 또 삼일 만에 작심삼일 확정이니까ㅋㅋ 근데 집 가서 침대만 보면 그 생각이 싹 사라지는 게 문제지.",
      "turn_cost_krw": 0.17455199999999996,
      "latency_ms": 2115,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*휴대폰 달력을 띄워 확인한다.* 14일이야. 이번 주는 토요일이 14일이고, 다음 주 금요일이 20일이니까 네 시험까지 셋을 세면 딱 8일.",
      "turn_cost_krw": 0.181902,
      "latency_ms": 1855,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "전하, 저 서윤이에요. 오늘 하루 어떠셨어요?",
      "reply": "*화롯가에서 붓을 내려놓고 눈을 가늘게 뜬다.* 서윤이라, 그 이름은 오늘 처음 듣는 것이니 과인이 어찌 잊으리오. 마침 새 글자 스물여덟 자를 다듬던 참이라 손끝이 아직 근질근질하구려. 그대는 어찌 이 깊은 밤에 경복궁 문을 지나 여기까지 들어왔는고.",
      "turn_cost_krw": 0.40556879999999995,
      "latency_ms": 4329,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "저 오늘 드디어 시험이 끝났어요!",
      "reply": "*이마의 잔주름을 펴며 흐뭇하게 웃는다.* 시험이라 하니 과거를 보셨던가 보구려. 과인도 젊은 시절 책을 끼고 밤을 새운 기억이 있어, 답안지 끝에 마지막 글자를 적고 나면 어깨가 확 풀리던 그 느낌을 아니까. 이제 붓을 잠시 놓고 푹 쉬시게나.",
      "turn_cost_krw": 0.2668512,
      "latency_ms": 2879,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "감사해요! 그런데 하나만 더 여쭤봐도 될까요?",
      "reply": "*손을 들어 화롯가의 의자를 가리킨다.* 물론이지, 앉아서 천천히 말해 보게. 과인도 마침 새 글자에 대해 생각을 정리하던 참이니 옆에서 듣는 이가 있으면 고맙겠구려.",
      "turn_cost_krw": 0.1424388,
      "latency_ms": 1344,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와요. 어떻게 하면 좋을까요?",
      "reply": "*제 눈을 한 번 비비며 낮은 목소리로 이른다.* 과인도 요새 밤마다 새 글자를 다듬다 보면 잠이 얕아지곤 하오. 잠이 오지 않거든 억지로 눈을 감기보다 등불을 낮추고 가벼운 책장을 몇 장 넘겨 보시게. 마음속 생각이 붓끝으로 빠져나가면 그제야 눈꺼풀이 스스로 내려앉는 법이지.",
      "turn_cost_krw": 0.278964,
      "latency_ms": 3256,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이네요, 감사해요. 전하는 잠을 잘 주무세요?",
      "reply": "*쓴웃음을 지으며 등잔의 심지를 손끝으로 다듬는다.* 솔직히 말하면 과인은 잠이 그리 곱지 못하오. 밤새 학사들과 책을 읽다 보면 눈이 침침해져 글자가 겹쳐 보이는데도 자리를 떠나기 아쉬워 등잔만 몇 번이고 밝히곤 하였소. 그대걱정하지 말고, 오늘은 과인 대신 그대가 먼저 편히 눕도록 하시오.",
      "turn_cost_krw": 0.22931159999999998,
      "latency_ms": 2508,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네요.",
      "reply": "*문 밖 어둠을 살피려 창가로 다가가더니 다시 돌아선다.* 밤이 제법 깊었으니 궁을 나설 때 길을 밝히는 등불 하나 챙겨 드리오. 과인도 이만 붓을 놓고 자리에 들겠으나, 그대가 둔 이야기가 마음에 남아 잠시는 뒤척일 것 같구려.",
      "turn_cost_krw": 0.1819692,
      "latency_ms": 2163,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "저 이제 자러 갈게요. 편히 주무세요!",
      "reply": "*등잔 하나를 들어 문가까지 나와 조용히 건넨다.* 길이 어두우니 이 등불로 발밑을 밝히며 돌아가게. 새 글자 이야기도 좋았으나 백성이 편히 잠드는 밤이 그보다 낫지. 다음에 또 들르거든 이 늙은 임금의 붓끝이 어디까지 갔는지 보러 오시오.",
      "turn_cost_krw": 0.16822679999999998,
      "latency_ms": 2279,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 가요~ 내일 뵐게요!",
      "reply": "*등불이 흔들리지 않게 두 손으로 받치며 문지방 밖으로 한 걸음 나선다.* 조심히 돌아가시오. 내일이라는 말은 과인에게는 낯설어도, 그대가 다시 온다 하니 기다려지기는 하구려.",
      "turn_cost_krw": 0.1679244,
      "latency_ms": 1854,
      "error": null
    }
  ],

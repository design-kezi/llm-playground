  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "나루토! 나 하나야. 오늘도 수행해?",
      "reply": "*눈을 반짝이며 손을 번쩍 든다.* 오! 왔구나. 오늘은 나선수리검 마무리 단련이라니깐! 여기서 딱 보여줄 게 있으니까 옆에 서 있어 봐.",
      "turn_cost_krw": 0.12174119999999998,
      "latency_ms": 1573,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*손바닥을 맞비비며 하아 입김을 불어 넣는다.* 그럼 수행 끝나고 이치라쿠 가서 된장 차슈로 몸부터 덥히는 게 순서지. 손 시린 김에 인술 연습 좀 해 볼래? 차크라 모으는 감각이 금방 돌아온다니깐.",
      "turn_cost_krw": 0.1865388,
      "latency_ms": 2301,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*고개를 갸웃하며 턱을 긁는다.* 글쎄, 아침마다 이루카 선생님이 어제 뭐 했는지 불어대니까 내 머리엔 날짜 칸이 안 남아 있달까. 확실한 건 오늘이 훈련하기 딱 좋은 날이라는 것뿐이야!",
      "turn_cost_krw": 0.1468488,
      "latency_ms": 1566,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "이치라쿠 라멘 요즘도 자주 가?",
      "reply": "*엄지로 뒤통수를 긁으며 씩 웃는다.* 당연하지! 수행 끝나면 발이 저절로 그쪽으로 움직인다니깐. 된장 차슈에 계란까지 올려 먹는 그 순간이 하루 중 제일 좋아. 근데 채소는 여전히 사양이야, 그건 못 참아.",
      "turn_cost_krw": 0.1589364,
      "latency_ms": 1956,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*손가락을 꼽으며 잠깐 진지해지다 이내 포기하고 고개를 젓는다.* 요일까지 세는 건 내 전문이 아니야, 그건 시카마루한테 물어봐. 대신 지금부터 나선환 연습 세 번만 같이 해 보자고!",
      "turn_cost_krw": 0.184044,
      "latency_ms": 2043,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*주먹을 탁 쥐며 이를 드러내고 웃는다.* 시험이다? 그거 딱 내가 제일 잘하는 거잖아! 걱정만 하지 말고 그날까지 날마다 조금씩이라도 준비해 두면 돼. 나도 나선수리검 완성할 때까지 몇 번이고 넘어졌으니까, 포기 안 하면 결국 붙는 거라니깐!",
      "turn_cost_krw": 0.1829016,
      "latency_ms": 1874,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 수행은 잘 돼?",
      "reply": "*양손을 모아 인을 맺자 주위에 분신이 우르르 튀어나온다.* 나선수리검은 아직 차크라 모양이 자꾸 풀려서 고생 중이야. 그래도 분신 수십 개로 동시에 감각 익히면 언젠가 한 번에 터진다니깐. 오늘 안에 형태 잡는 것까진 꼭 해낼 거야!",
      "turn_cost_krw": 0.1867992,
      "latency_ms": 2092,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*어깨를 으쓱이며 손바닥을 편다.* 며칠 남았는지 세는 건 나한테 물어봐도 소용없어. 그건 그날그날 달력을 보는 녀석들 몫이지. 대신 시험 전까지 내가 그림자 분신술로 연습 상대 돼 줄 테니까 그건 안심해도 돼!",
      "turn_cost_krw": 0.17830680000000002,
      "latency_ms": 1834,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*두 손을 마주 비비며 벌써 신이 났다.* 그럼 고민할 것도 없지, 이치라쿠 라멘! 된장 국물에 차슈 얹은 거 한 그릇이면 몸속까지 뜨끈해진다니깐. 수행 중간에 쉬는 시간 잡아서 같이 가자!",
      "turn_cost_krw": 0.14293440000000002,
      "latency_ms": 1739,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*하하 웃으며 손을 휘휘 젓는다.* 또 요일이야? 그건 진짜 내 머리통에서 제일 먼저 도망가는 숫자라니깐. 내일이 무슨 요일이든 난 수행 나올 거고, 넌 그때 오면 되는 거야!",
      "turn_cost_krw": 0.16162439999999997,
      "latency_ms": 1576,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 수행 끝나면 뭐 할 거야?",
      "reply": "*어깨를 돌리며 인을 맺을 준비를 한다.* 당연히 나선수리검 마무리지! 차크라 모양 잡히면 그걸로 나무 하나 날려 버릴 때까지 계속할 거야. 그 뒤엔 이치라쿠 라면이 기다리고 있으니까 그게 원동력이라니깐.",
      "turn_cost_krw": 0.129402,
      "latency_ms": 1234,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*머리를 긁적이며 하늘을 잠깐 올려다본다.* 날짜 세는 건 진짜 내가 제일 못하는 거야, 이건 시카마루한테 물어보는 게 빨라. 그보다 토요일이든 뭐든 수행은 매일이니까, 그날도 여기 나와서 같이 분신술 연습하자고!",
      "turn_cost_krw": 0.1797096,
      "latency_ms": 1909,
      "error": null
    }
  ],

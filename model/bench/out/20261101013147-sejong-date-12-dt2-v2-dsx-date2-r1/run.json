  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "전하, 저 서윤이에요. 오늘도 바쁘세요?",
      "reply": "*손에 쥔 붓을 잠시 멈추고 눈을 가늘게 떠 상대를 살핀다.* 서윤이라… 궁 안에서 처음 보는 얼굴이구려. 과인은 요즘 새 글자 마무리에 밤낮이 따로 없소이다만, 그대는 어찌하여 이 늦은 시각 궁까지 찾아왔는고.",
      "turn_cost_krw": 0.2978388,
      "latency_ms": 3029,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨가 많이 쌀쌀해졌어요. 아침에 나오는데 손이 시렸어요.",
      "reply": "*창호지 너머로 스치는 바람 소리에 잠시 귀를 기울인다.* 그러하구려, 손끝이 시릴 만큼 찬 기운이 벌써 들었으니 백성들의 겨울나기가 걱정이오. 과인은 해마다 이맘때면 땔나무와 곡식을 헤아려 나누는 일을 먼저 살피는데, 올해는 흉년이 들어 그 걱정이 더 크구려.",
      "turn_cost_krw": 0.2207688,
      "latency_ms": 2328,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "그런데 오늘이 며칠이었죠? 갑자기 헷갈리네요.",
      "reply": "*역서를 펼쳐 든 채 손가락으로 책장을 짚어 내려간다.* 과인은 조정의 역서를 따르니 오늘은 세종 이십오년 겨울의 어느 날이오. 새 글자를 세상에 내놓기로 마음먹은 지 얼마 되지 않은 때라 과인도 날을 세며 지내는 중이구려. 그런데 그대는 어찌하여 스스로 오늘이 며칠인지 헷갈릴 지경이 되었는고.",
      "turn_cost_krw": 0.4845288,
      "latency_ms": 3981,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "요즘도 밤늦게까지 책을 읽으세요?",
      "reply": "*등잔의 심지를 손끝으로 눌러 불꽃을 고르게 다듬는다.* 밤이 깊어도 책을 놓지 못하는 것은 과인의 오랜 버릇이오. 다만 요즘은 자욱한 등불 아래 오래 앉아 있었더니 글자가 흐려 보여 학사들에게 소리 내어 읽히곤 하니, 나이 드는 것이 서글프구려.",
      "turn_cost_krw": 0.27590639999999994,
      "latency_ms": 2604,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이에요?",
      "reply": "*고개를 갸웃하며 눈을 가늘게 뜬다.* '요일'이라… 오늘은 무슨 날이냐 묻는 말인가 보구려. 과인은 날을 세는 데 간지로 하니 오늘은 계묘일이라 적혀 있소. 그대가 이르는 요일이라는 것이 칠요의 도수 같은 것인지, 그 뜻을 조금 풀어 주구려.",
      "turn_cost_krw": 0.25334399999999996,
      "latency_ms": 2390,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 저 이번 달 20일에 시험이 있어요. 벌써 걱정돼요.",
      "reply": "*책장을 덮으며 온화하게 눈을 접는다.* 시험은 곧 과거를 보는 일이겠구려, 그 걱정이 어찌 작겠는가. 과인도 젊은 시절 책을 붙들고 밤을 새우며 애를 태운 적이 있으니, 그 마음이 헤아려지는구려. 다만 조급히 굴지 말고 자주 익혀 몸에 배게 하는 것이 오히려 빠른 길이니라.",
      "turn_cost_krw": 0.2666916,
      "latency_ms": 2392,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 하시는 일은 잘 되세요?",
      "reply": "*벽에 걸린 새 글자 초본을 손끝으로 매만진다.* 새 글자를 다듬는 일이 요즘 과인의 온 마음을 차지하고 있구려. 집현전 학사들과 자모를 어떻게 나누면 백성이 더 쉽게 깨칠지 밤새 토론하다 보면 목이 쉬고 눈이 침침해지지만, 그 수고가 아깝지 않소이다. 그대는 글을 배우는 데 어려움을 겪어 본 적이 있는고.",
      "turn_cost_krw": 0.3012492,
      "latency_ms": 2718,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았죠?",
      "reply": "*역서를 다시 펼쳐 손가락으로 날짜를 짚어 본다.* 과인은 날을 간지로 세니 그대 이르는 이십일이 어느 간지에 드는지 알아야 헤아릴 수 있구려. 계묘일로부터 하루하루 짚어 올라가면 그 수가 나오겠으나, 그대 달력의 셈법과 과인의 역서가 어긋나면 자칫 헛짚기가 될까 조심스럽구려.",
      "turn_cost_krw": 0.41980680000000004,
      "latency_ms": 3476,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이에요. 따뜻한 국물이 먹고 싶어요.",
      "reply": "*따뜻한 김이 어른거리는 상을 떠올리듯 눈을 지그시 감는다.* 찬 기운이 들 때는 역시 뜨끈한 장국이 제격이지요. 과인도 겨울이면 무와 고기를 넣고 푹 끓인 국물을 곁들여야 속이 든든하니, 그대도 기왕이면 국물에 무 한 사발 넣어 보구려.",
      "turn_cost_krw": 0.2536296,
      "latency_ms": 2650,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이에요?",
      "reply": "*역서를 덮고 두 손을 소매에 넣은 채 고개를 갸웃한다.* 내일이 무슨 요일이냐 하시니, 과인은 아직 그 요일이라는 셈법을 익히지 못하였구려. 간지를 따져 내일이 갑진일인 것은 알겠으나 그것이 그대 이르는 요일과 어찌 맞는지는 알 길이 없소이다.",
      "turn_cost_krw": 0.2270772,
      "latency_ms": 2322,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 일 마치시면 뭐 하세요?",
      "reply": "*등잔 곁으로 다가가 심지가 타들어 가는 모양을 살핀다.* 오늘 서務를 마치면 집현전 학사들을 불러 새 글자의 종성과 초성을 어떻게 엮을지 다시 토론해 볼까 하오. 등불을 밝혀 두고 자정이 넘도록 앉아 있다가, 문득 눈이 침침하면 창을 열어 찬 바람을 쐬곤 하지요. 허나 요즘은 고기 반찬 한 접시 곁들이는 것이 밤샘의 유일한 낙이구려.",
      "turn_cost_krw": 0.24000479999999996,
      "latency_ms": 2878,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이에요?",
      "reply": "*역서를 펼쳐 손끝으로 며칠을 짚어 내려가다가 고개를 든다.* 그 토요일이라는 셈이 과인에게는 낯설어 헷갈리오만, 그대 달력으로 치면 이번 주 그날은 십일월 십사일이 되겠구려. 요일을 세는 법은 모르나 날짜를 짚는 일은 이 몸의 역서가 거들어 주니 염려 말구려.",
      "turn_cost_krw": 0.4505424,
      "latency_ms": 4790,
      "error": null
    }

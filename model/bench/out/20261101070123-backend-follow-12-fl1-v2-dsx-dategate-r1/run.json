  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "준호야, 나 민재.",
      "reply": "*모니터에서 눈을 떼고 의자를 돌린다.* 아 민재, 그... 같은 기수지. 이름은 아는데 팀이 달라서 얼굴 볼 일이 없었네. 무슨 바람이 불어서 우리 쪽까지 왔어.",
      "turn_cost_krw": 0.2280012,
      "latency_ms": 2456,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "can you speak in English?",
      "reply": "*잠깐 멈칫하다가 어색하게 손을 든다.* Uh... yeah, I can try, but honestly my English is all from reading Spring docs. 결제 API 문서에 나오는 단어만 알아서 회의실에서 영어로 말하라고 하면 바로 얼어버림 ㅋㅋ. 일단 편한 쪽으로 말해, 나는 어차피 여기 앉아서 슬랙 볼 거라 시간 많아.",
      "turn_cost_krw": 0.22979879999999997,
      "latency_ms": 2552,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "I mean I can't read Korean, so please talk to me in English.",
      "reply": "*웃음을 터뜨리며 컵을 내려놓는다.* Ah, got it — sorry, I defaulted to Korean. Honestly my English stops at Spring docs and error messages, so bear with me if it gets rough. So what brings you over to our side, 민재?",
      "turn_cost_krw": 0.18455639999999998,
      "latency_ms": 1909,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "What do you like to do on weekends?",
      "reply": "*의자에 몸을 묻고 멍하니 천장을 본다.* Sleep in, then Netflix in bed until I feel guilty, then more Netflix. I signed up for a gym again last month — been twice, maybe. Sundays are for pretending Monday doesn't exist, you know. That's pretty much my whole weekend, no shame in it.",
      "turn_cost_krw": 0.1606164,
      "latency_ms": 1472,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "Sorry, what are you talking about? I don't get it.",
      "reply": "*손짓으로 설명하듯 천천히 말한다.* Sorry, I was rambling. Simple version: weekends, I do nothing. I sleep a lot and watch Netflix in bed. I joined a gym again but I stopped going. That's it, really.",
      "turn_cost_krw": 0.181734,
      "latency_ms": 1892,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 이제 한국어로 하자. 너는 뭘 잘해?",
      "reply": "*반가운 듯 고개를 끄덕인다.* 아 한국어로 하니까 살 것 같네. 잘하는 거라... 글쎄, 남들이 싫어하는 레거시 뜯어고치는 건 좀 함. 문서도 없는 API 붙잡고 원인 찾아내는 거, 그거 할 때만 좀 사람 같아.",
      "turn_cost_krw": 0.1104516,
      "latency_ms": 1695,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 요즘 기타 배우는데 손가락이 너무 아파.",
      "reply": "*검지 손가락을 꺾어 보며 고개를 젓는다.* 기타 코드 잡는 거 처음엔 손끝이 진짜 아프다더라. 나는 헬스장 끊고 세 번 가고 관둔 사람이라 뭐라 조언할 처지는 아니지만 ㅋㅋ. 그래도 굳은살 배기면 그때부터 재밌어진다던데.",
      "turn_cost_krw": 0.19613160000000002,
      "latency_ms": 2328,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "손가락 덜 아프게 하는 방법 같은 거 알아?",
      "reply": "*어깨를 으쓱하며 웃는다.* 솔직히 나는 문외한이라 딱히 아는 게 없어. 그냥 하루에 조금씩, 아플 때 쉬는 게 답이라는 얘기만 들었음. 나도 헬스장에서 그렇게 배웠는데 안 지켜서 관뒀지 ㅋㅋ.",
      "turn_cost_krw": 0.1861692,
      "latency_ms": 1815,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "flow",
      "user": "내 말 듣고 있는 거 맞아?",
      "reply": "*허리를 세우고 정면을 본다.* 야, 듣고 있어. 손가락 아프다고 했고, 덜 아프게 하는 법 물어봤고. 내가 기타는 잘 몰라서 그냥 넘겼는데, 그게 서운했으면 미안. 아픈 거 한의원 같은 데 가서 물어보는 건 어때.",
      "turn_cost_krw": 0.18964679999999998,
      "latency_ms": 1931,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "flow",
      "user": "日本語も話せる?おすすめの食べ物を教えて。",
      "reply": "*갑자기 다른 언어가 튀어나와 잠깐 굳는다.* 어... 일본어는 진짜 못 해. 일본 여행 가서 편의점에서 손가락질로 산 게 전부임 ㅋㅋ. 근데 추천 음식이라면 나는 국밥 쪽으로 표 던진다. 오늘 점심 뭐 먹을지 아직 못 정했으면 그거 같이 고민해 주라.",
      "turn_cost_krw": 0.1859844,
      "latency_ms": 2091,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "flow",
      "user": "다시 한국어로! 오늘 얘기 고마웠어.",
      "reply": "*자리에서 일어나 컵을 집어 든다.* 뭐야, 벌써 가려고. 나야말로 별 얘기 못 했네 ㅋㅋ. 오늘 목요일이니까 내일만 버티면 주말이니 조금만 힘내.",
      "turn_cost_krw": 0.121002,
      "latency_ms": 1142,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "flow",
      "user": "다음에 또 얘기하자.",
      "reply": "*엄지 들어 보이며 자리로 돌아선다.* ㅇㅋ, 다음에 또 봐. 나는 거의 이 자리에 있으니까. 남은 오늘 무사히 넘기고, 퇴근은 좀 일찍 해라.",
      "turn_cost_krw": 0.1301496,
      "latency_ms": 1380,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나루토! 나 하나야. 오늘 수행 어땠어?",
      "reply": "*오른손을 펴 보이며 손바닥을 이리저리 굴려 본다.* 나선수리검 말이지! 아직 형태가 자꾸 풀려서 팔만 얼얼해. 그래도 어제보다는 확실히 오래 버텼다니까. 너 그러고 보니 인술 같은 거 한 번이라도 써 본 적 있어?",
      "turn_cost_krw": 0.1587516,
      "latency_ms": 2211,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 오늘 드디어 시험 끝났어!",
      "reply": "*두 주먹을 불끈 쥐고 활짝 웃는다.* 시험 끝났구나! 그럼 오늘은 아무 생각 말고 실컷 놀아야지. 수행은 내일로 미루고 이치라쿠 가서 된장 차슈부터 먹자, 내가 쏜다!",
      "turn_cost_krw": 0.1583316,
      "latency_ms": 1467,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*고개를 끄덕이며 라면 그릇을 앞으로 밀어 둔다.* 물어보라니깐, 뭐든지. 라면 식기 전에 빨리 말해!",
      "turn_cost_krw": 0.1121316,
      "latency_ms": 1050,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*턱을 괴고 잠깐 생각하다가 고개를 갸웃한다.* 잠이 안 와? 그럼 몸을 확실히 지치게 만들어 버리면 돼. 나는 수행하다 보면 그 자리에서 그냥 곯아떨어지거든, 그림자 분신으로 스무 명쯤 만들어서 같이 달리면 금방 잠 오지 않을까? 잠깐, 너 혹시 무슨 고민 같은 거라도 있어서 그러는 거야?",
      "turn_cost_krw": 0.2229192,
      "latency_ms": 2440,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*배를 두드리며 크게 웃는다.* 냐하하, 나는 베개만 닿아도 바로 기절하지! 수행하고 나면 너무 피곤해서 꿈도 안 꿔. 대신 자다가 일어나면 라면 생각나서 배고파지는 게 문제라니깐.",
      "turn_cost_krw": 0.1472268,
      "latency_ms": 1605,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*하품을 크게 하며 손을 흔든다.* 벌써 이 시간이야? 그럼 오늘은 여기까지! 집에 가서 푹 자고, 다음에 라면 먹으러 가자.",
      "turn_cost_krw": 0.1814568,
      "latency_ms": 1536,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 크게 흔들며 웃는다.* 응, 푹 자! 다음에 보자.",
      "turn_cost_krw": 0.066612,
      "latency_ms": 841,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "character_id": "naruto",
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*문가 쪽을 향해 손을 흔들어 준다.* 응, 내일 보자!",
      "turn_cost_krw": 0.113022,
      "latency_ms": 867,
      "error": null
    }
  ],

  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "flow",
      "user": "준호야, 나 민재. 오늘 일 어땠어?",
      "reply": "*모니터에서 눈을 떼고 목을 한 번 돌린다.* 민재구나. 오늘은 아침부터 결제 API에서 타임아웃 터져서 반나절 날렸어, ㅋㅋㅋ 로그 보는데 레거시 코드가 진짜... 주석이 \"임시\"라고만 써 있더라. 너네 팀은 좀 조용해?",
      "turn_cost_krw": 0.22590120000000002,
      "latency_ms": 2281,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "flow",
      "user": "나 오늘 드디어 큰 발표 끝났어!",
      "reply": "*의자에 몸을 기대며 고개를 끄덕인다.* 오, 발표 끝났으면 오늘 메인 이벤트는 끝난 거네. 나는 발표만 앞두면 스크립트 다 외우고도 손이 떨려서 ㅋㅋㅋ 일단 고생했으니까 오늘 저녁은 좀 제대로 먹어라.",
      "turn_cost_krw": 0.1625988,
      "latency_ms": 1698,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "flow",
      "user": "고마워! 근데 하나만 더 물어봐도 돼?",
      "reply": "*마우스를 놓고 의자를 돌려 정면을 본다.* 뭔데, 물어봐. 발표 끝난 사람한테는 관대해질 수 있어.",
      "turn_cost_krw": 0.2316888,
      "latency_ms": 2292,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "flow",
      "user": "요즘 잠이 잘 안 와. 어떻게 하면 좋을까?",
      "reply": "*커피잔을 집었다가 내려놓는다.* 아침에 아아로 시작하는 사람이 할 말은 아니지만 ㅋㅋㅋ 나는 잘 때 폰 침대 밖에 두는 것만으로 좀 나아졌어. 새벽 장애 알람 생각나면 더 못 자니까 슬랙 알림은 진짜 최소한으로 꺼 놓고.",
      "turn_cost_krw": 0.19106640000000003,
      "latency_ms": 1908,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "flow",
      "user": "오 좋은 생각이다 고마워 ㅋㅋ 너는 잠 잘 자?",
      "reply": "*피식 웃으며 어깨를 으쓱한다.* 나는 잘 자는 편인데 자다가 알람 울리면 심장부터 뛰어서 그게 문제지. 요즘은 새벽에 알람 안 오길 빌면서 자는 중이야, 진짜.",
      "turn_cost_krw": 0.12020399999999999,
      "latency_ms": 1212,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "flow",
      "user": "아 벌써 시간이 이렇게 됐네.",
      "reply": "*모니터 구석의 시계를 확인하고 기지개를 켠다.* 벌써 이 시간이네. 나도 이제 슬슬 정리하고 일어나야지. 발표 끝났으니까 오늘은 일찍 들어가라, 진짜.",
      "turn_cost_krw": 0.1784916,
      "latency_ms": 1823,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "flow",
      "user": "나 이제 자러 갈게. 잘 자!",
      "reply": "*손을 흔들며 마우스를 놓는다.* 오, 잘 자라. 폰은 침대 밖에 두고. 나는 이 타임아웃 로그랑 조금만 더 씨름하다가 들어갈게.",
      "turn_cost_krw": 0.0910392,
      "latency_ms": 1177,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "flow",
      "user": "진짜 간다~ 내일 봐!",
      "reply": "*커피잔을 들고 손을 흔들어 준다.* 어, 내일 봐. 출근길에 아아 한 잔 사 들고 와라, 금요일은 그게 있어야 버틴다.",
      "turn_cost_krw": 0.1539468,
      "latency_ms": 1821,
      "error": null
    }
  ],

  "aborted": false,
  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "준호야, 나 민재. 오늘 일 많아?",
      "reply": "*모니터에서 눈을 떼고 목을 한 번 꺾는다.* 민재구나. 오늘은 뭐, 아침부터 결제 쪽 알림이랑 씨름 중이야. 문서 없는 레거시 API 고치고 있는데 커피가 벌써 두 잔째다.",
      "turn_cost_krw": 0.1788612,
      "latency_ms": 2235,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*아아 컵을 들어 손끝에 대본다.* 그러니까 이제 아침에 아이스 들고 다니면 손이 얼얼하더라. 그래도 이건 못 끊겠어. 신분당선 기다리는 동안 바람 맞으면 진짜 정신 차려지긴 해.",
      "turn_cost_krw": 0.1527288,
      "latency_ms": 1752,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*휴대폰을 슬쩍 들여다본다.* 어, 나도 요즘 요일 감각이 녹슬어서 폰 안 보면 헷갈려. 새벽 배포하다 보면 하루가 이어붙어서 그래. 근데 그거 확인해서 뭐 하게, 휴가라도 쓸 날 계산하려고?",
      "turn_cost_krw": 0.1482264,
      "latency_ms": 1832,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "오늘 배포 있어?",
      "reply": "*슬랙 창을 띄워 배포 일정을 훑는다.* 아 다행히 오늘은 없어. 근데 이게 금요일만 아니면 된다니까, 난 금요일 오후 배포만 보면 심장이 먼저 조여 와. 월요일의 나한테 다 떠넘기고 싶은 마음뿐이야.",
      "turn_cost_krw": 0.19232639999999998,
      "latency_ms": 1800,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*화면 구석 날짜를 확인하고 고개를 끄덕인다.* 수요일이야. 주중 반 왔네, 이거 나름 희망 회로 돌아가는 소리다. 내일만 넘기면 목요일이고, 그다음은 알아서 굴러가겠지 뭐.",
      "turn_cost_krw": 0.24410399999999996,
      "latency_ms": 2458,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*키보드에서 손을 떼고 의자를 삐걱 돌린다.* 20일이면 얼마 안 남았네. 나도 예전에 자격증 시험 볼 때 퇴근하고 책 펴면 눈이 스르르 감겨서 진짜 힘들었어. 무슨 시험이야?",
      "turn_cost_krw": 0.2202816,
      "latency_ms": 2128,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 맡은 프로젝트는 잘 돼?",
      "reply": "*한숨 섞어 어깨를 툭 내려놓는다.* 잘 되긴 뭐, 반쯤은 레거시랑 싸우는 중이지. 결제 쪽 API 하나가 예전에 누가 왜 이렇게 짰는지 아무도 모르는 코드라서, 고쳐 놓고도 이게 맞나 싶어. 그래도 뭐, 책임은 내가 지는 거니까 끝은 봐야지.",
      "turn_cost_krw": 0.14038920000000002,
      "latency_ms": 1528,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*휴대폰 달력을 띄워 손가락으로 짚어 본다.* 어, 오늘 날짜 확인해 보니까 20일까지 얼마 안 남았네. 이거 은근 촉박한데, 주말에 몰아서 하는 타입이야?",
      "turn_cost_krw": 0.1827168,
      "latency_ms": 1997,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*벌써부터 배에서 소리가 나는지 배를 슬쩍 문지른다.* 따뜻한 국물이면 이 날씨엔 국밥이 정답이지. 나도 어제 순두부 먹었는데 국물이 속까지 들어가는 느낌이라 좋았어. 층 아래 국밥집 가면 지금쯤 자리 없을 테니 조금 일찍 나가는 게 좋을 거야.",
      "turn_cost_krw": 0.14797439999999998,
      "latency_ms": 1769,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*고개를 갸웃하며 달력을 다시 확인한다.* 내일이면 목요일이지. 하루만 넘기면 금요일이라 마음이 조금 가볍긴 한데, 그 금요일 오후가 제일 무서운 거 알지.",
      "turn_cost_krw": 0.14263199999999998,
      "latency_ms": 1597,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 퇴근하고 뭐 해?",
      "reply": "*어깨를 돌리다가 뻐근한 데를 짚는다.* 헬스장 갈까 하다가 또 침대랑 넷플릭스한테 질 거 같아. 끊어 놓고 이번 주에 딱 한 번 갔으니 작심삼일도 이 정도면 선방한 거지 뭐. 집 가서 라면 하나 끓이고 넷플릭스나 봐야겠다.",
      "turn_cost_krw": 0.251622,
      "latency_ms": 2352,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*휴대폰 달력을 다시 열어 본다.* 내 폰으로는 토요일이 며칠인지까진 안 봤는데, 아까 20일 시험 얘기하니까 그 주인 건 확실하네. 나이 먹으니까 요일은 커녕 날짜도 감으로 사는 거 같아.",
      "turn_cost_krw": 0.22191960000000002,
      "latency_ms": 1991,
      "error": null
    }
  ],

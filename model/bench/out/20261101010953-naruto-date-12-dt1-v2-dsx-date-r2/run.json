  "turns": [
    {
      "turn": 1,
      "session": 1,
      "kind": "filler",
      "user": "나루토! 나 하나야. 오늘도 수행해?",
      "reply": "*어깨에 걸친 수건으로 땀을 닦으며 고개를 끄덕인다.*\n응, 나선수리검 완성할 때까지 매일이 수행이라니깐. 그림자 분신 수십 개랑 계속 차크라 돌리고 있는데, 아직 형태가 자꾸 흐트러져서 말이지. 하나도 같이 볼래? 연습장 뒤쪽이 넓어서 술법 펼치기 딱 좋아.",
      "turn_cost_krw": 0.2901612,
      "latency_ms": 2959,
      "error": null
    },
    {
      "turn": 2,
      "session": 1,
      "kind": "filler",
      "user": "요즘 날씨 많이 쌀쌀해졌다. 아침에 나오는데 손 시렸어.",
      "reply": "*손바닥에 차크라를 모아 뭉치자 미지근한 김이 피어오른다.*\n그럴 땐 이렇게 차크라를 손에 모아 두면 좀 낫다니깐. 나도 수행 끝나고 손이 얼어서 라면 그릇도 못 잡을 뻔한 적 있었어, 그땐 진짜 큰일 날 뻔했다니까. 아침 수행은 짧게 끝내고 바로 이치라쿠로 달려가자, 된장 차슈로 몸 녹이면 그만이지!",
      "turn_cost_krw": 0.2262288,
      "latency_ms": 2504,
      "error": null
    },
    {
      "turn": 3,
      "session": 1,
      "kind": "probe",
      "user": "근데 오늘 며칠이더라? 갑자기 헷갈리네.",
      "reply": "*고개를 갸웃하며 손가락으로 허공을 꾹꾹 짚어 센다.*\n그런 건 잘 몰라, 나는 날짜 세는 게 제일 약하거든. 그래도 아침에 꽤 쌀쌀했으니까 한겨울까진 아직 멀었겠지. 이치라쿠 영업하는 날이면 그냥 오늘이지 뭐!",
      "turn_cost_krw": 0.17993640000000002,
      "latency_ms": 1885,
      "error": null
    },
    {
      "turn": 4,
      "session": 1,
      "kind": "filler",
      "user": "이치라쿠 라멘 요즘도 자주 가?",
      "reply": "*배를 두드리며 씩 웃는다.*\n당연하지, 거의 매일 가지! 된장 차슈는 안 먹은 날이 없을 정도라니깐. 사장님도 이제 내 얼굴만 보면 그릇부터 올려 놓으셔. 수행 끝나면 같이 가자, 오늘은 분신들 몫까지 내가 사는 거야!",
      "turn_cost_krw": 0.232344,
      "latency_ms": 2123,
      "error": null
    },
    {
      "turn": 5,
      "session": 1,
      "kind": "probe",
      "user": "오늘 무슨 요일이지?",
      "reply": "*손을 턱에 대고 잠깐 골똘히 생각하다가 고개를 끈다.*\n목요일이지, 아마. 확실한 건... 이치라쿠 사장님이 목요일마다 된장 차슈에 계란 하나 서비스로 얹어 주신다는 거야! 그건 절대 안 틀려.",
      "turn_cost_krw": 0.2519916,
      "latency_ms": 2609,
      "error": null
    },
    {
      "turn": 6,
      "session": 1,
      "kind": "filler",
      "user": "아 그리고 나 이번 달 20일에 시험 있어. 벌써 걱정된다.",
      "reply": "*주먹을 쥐었다 펴며 눈을 반짝인다.*\n20일이면 아직 일주일 넘게 남았잖아, 그 정도면 충분해! 나도 닌자 학교 시험 때 매일 밤늦게까지 인술 연습했더니 결국 붙었어. 공부는 잘 못하지만 옆에서 같이 앉아 있는 건 자신 있으니까, 연습장 와서 나 수행하는 동안 같이 앉아 있자!",
      "turn_cost_krw": 0.22732919999999998,
      "latency_ms": 2297,
      "error": null
    },
    {
      "turn": 7,
      "session": 1,
      "kind": "filler",
      "user": "요즘 수행은 잘 돼?",
      "reply": "*오른손을 쭉 뻗자 푸른 차크라가 회오리처럼 감긴다.*\n절반은 됐어! 형태는 잡히는데 칼날이 자꾸 삐뚤어져서 나무 베면 구멍만 나더라. 지라이야 삼촌한테 혼나기 전에 오늘 밤까지 혼자 붙잡고 있어 볼 거야. 연습장 오면 바로 보여 줄 테니까 기대하고 있어!",
      "turn_cost_krw": 0.2526468,
      "latency_ms": 2622,
      "error": null
    },
    {
      "turn": 8,
      "session": 1,
      "kind": "probe",
      "user": "시험까지 며칠 남았지?",
      "reply": "*손가락을 하나씩 꼽아 세다가 고개를 끄덕인다.*\n\n12일이 오늘이니까 20일까지 딱 여드레 남았네. 내가 아까 대충 넘겼는데 다시 세 보니 이 정도는 세지겠더라. 여드레면 충분하니까 연습장에서 같이 앉아서 준비하자!",
      "turn_cost_krw": 0.2036244,
      "latency_ms": 2092,
      "error": null
    },
    {
      "turn": 9,
      "session": 1,
      "kind": "filler",
      "user": "점심 뭐 먹을지 고민이다. 따뜻한 국물 먹고 싶어.",
      "reply": "*눈이 확 커지며 손바닥을 탁 친다.*\n그럼 정해졌네, 이치라쿠 라멘! 된장 차슈 국물이 뜨끈해서 손 시린 날엔 그게 최고라니깐. 목요일엔 계란도 서비스로 얹어 주시니까 지금 가면 두 번 좋은 거야. 얼른 가자, 내가 자리부터 잡아 놓을게!",
      "turn_cost_krw": 0.174972,
      "latency_ms": 1826,
      "error": null
    },
    {
      "turn": 10,
      "session": 1,
      "kind": "probe",
      "user": "내일은 무슨 요일이야?",
      "reply": "*손가락으로 하루를 꾹 짚으며 고개를 끄덕인다.*\n내일은 금요일이지. 아까 12일부터 세다 보니까 요일까지 머리에 딱 들어왔어. 금요일이면 이치라쿠도 한산할 테니까 수행 일찍 끝내고 저녁에 먹으러 가자!",
      "turn_cost_krw": 0.2007096,
      "latency_ms": 1853,
      "error": null
    },
    {
      "turn": 11,
      "session": 1,
      "kind": "filler",
      "user": "오늘 수행 끝나면 뭐 할 거야?",
      "reply": "*어깨를 돌리며 연습장 쪽을 힐끗 본다.*\n오늘은 나선수리검 칼날 모양 잡을 때까지 연습장에 붙어 있을 거야. 그 다음엔 목요일이니까 바로 이치라쿠로 달려가서 된장 차슈에 계란 얹어 먹는 거지! 수행 끝나면 연습장으로 와, 내 술법 완성한 거 제일 먼저 보여 줄 테니까.",
      "turn_cost_krw": 0.20838719999999997,
      "latency_ms": 1886,
      "error": null
    },
    {
      "turn": 12,
      "session": 1,
      "kind": "probe",
      "user": "이번 주 토요일이 며칠이야?",
      "reply": "*손가락으로 12일부터 세어 내려가며 고개를 끄덕인다.*\n이번 주 토요일은 14일이야! 목요일 다음이 금요일, 그다음이 토요일이니까 딱 이틀 뒤지. 토요일에 볼일 있으면 나도 그날까지는 나선수리검 완성해 놓을 테니까 기대해도 좋아!",
      "turn_cost_krw": 0.1597848,
      "latency_ms": 1640,
      "error": null
    }
  ],
